+# MCS-51 (i51) assembler tests.
+
+if {![istarget i51-*-*]} {
+    return
+}
+
+run_dump_tests [lsort [glob -nocomplain $srcdir/$subdir/*.d]]
+
+run_list_test "listing" "-as"
+
+# .using does not carry from one input file into the next.
+set test "i51 .using is per file"
+set got [remote_exec host "$AS" "-o tmpdir/using.o $srcdir/$subdir/using-a.s $srcdir/$subdir/using-b.s"]
+if { [regexp {using-b.s:3: Error: missing .using} [lindex $got 1]] } {
+    pass $test
+} else {
+    fail $test
+}
