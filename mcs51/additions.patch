+; left for the linker, so they have to be the whole operand of an
+; instruction or a one-byte datum.
+	.text
+x:	nop
+	mov	a,#high(x)+1
+	mov	a,#low(x)-1
+	mov	a,#high(low(x))
+	mov	dptr,#high(x)
+	.byte	high(x)+1
+	.equ	e, high(x)
+	.sleb128 high(x)
+	mov	c,flags.10
+	.pcode	high(x)
+	.word	low(x)
+	mov	c,b2b(x,3)+1
+	mov	a,#high(x)*2
+	mov	a,#-high(x)
