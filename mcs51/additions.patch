+   along with this program; if not, write to the Free Software
+   Foundation, Inc., 51 Franklin Street - Fifth Floor, Boston,
+   MA 02110-1301, USA.  */
+
+
+#include "sysdep.h"
+#include "dis-asm.h"
+#include "disassemble.h"
+#include "opintl.h"
+#include "libiberty.h"
+
+struct i51_opcode
+{
+  const char *name;
+  const char *args;
+  unsigned char size;
+  unsigned char bin;
+  unsigned char mask;
+};
+
+#define I51_INS(NAME, ARGS, SIZE, BIN, MASK) { NAME, ARGS, SIZE, BIN, MASK },
+
+static const struct i51_opcode i51_opcodes[] =
+{
+#include "opcode/i51.h"
+};
+
+/* Which symbols may name an address in disassembly.  The MCS-51 has
+   several address spaces that all start at zero, so while a section
+   carrying code is disassembled only a symbol of a section carrying code
+   names an address in it - not an SFR equate such as ACC, nor a data
+   symbol of another space.  Elsewhere every symbol is let through.  */
+
+bool
+i51_symbol_is_valid (asymbol *sym, struct disassemble_info *info)
+{
+  if (sym == NULL || sym->section == NULL)
+    return false;
+
+  if (info == NULL
+      || info->section == NULL
+      || (info->section->flags & SEC_CODE) == 0)
+    return true;
+
+  if (bfd_is_abs_section (sym->section))
+    return false;
+
+  return (sym->section->flags & SEC_CODE) != 0;
+}
+
+/* The row of the instruction whose first byte is INSN, or NULL.  */
+
+static const struct i51_opcode *
+i51_find_opcode (unsigned int insn)
+{
+  size_t i;
+
+  for (i = 0; i < ARRAY_SIZE (i51_opcodes); i++)
+    if ((insn & i51_opcodes[i].mask) == i51_opcodes[i].bin)
+      return &i51_opcodes[i];
+  return NULL;
+}
+
+/* The name of an operand of kind KIND that is always the same register
+   or addressing mode, or NULL.  */
+
+static const char *
+i51_fixed_operand (char kind)
+{
+  switch (kind)
+    {
+    case 'A': return "A";
+    case 'C': return "AB";
+    case 'r': return "C";
+    case 'P': return "DPTR";
+    case 'T': return "@DPTR";
+    case '@': return "@A+DPTR";
+    case 'X': return "@A+PC";
+    default: return NULL;
+    }
+}
+
+/* The number of bytes after the opcode byte that operand KIND of OPC
+   takes.  */
+
+static int
+i51_field_size (const struct i51_opcode *opc, char kind)
+{
+  switch (kind)
+    {
+    case 'D':
+    case 'B':
+    case '/':
+    case 'J':
+    case '1':
+      return 1;
+    case '6':
+      return 2;
+    case '#':
+      return opc->args[0] == 'P' ? 2 : 1;
+    default:
+      return 0;
+    }
+}
+
+/* Print operand KIND of the instruction INSN, the row OPC, whose field
+   is at FIELD.  PC is the address of the following instruction.  */
+
+static void
+i51_print_operand (const struct i51_opcode *opc, char kind,
+		   const bfd_byte *insn, const bfd_byte *field, bfd_vma pc,
+		   disassemble_info *info)
+{
+  fprintf_styled_ftype prin = info->fprintf_styled_func;
+  void *stream = info->stream;
+  const char *fixed = i51_fixed_operand (kind);
+
+  if (fixed != NULL)
+    {
+      prin (stream, dis_style_register, "%s", fixed);
+      return;
+    }
+
+  switch (kind)
+    {
+    case 'R':
+      prin (stream, dis_style_register, "R%d", insn[0] & 7);
+      break;
+    case 'I':
+      prin (stream, dis_style_register, "@R%d", insn[0] & 1);
+      break;
+    case '/':
+      prin (stream, dis_style_text, "/");
+      /* Fall through.  */
+    case 'D':
+    case 'B':
+      prin (stream, dis_style_address, "0x%02x", field[0]);
+      break;
+    case '#':
+      if (i51_field_size (opc, kind) == 2)
+	prin (stream, dis_style_immediate, "#0x%04x",
+	      (unsigned int) bfd_getb16 (field));
+      else
+	prin (stream, dis_style_immediate, "#0x%02x", field[0]);
+      break;
+    case 'J':
+      info->target = (pc + (signed char) field[0]) & 0xffff;
+      info->print_address_func (info->target, info);
+      break;
+    case '1':
+      info->target = (pc & 0xf800) | ((insn[0] & 0xe0) << 3) | field[0];
+      info->print_address_func (info->target, info);
+      break;
+    case '6':
+      info->target = bfd_getb16 (field);
+      info->print_address_func (info->target, info);
+      break;
+    }
+}
+
+/* The kind of control transfer OPC is.  */
+
+static enum dis_insn_type
+i51_insn_type (const struct i51_opcode *opc)
+{
+  if (strcmp (opc->name, "acall") == 0 || strcmp (opc->name, "lcall") == 0)
+    return dis_jsr;
+  if (strcmp (opc->name, "sjmp") == 0 || strcmp (opc->name, "ajmp") == 0
+      || strcmp (opc->name, "ljmp") == 0 || strcmp (opc->name, "jmp") == 0)
+    return dis_branch;
+  if (strchr (opc->args, 'J') != NULL)
+    return dis_condbranch;
+  return dis_nonbranch;
+}
+
+int
+print_insn_i51 (bfd_vma addr, disassemble_info *info)
+{
+  const struct i51_opcode *opc;
+  const bfd_byte *field[3];
+  bfd_byte insn[3];
+  int i, pos;
+
+  if (info->read_memory_func (addr, insn, 1, info) != 0)
+    {
+      info->memory_error_func (-1, addr, info);
+      return -1;
+    }
+
+  /* An instruction the section ends inside of is shown as its first
+     byte.  */
+  opc = i51_find_opcode (insn[0]);
+  if (opc != NULL && opc->size > 1
+      && info->read_memory_func (addr + 1, insn + 1, opc->size - 1, info) != 0)
+    opc = NULL;
+
+  info->insn_info_valid = 1;
+  info->target = 0;
+  if (opc == NULL)
+    {
+      info->insn_type = dis_noninsn;
+      info->fprintf_styled_func (info->stream, dis_style_assembler_directive,
+				 ".byte");
+      info->fprintf_styled_func (info->stream, dis_style_text, "\t");
+      info->fprintf_styled_func (info->stream, dis_style_immediate,
+				 "0x%02x", insn[0]);
+      return 1;
+    }
+
+  /* MOV direct,direct stores its source first.  */
+  pos = 1;
+  for (i = 0; i < 3; i++)
+    {
+      field[i] = insn + pos;
+      pos += i51_field_size (opc, opc->args[i]);
+    }
+  if (opc->args[0] == 'D' && opc->args[1] == 'D')
+    {
+      field[1] = insn + 1;
+      field[0] = insn + 2;
+    }
+
+  info->insn_type = i51_insn_type (opc);
+  info->fprintf_styled_func (info->stream, dis_style_mnemonic, "%s",
+			     opc->name);
+  for (i = 0; i < 3 && opc->args[i] != 'N'; i++)
+    {
+      info->fprintf_styled_func (info->stream, dis_style_text,
+				 i == 0 ? "\t" : ", ");
+      i51_print_operand (opc, opc->args[i], insn, field[i], addr + opc->size,
+			 info);
+    }
+  return opc->size;
+}
