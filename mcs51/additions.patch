+
+/* Match one pcode operand keyword at input_line_pointer and step over it.
+   The keyword has to end where it ends: plain strncmp took the BYTE out of
+   a symbol called BYTECOUNT and assembled the rest, COUNT, as the operand,
+   silently relocating against a symbol the source never mentions.  */
+
+static int
+pcode_keyword (const char *kw)
+{
+  size_t len = strlen (kw);
+
+  if (strncmp (input_line_pointer, kw, len) != 0)
+    return 0;
+  if (is_part_of_name (input_line_pointer[len]))
+    return 0;
+  input_line_pointer += len;
+  return 1;
+}
+
+void
+pcodeOperand (expressionS *ex, enum PADRMODE *mode, int separator)
+{
+  SKIP_WHITESPACE ();
+  if ((*input_line_pointer != '\0') && (*input_line_pointer != '\x0D') && (*input_line_pointer != '\x0A') && (*input_line_pointer != ';'))
+    {
+      if (separator)
+	{
+	  if (*input_line_pointer != ',')
+	    {
+	      as_bad (_("Expected comma after pcode operand"));
+	      ignore_rest_of_line ();
+	      return;
+	    }
+	  input_line_pointer++;		/* skip ',' */
+	  SKIP_WHITESPACE ();
+	}
+      //search #, #BYTE, #SWAP, #SHL8, BYTE, SWAP, SHL8, @BYTE, @SWAP, @
+      if      (pcode_keyword ("#BYTE")) { *mode = DIRECTBYTE; }
+      else if (pcode_keyword ("#SWAP")) { *mode = DIRECTSWAP; }
+      else if (pcode_keyword ("#SHL8")) { *mode = DIRECTSHL8; }
+      else if (pcode_keyword ("#WORD")) { *mode = DIRECTWORD; }
+      else if (strncmp (input_line_pointer, "#",     1) == 0) { *mode = DIRECTWORD; input_line_pointer += 1; }
+      else if (pcode_keyword ("BYTE"))  { *mode = DIRECTBYTE; }
+      else if (pcode_keyword ("SWAP"))  { *mode = DIRECTSWAP; }
+      else if (pcode_keyword ("SHL8"))  { *mode = DIRECTSHL8; }
+      else if (pcode_keyword ("WORD"))  { *mode = DIRECTWORD; }
+      else if (pcode_keyword ("@BYTE")) { *mode = INDIRECTBYTE; }
+      else if (pcode_keyword ("@SWAP")) { *mode = INDIRECTSWAP; }
+      else if (pcode_keyword ("@WORD")) { *mode = INDIRECTWORD; }
+      else if (strncmp (input_line_pointer, "@",     1) == 0) { *mode = INDIRECTWORD; input_line_pointer += 1; }
+      else                                                    { *mode = DIRECTWORD; }
+      SKIP_WHITESPACE ();
+      expression (ex);
+    }
+  else
+    {
+      ex->X_op = O_constant;
+      ex->X_add_number = 0;
+      *mode = DIRECTBYTE;
+    }
+}
+
+
+void
+writePcodeOperand (expressionS *ex, enum PADRMODE *mode, int swapable ATTRIBUTE_UNUSED)
+{
+  char *f;
+
+  switch (*mode) {
+  case DIRECTBYTE:
+  case DIRECTSHL8:
+  case INDIRECTWORD:
+  case INDIRECTSWAP:
+    // byte mode
+      if (ex->X_op == O_constant)
+	{
+	  if (0x00FF & ex->X_add_number)
+	    {
+	      f = frag_more (1);
+	      number_to_chars_bigendian (f, 0x00FF & ex->X_add_number, 1);
+	    }
+	}
+      else
+	{
+	  f = frag_more (1);
+	  /* Now create a 8-bit fixup. */
+	  fix_new_exp (frag_now, f - frag_now->fr_literal, 1,
+			      ex,
+			      false,
+			      BFD_RELOC_8);
+	  number_to_chars_bigendian (f, 0, 1);
+	}
+      break;
+  case INDIRECTBYTE:
+    // indirect byte mode
+      if (ex->X_op == O_constant)
+	{
+	  if (0x00FF & ex->X_add_number)
+	    {
+	      f = frag_more (1);
+	      number_to_chars_bigendian (f, 0x00FF & (ex->X_add_number - 1), 1);
+	    }
+	}
+      else
+	{
+	  f = frag_more (1);
+	  /* Now create a 8-bit fixup. */
+	  fix_new_exp (frag_now, f - frag_now->fr_literal, 1,
+			      ex,
+			      false,
+			      BFD_RELOC_8);
+	  number_to_chars_bigendian (f, -1, 1);
+	}
+      break;
+  case DIRECTWORD:
+    // word mode
+    if (ex->X_op == O_constant)
+      {
+	if (0xFF00 & ex->X_add_number)  //MSB
+	  {
+	    f = frag_more (1);
+	    number_to_chars_bigendian (f, 0x00FF & (ex->X_add_number >> 8), 1);
+	  }
+	if (0x00FF & ex->X_add_number)  //LSB
+	  {
+	    f = frag_more (1);
+	    number_to_chars_bigendian (f, 0x00FF & ex->X_add_number, 1);
+	  }
+      }
+    else
+      {
+	f = frag_more (2);
+	/* Now create a 16-bit fixup. */
+	fix_new_exp (frag_now, f - frag_now->fr_literal, 2,
+			    ex,
+			    false,
+			    BFD_RELOC_16);
+	number_to_chars_bigendian (f, 0, 2);
+      }
+    break;
+  case DIRECTSWAP:
+    //direct swap word mode
+    if (ex->X_op == O_constant)
+      { //direct swap mode
+	if (0x00FF & ex->X_add_number)  //LSB
+	  {
+	    f = frag_more (1);
+	    number_to_chars_bigendian (f, 0x00FF & ex->X_add_number, 1);
+	  }
+	if (0xFF00 & ex->X_add_number)  //MSB
+	  {
+	    f = frag_more (1);
+	    number_to_chars_bigendian (f, 0x00FF & (ex->X_add_number >> 8), 1);
+	  }
+      }
+    else
+      {
+	f = frag_more (2);
+	/* Now create a 16-bit fixup. */
+	fix_new_exp (frag_now, f - frag_now->fr_literal, 2,
+			    ex,
+			    false,
+			    BFD_RELOC_16);
+	number_to_chars_bigendian (f, 0, 2);
+      }
+    break;
+  }
+}
+
+unsigned short
+decodePcodeOperand (expressionS *ex, enum PADRMODE *mode, int swapable)
+{
+  unsigned short pflags;
+
+  pflags = 0;
+
+  switch (*mode) {
+  case DIRECTBYTE:
+  case INDIRECTWORD:
+  case INDIRECTBYTE:
+    if (ex->X_op == O_constant)
+      {
+	if (!check_range (ex->X_add_number, I51_OP_IMM8))
+	  {
+	    as_bad (_("operand out of 8-bit range: `%ld'."),
+		    (long) ex->X_add_number);
+	  }
+	if (0x00FF & ex->X_add_number)
+	  {
+	    pflags |= 0x40;
+	  }
+      }
+    else
+      {
+	pflags |= 0x40;
+      }
+    break;
+  case INDIRECTSWAP:
+    if (ex->X_op == O_constant)
+      {
+	if (!check_range (ex->X_add_number, I51_OP_IMM8))
+	  {
+	    as_bad (_("operand out of 8-bit range: `%ld'."),
+		    (long) ex->X_add_number);
+	  }
+	if (0x00FF & ex->X_add_number)
+	  {
+	    pflags |= 0x40;   //allocate 8 bit
+	  }
+	pflags |= 0x02;       //set swap flag
+      }
+    else
+      {
+	if (swapable == 0)
+	  {
+	    as_bad (_("Pcode operand 2 isn't swapable"));
+	  }
+	pflags |= 0x42;       //allocate 8 bit and set swap flag
+      }
+    break;
+  case DIRECTSHL8:
+    if (ex->X_op == O_constant)
+      {
+	if (!check_range (ex->X_add_number, I51_OP_IMM8))
+	  {
+	    as_bad (_("operand out of 8-bit range: `%ld'."),
+		    (long) ex->X_add_number);
+	  }
+	if (0x00FF & ex->X_add_number)
+	  {
+	    pflags |= 0x80;
+	  }
+      }
+    else
+      {
+	pflags |= 0x80;
+      }
+    break;
+  case DIRECTWORD:
+    //word mode
+    if (ex->X_op == O_constant)
+      {
+	if (!check_range (ex->X_add_number, I51_OP_IMM16))
+	  {
+	    as_bad (_("operand out of 16-bit range: `%ld'."),
+		    (long) ex->X_add_number);
+	  }
+	//direct no swap mode
+	if (0xFF00 & ex->X_add_number) pflags |= 0x80; //MSB
+	if (0x00FF & ex->X_add_number) pflags |= 0x40; //LSB
+      }
+    else
+      {
+	pflags |= 0xC0;
+      }
+    break;
+  case DIRECTSWAP:
+    //word mode
+    if (ex->X_op == O_constant)
+      {
+	if (!check_range (ex->X_add_number, I51_OP_IMM16))
+	  {
+	    as_bad (_("operand out of 16-bit range: `%ld'."),
+		    (long) ex->X_add_number);
+	  }
+	//direct swap mode (#SWAP)
+	if (0x00FF & ex->X_add_number) pflags |= 0x80; //LSB
+	if (0xFF00 & ex->X_add_number) pflags |= 0x40; //MSB
+	pflags |= 0x02;       //swap flag
+      }
+    else
+      {
+	if (swapable == 0)
+	  {
+	    as_bad (_("Pcode operand 2 isn't swapable"));
+	  }
+	pflags |= 0xC2;       //allocate 16 bit and set swap flag
+      }
+    break;
+  }
+  switch (*mode) {
+  case INDIRECTWORD:
+  case INDIRECTBYTE:
+  case INDIRECTSWAP:
+    pflags |= 0x8000;         //indirect flag
+  default:
+    break;
+  }
+  return pflags;
+}
+
+void
+i51_pcode (int ignore ATTRIBUTE_UNUSED)
+{
+  char *f;
+  unsigned short pflags;
+  unsigned short temppflags;
+
+  expression (&op_expr1);
+  pcodeOperand (&op_expr2, &p2mode, 0);
+  pcodeOperand (&op_expr3, &p3mode, 1);
+  pcodeOperand (&op_expr4, &p4mode, 1);
+  demand_empty_rest_of_line ();
+
+  pflags     = decodePcodeOperand (&op_expr2, &p2mode, 1);
+  temppflags = decodePcodeOperand (&op_expr3, &p3mode, 0);
+  pflags    |= (temppflags & 0x00C0) >> 2;                 //data allocation
+  pflags    |= (temppflags & 0x8000) >> 1;                 //indirect flag
+  temppflags = decodePcodeOperand (&op_expr4, &p4mode, 1);
+  pflags    |= (temppflags & 0x00C0) >> 4;                 //data allocation
+  pflags    |= (temppflags & 0x8000) >> 2;                 //indirect flag
+  pflags    |= (temppflags & 0x0002) >> 1;                 //swap flag
+
+  /* pcode exec address */
+  f = frag_more (2);
+  temppflags = pflags & 0xE000;
+  if (op_expr1.X_op == O_constant)
+    {
+      if (op_expr1.X_add_number > 0x1FFF)
+	{
+	  as_bad (_("Pcode exec address out of 13-bit range: `%ld'."),
+		  (long) op_expr1.X_add_number);
+	}
+      if (op_expr1.X_add_number < 0x0100)
+	{
+	  as_bad (_("Pcode exec address underflow: `%ld'."),
+		  (long) op_expr1.X_add_number);
+	}
+      temppflags |= op_expr1.X_add_number & 0x1FFF;
+      number_to_chars_bigendian (f, temppflags, 2);
+    }
+  else if (op_expr1.X_op != O_register)
+    {
+      /* Now create a 13-bit fixup.  */
+      fix_new_exp (frag_now, f - frag_now->fr_literal, 2,
+			  &op_expr1,
+			  false,
+			  BFD_RELOC_I51_13_PCODE);
+      number_to_chars_bigendian (f, temppflags, 2);
+    }
+  else
+    {
+      as_fatal (_("Operand `%x' not recognized in pcode."), op_expr1.X_op);
+    }
+
+  /* pcode flags */
+  f = frag_more (1);
+  number_to_chars_bigendian (f, pflags & 0xFF, 1);
+  /* 1th pcode operand */
+  writePcodeOperand (&op_expr2, &p2mode, 1);
+  /* 2nd pcode operand */
+  writePcodeOperand (&op_expr3, &p3mode, 0);
+  /* 3th pcode operand */
+  writePcodeOperand (&op_expr4, &p4mode, 1);
+}
