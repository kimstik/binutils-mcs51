--- /dev/null
+++ b/opcodes/i51-dis.c
@@ -0,0 +1,251 @@
+/* Disassemble MCS-51 instructions.
+   Copyright (C) 2001-2026 Free Software Foundation, Inc.
+   Contributed by Radek Benedikt <benedikt@lphard.cz>
+
