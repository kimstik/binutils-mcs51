+
+/* Map a memory-space common onto the processor-specific section index
+   that names its space.  */
+
+bool
+elf32_i51_section_from_bfd_section (bfd *abfd ATTRIBUTE_UNUSED, asection *sec, int *retval)
+{
+  const char *name;
+
+  /* Such a common sits in a fake common section that carries the space
+     name in place of *COM*.  Real sections of those names hold local
+     data and keep the index they were numbered with, so only common
+     sections are considered here.  */
+  if (! bfd_is_com_section (sec))
+    return 0;
+
+  name = bfd_section_name (sec);
+  if (name == NULL)
+    return 0;
+
+  if (strcmp (name, ".regbank") == 0)
+    {
+      *retval = SHN_I51_REGBANK;
+      return 1;
+    }
+  else if (strcmp (name, ".rbss") == 0)
+    {
+      *retval = SHN_I51_RDATA_C;
+      return 1;
+    }
+  else if (strcmp (name, ".bbss") == 0)
+    {
+      *retval = SHN_I51_BDATA_C;
+      return 1;
+    }
+  else if (strcmp (name, ".ibss") == 0)
+    {
+      *retval = SHN_I51_IDATA_C;
+      return 1;
+    }
+  else if (strcmp (name, ".xbss") == 0)
+    {
+      *retval = SHN_I51_XDATA_C;
+      return 1;
+    }
+  else if (strcmp (name, ".ebss") == 0)
+    {
+      *retval = SHN_I51_EDATA_C;
+      return 1;
+    }
+  else if (strcmp (name, ".bitbss") == 0)
+    {
+      *retval = SHN_I51_BITDATA_C;
+      return 1;
+    }
+  return 0;
+}
