+
+void
+md_show_usage (FILE *stream)
+{
+  fprintf (stream, _("\
+MCS-51 options:\n\
+  -mmcu=NAME              the part whose special function registers are\n\
+                          known: 8051, 8052 or at89s8252 (the default)\n\
+  -mcase-sensitive        do not fold symbol names to upper case\n"));
+}
+
+int
+md_parse_option (int c, const char *arg)
+{
+  size_t i;
+
+  if (c == OPTION_CASE_SENSITIVE)
+    {
+      i51_fold_case = false;
+      return 1;
+    }
+  if (c != OPTION_MMCU)
+    return 0;
+  for (i = 0; i < ARRAY_SIZE (i51_mcus); i++)
+    if (strcasecmp (arg, i51_mcus[i].name) == 0)
+      {
+	i51_mcu = i51_mcus[i].mcu;
+	return 1;
+      }
+  as_bad (_("unknown MCU `%s'"), arg);
+  return 1;
+}
+
+/* tc_canonicalize_symbol_name: symbol names are folded to upper case,
+   as in every MCS-51 assembler, unless -mcase-sensitive says otherwise.
+   A name that starts with a dot keeps its case: the names of sections,
+   of their symbols and of the .startof. and .sizeof. symbols are among
+   them.  */
+
+char *
+i51_canonicalize_symbol_name (char *name)
+{
+  char *p;
+
+  if (!i51_fold_case || name[0] == '.')
+    return name;
+  for (p = name; *p != 0; p++)
+    *p = TOUPPER (*p);
+  return name;
+}
+
+/* The common section of the memory space whose commons the linker
+   collects in NAME, or bfd's own for .bss.  */
+
+static asection *
+i51_common_section (const char *name)
+{
+  size_t i;
+
+  for (i = 0; i < ARRAY_SIZE (i51_common_names); i++)
+    if (strcmp (name, i51_common_names[i]) == 0)
+      return &i51_com_sections[i];
+  return bfd_com_section_ptr;
+}
+
+void
+md_begin (void)
+{
+  const struct i51_opcode *opc;
+  const struct i51_name *n;
+  size_t i;
+
+  gas_assert (strcmp (i51_spaces[I51_RBSS].name, ".rbss") == 0
+	      && strcmp (i51_spaces[I51_EEPROM].name, ".eeprom") == 0);
+
+  i51_opcode_hash = str_htab_create ();
+  i51_name_hash = str_htab_create ();
+  i51_names_used = str_htab_create ();
+  i51_common_decls = str_htab_create ();
+
+  /* The rows of one mnemonic are adjacent; the hash names the first.  */
+  for (opc = i51_opcodes; opc->name != NULL; opc++)
+    str_hash_insert (i51_opcode_hash, opc->name, opc, 0);
+  for (n = i51_names; n->name != NULL; n++)
+    if ((n->mcu & i51_mcu) != 0)
+      str_hash_insert (i51_name_hash, n->name, n, 0);
+
+  for (i = 0; i < ARRAY_SIZE (i51_common_names); i++)
+    {
+      asection *sec = &i51_com_sections[i];
+      asymbol *sym = &i51_com_symbols[i];
+
+      *sec = *bfd_com_section_ptr;
+      sec->name = i51_common_names[i];
+      sec->output_section = sec;
+      sec->symbol = sym;
+      *sym = *bfd_com_section_ptr->symbol;
+      sym->name = sec->name;
+      sym->section = sec;
+    }
+
+  elf_elfheader (stdoutput)->e_flags |= EF_I51_ABI_CURRENT;
+}
+
+/* Built-in names.  */
+
+/* The built-in name NAME, LEN characters long, in any case.  */
+
+static const struct i51_name *
+i51_lookup_name (const char *name, size_t len)
+{
+  char upper[I51_NAME_MAX + 1];
+  size_t i;
+
+  if (len > I51_NAME_MAX)
+    return NULL;
+  for (i = 0; i < len; i++)
+    upper[i] = TOUPPER ((unsigned char) name[i]);
+  upper[len] = 0;
+  return str_hash_find (i51_name_hash, upper);
+}
+
+/* Whether the program has a symbol called NAME - one it defined, or
+   declared with .local, .global or the like.  Such a symbol is what the
+   name means, whatever built-in name it shares.  */
+
+static bool
+i51_user_symbol (const char *name, size_t len)
+{
+  char *copy = xmemdup0 (name, len);
+  bool found = symbol_find (copy) != NULL;
+
+  free (copy);
+  return found;
+}
+
+static void
+i51_note_use (const char *name, bool bit)
+{
+  struct i51_name_use *use;
+  char *upper, *p;
+
+  if (i51_name_use (name) != NULL)
+    return;
+  upper = xstrdup (name);
+  for (p = upper; *p != 0; p++)
+    *p = TOUPPER (*p);
+  use = XNEW (struct i51_name_use);
+  use->file = as_where (&use->line);
+  use->bit = bit;
+  str_hash_insert (i51_names_used, upper, use, 0);
+}
+
+/* The value of a built-in byte or bit name.  ARn is register n of the
+   bank the last .using selected.  */
+
+static void
+i51_builtin_value (const struct i51_name *n, expressionS *exp)
+{
+  memset (exp, 0, sizeof (*exp));
+  exp->X_op = O_constant;
+  exp->X_add_number = n->value;
+  if (n->kind == 'U')
+    {
+      if (i51_regbank < 0)
+	as_bad (_("missing .using"));
+      else
+	exp->X_add_number += i51_regbank * 8;
+    }
+  if (n->kind == 'B')
+    i51_operator_class = 'B';
+  i51_note_use (n->name, false);
+}
+
+/* Where NAME was first used as a built-in name or as NAME.N, or NULL.
+   The uses are recorded in upper case, as the built-in names are spelled
+   whether or not symbol names are folded.  */
+
+static struct i51_name_use *
+i51_name_use (const char *name)
+{
+  char *upper = xstrdup (name);
+  struct i51_name_use *use;
+  char *p;
+
+  for (p = upper; *p != 0; p++)
+    *p = TOUPPER (*p);
+  use = str_hash_find (i51_names_used, upper);
+  free (upper);
+  return use;
+}
+
+/* tc_frob_symbol: a symbol may not be defined under a built-in name the
+   file has already used as such.  */
+
+void
+i51_frob_symbol (symbolS *sym)
+{
+  struct i51_name_use *use;
+
+  if (sym != i51_rb_symbol && !i51_rb_reported
+      && strcmp (S_GET_NAME (sym), "__RB__") == 0
+      && (S_IS_DEFINED (sym) || S_IS_COMMON (sym)))
+    as_bad (_("`__RB__' is the register-bank common of .using and cannot "
+	      "be defined"));
+  i51_check_common (sym);
+
+  /* Using a built-in name makes no symbol, so any symbol of the name -
+     defined, or made by .local, .global, .type and the like - came
+     after.  */
+  if (symbol_section_p (sym))
+    return;
+  use = i51_name_use (S_GET_NAME (sym));
+  if (use == NULL)
+    return;
+  if (use->bit)
+    as_bad_where (use->file, use->line,
+		  _("`%s' is used here as a bit of the byte before the dot "
+		    "and defined later as a symbol; define it before its "
+		    "first use"), S_GET_NAME (sym));
+  else
+    as_bad_where (use->file, use->line,
+		  _("`%s' is used here as the built-in name and defined "
+		    "later as a symbol; declare it with .local first"),
+		  S_GET_NAME (sym));
+}
+
+/* tc_frob_label, which takes over the DWARF line entry obj-elf.h would
+   make for a label.  */
+
+void
+i51_frob_label (symbolS *sym)
+{
+  if (strcmp (S_GET_NAME (sym), "__RB__") == 0)
+    {
+      as_bad (_("`__RB__' is the register-bank common of .using and cannot "
+		"be defined"));
+      i51_rb_reported = true;
+    }
+  dwarf2_emit_label (sym);
+}
+
+/* Expression operators.  */
+
+/* Read the argument list of HIGH, LOW or B2B, with input_line_pointer on
+   the '('.  */
+
+static bool
+i51_operator_args (const char *op, expressionS *arg, offsetT *bit)
+{
+  ++input_line_pointer;
+  expression (arg);
+  if (arg->X_op == O_absent)
+    {
+      as_bad (_("missing operand of %s()"), op);
+      return false;
+    }
+  SKIP_WHITESPACE ();
+  if (bit != NULL)
+    {
+      if (*input_line_pointer != ',')
+	{
+	  as_bad (_("%s() takes a byte address and a bit number"), op);
+	  return false;
+	}
+      ++input_line_pointer;
+      *bit = get_absolute_expression ();
+      SKIP_WHITESPACE ();
+    }
+  if (*input_line_pointer != ')')
+    {
+      as_bad (_("missing `)' after %s()"), op);
+      return false;
+    }
+  ++input_line_pointer;
+  return true;
+}
+
+/* Make EXP the operator OP, called NAME, applied to ARG.  */
+
+static void
+i51_apply_operator (expressionS *exp, operatorT op, const char *name,
+		    expressionS *arg, offsetT bit)
+{
+  memset (exp, 0, sizeof (*exp));
+  exp->X_op = O_constant;
+  i51_operator_class = op == O_i51_b2b ? 'B' : 'D';
+
+  if (op == O_i51_b2b && (bit < 0 || bit > 7))
+    {
+      as_bad (_("bit number %ld is not 0..7"), (long) bit);
+      return;
+    }
+
+  if (arg->X_op == O_constant)
+    {
+      offsetT v = arg->X_add_number;
+      long b;
+
+      switch (op)
+	{
+	case O_i51_high:
+	  if (v < -32768 || v > 65535)
+	    as_bad (_("operand of HIGH() out of range: %ld"), (long) v);
+	  exp->X_add_number = (v >> 8) & 0xff;
+	  break;
+	case O_i51_low:
+	  exp->X_add_number = v & 0xff;
+	  break;
+	default:
+	  b = i51_bit_address (v, bit);
+	  if (b < 0)
+	    as_bad (_("B2B(%#lx,%ld): %#lx is not bit addressable"),
+		    (unsigned long) v, (long) bit, (unsigned long) v);
+	  else
+	    exp->X_add_number = b;
+	  break;
+	}
+      return;
+    }
+
+  if (I51_IS_OPERATOR (arg->X_op))
+    {
+      as_bad (_("%s() of HIGH(), LOW() or B2B() of a value not known here"),
+	      name);
+      i51_operators_pending--;
+      return;
+    }
+  if (!i51_operators_allowed)
+    {
+      as_bad (_("%s() of a value not known here is allowed only as an "
+		"instruction operand or a one-byte datum"), name);
+      return;
+    }
+
+  i51_operators_pending++;
+  exp->X_op = op;
+  if (arg->X_op == O_symbol)
+    {
+      exp->X_add_symbol = arg->X_add_symbol;
+      exp->X_add_number = arg->X_add_number;
+    }
+  else
+    exp->X_add_symbol = make_expr_symbol (arg);
+  i51_operator_addend = exp->X_add_number;
+  exp->X_md = op == O_i51_b2b ? bit : 0;
+}
+
+/* md_parse_name: the names of the assembly language.  HIGH, LOW and B2B
+   followed by a parenthesis are operators.  A built-in register name
+   stands for its address unless the program has a symbol of that name;
+   a general register is refused.  NAME.N is bit N of the byte NAME.  */
+
+int
+i51_parse_name (const char *name, expressionS *exp,
+		enum expr_mode mode ATTRIBUTE_UNUSED, char *nextcharP)
+{
+  static const struct
+  {
+    const char *name;
+    operatorT op;
+  } operators[] =
+  {
+    { "HIGH", O_i51_high },
+    { "LOW",  O_i51_low },
+    { "B2B",  O_i51_b2b },
+  };
+  size_t len = strlen (name);
+  const struct i51_name *n;
+  const char *dot;
+  size_t i;
+
+  for (i = 0; i < ARRAY_SIZE (operators); i++)
+    if (strcasecmp (name, operators[i].name) == 0)
+      {
+	char *p = input_line_pointer;
+	expressionS arg;
+	offsetT bit = 0;
+
+	*p = *nextcharP;
+	p = skip_space (p);
+	if (*p != '(')
+	  {
+	    *input_line_pointer = 0;
+	    break;
+	  }
+	input_line_pointer = p;
+	if (i51_operator_args (operators[i].name, &arg,
+			       operators[i].op == O_i51_b2b ? &bit : NULL))
+	  i51_apply_operator (exp, operators[i].op, operators[i].name, &arg,
+			      bit);
+	else
+	  {
+	    memset (exp, 0, sizeof (*exp));
+	    exp->X_op = O_constant;
+	  }
+	*nextcharP = *input_line_pointer;
+	*input_line_pointer = 0;
+	return 1;
+      }
+
+  if (i51_user_symbol (name, len))
+    return 0;
+
+  n = i51_lookup_name (name, len);
+  if (n != NULL)
+    {
+      if (n->kind == 'D' || n->kind == 'B' || n->kind == 'U')
+	i51_builtin_value (n, exp);
+      else
+	{
+	  as_bad (_("register `%s' is not valid in an expression"), name);
+	  memset (exp, 0, sizeof (*exp));
+	  exp->X_op = O_constant;
+	}
+      return 1;
+    }
+
+  /* NAME.N: bit N of the byte NAME.  */
+  dot = strrchr (name, '.');
+  if (dot != NULL && dot != name && dot[1] != 0
+      && strspn (dot + 1, "0123456789") == strlen (dot + 1))
+    {
+      size_t baselen = dot - name;
+      expressionS arg;
+      offsetT bit = strtol (dot + 1, NULL, 10);
+      char *full;
+
+      memset (&arg, 0, sizeof (arg));
+      full = xstrdup (name);
+      i51_note_use (full, true);
+      free (full);
+      n = i51_lookup_name (name, baselen);
+      if (n != NULL && !i51_user_symbol (name, baselen))
+	{
+	  if (n->kind != 'D')
+	    {
+	      as_bad (_("`%s' is not a bit address"), name);
+	      memset (exp, 0, sizeof (*exp));
+	      exp->X_op = O_constant;
+	      return 1;
+	    }
+	  i51_builtin_value (n, &arg);
+	}
+      else
+	{
+	  char *base = xmemdup0 (name, baselen);
+
+	  arg.X_op = O_symbol;
+	  arg.X_add_symbol = symbol_find_or_make (base);
+	  free (base);
+	  if (S_GET_SEGMENT (arg.X_add_symbol) == absolute_section
+	      && !S_FORCE_RELOC (arg.X_add_symbol, 0))
+	    {
+	      arg.X_op = O_constant;
+	      arg.X_add_number = S_GET_VALUE (arg.X_add_symbol);
+	    }
+	}
+      i51_apply_operator (exp, O_i51_b2b, "B2B", &arg, bit);
+      return 1;
+    }
+
+  return 0;
+}
+
+/* Read an expression in which an operator may be left for a fixup: an
+   instruction operand or a datum.  Such an operator has to be the whole
+   value.  */
+
+static bool
+i51_read_expression (expressionS *exp)
+{
+  bool whole;
+
+  i51_operators_allowed = true;
+  i51_operators_pending = 0;
+  i51_operator_class = 0;
+  expression (exp);
+  i51_operators_allowed = false;
+
+  whole = (i51_operators_pending == 0
+	   || (i51_operators_pending == 1 && I51_IS_OPERATOR (exp->X_op)
+	       && exp->X_add_number == i51_operator_addend));
+  if (!whole)
+    {
+      as_bad (_("HIGH(), LOW() and B2B() of a value not known here have to "
+		"be the whole operand"));
+      memset (exp, 0, sizeof (*exp));
+      exp->X_op = O_constant;
+    }
+  return whole;
+}
+
+/* TC_PARSE_CONS_EXPRESSION.  */
+
+bfd_reloc_code_real_type
+i51_parse_cons_expression (expressionS *exp, int nbytes ATTRIBUTE_UNUSED)
+{
+  i51_read_expression (exp);
+  return BFD_RELOC_NONE;
+}
+
+/* Fold a `.N' suffix on a number into a bit address and say whether
+   there was one.  The operand, read from START, has to be that number
+   alone: a name with the suffix is folded by i51_parse_name (), and
+   after a number expression () stops at the dot.  */
+
+static bool
+i51_fold_bit_suffix (expressionS *exp, const char *start)
+{
+  const char *p;
+  char *end;
+  long n, bit;
+
+  if (exp->X_op != O_constant
+      || input_line_pointer[0] != '.'
+      || !ISDIGIT (input_line_pointer[1]))
+    return false;
+  for (p = start; p < input_line_pointer; p++)
+    if (!ISALNUM (*p))
+      return false;
+
+  n = strtol (input_line_pointer + 1, &end, 10);
+  bit = i51_bit_address (exp->X_add_number, n);
+  if (n > 7)
+    as_bad (_("bit number %ld is not 0..7"), n);
+  else if (bit < 0)
+    as_bad (_("%#lx is not bit addressable"),
+	    (unsigned long) exp->X_add_number);
+  exp->X_add_number = bit < 0 ? 0 : bit;
+  input_line_pointer = end;
+  return true;
+}
+
+/* Instructions.  */
+
+/* Parse one operand at input_line_pointer into OP.  */
+
+static bool
+i51_parse_operand (struct i51_operand *op)
+{
+  const struct i51_name *n;
+  char *p, *end, *next, *start;
+
+  memset (op, 0, sizeof (*op));
+  SKIP_WHITESPACE ();
+  p = input_line_pointer;
+
+  /* An indirect operand is a fixed name: `@R0', `@A+DPTR'.  */
+  if (*p == '@')
+    {
+      char name[I51_NAME_MAX + 1];
+      size_t len = 0;
+      bool fits = true, ended = false;
+
+      for (end = p; *end != ',' && !is_end_of_stmt (*end); end++)
+	if (is_whitespace (*end))
+	  ended = len > 0;
+	else if (ended || len == I51_NAME_MAX)
+	  fits = false;
+	else
+	  name[len++] = *end;
+      n = fits ? i51_lookup_name (name, len) : NULL;
+      if (n == NULL)
+	{
+	  as_bad (_("invalid indirect operand `%.*s'"), (int) (end - p), p);
+	  return false;
+	}
+      input_line_pointer = end;
+      op->cls = n->kind;
+      op->reg = n->value;
+      i51_note_use (n->name, false);
+      return true;
+    }
+
+  /* An operand that is one built-in name: followed by a comma, by the end
+     of the statement, or by something that cannot continue an expression,
+     which is then junk.  */
+  for (end = p; *end != ',' && !is_whitespace (*end) && !is_end_of_stmt (*end);
+       end++)
+    ;
+  next = skip_space (end);
+  if ((*next == ',' || is_end_of_stmt (*next) || is_name_beginner (*next))
+      && (n = i51_lookup_name (p, end - p)) != NULL
+      && !i51_user_symbol (p, end - p))
+    {
+      input_line_pointer = end;
+      switch (n->kind)
+	{
+	case 'D':
+	case 'B':
+	  op->cls = n->kind;
+	  i51_builtin_value (n, &op->exp);
+	  break;
+	case 'U':
+	  op->cls = 'D';
+	  i51_builtin_value (n, &op->exp);
+	  break;
+	case '/':
+	  op->cls = '/';
+	  i51_builtin_value (n, &op->exp);
+	  break;
+	default:
+	  op->cls = n->kind;
+	  op->reg = n->value;
+	  i51_note_use (n->name, false);
+	  break;
+	}
+      return true;
+    }
+
+  switch (*p)
+    {
+    case '#':
+    case '/':
+      op->cls = *p;
+      input_line_pointer = p + 1;
+      break;
+    default:
+      op->cls = 'E';
+      break;
+    }
+
+  start = input_line_pointer;
+  if (!i51_read_expression (&op->exp))
+    return false;
+  if (op->exp.X_op == O_absent)
+    {
+      as_bad (_("missing operand"));
+      return false;
+    }
+  if (i51_fold_bit_suffix (&op->exp, start))
+    i51_operator_class = 'B';
+
+  /* What a bit or byte operator made stays a bit or a byte.  */
+  if (I51_IS_OPERATOR (op->exp.X_op) || op->exp.X_op == O_constant)
+    {
+      char made = (op->exp.X_op == O_i51_b2b ? 'B'
+		   : I51_IS_OPERATOR (op->exp.X_op) ? 'D'
+		   : i51_operator_class);
+
+      if (made != 0 && op->cls == 'E')
+	op->cls = made;
+      else if (made == 'B' && op->cls == '#')
+	{
+	  as_bad (_("a bit address is not a number"));
+	  return false;
+	}
+      else if (made == 'D' && op->cls == '/')
+	{
+	  as_bad (_("HIGH() and LOW() name a byte, not a bit"));
+	  return false;
+	}
+    }
+  return true;
+}
+
+/* Whether the operands fit the row OPC.  */
+
+static bool
+i51_row_fits (const struct i51_opcode *opc, const struct i51_operand *ops,
+	      int nops)
+{
+  int i;
+
+  for (i = 0; i < I51_MAX_OPERANDS; i++)
+    {
+      char arg = opc->args[i];
+
+      if (i >= nops)
+	{
+	  if (arg != 'N')
+	    return false;
+	}
+      else if (ops[i].cls == 'E')
+	{
+	  if (strchr ("DBJ16", arg) == NULL)
+	    return false;
+	}
+      else if (ops[i].cls != arg)
+	return false;
+    }
+  return true;
+}
+
+/* The first row of MNEMONIC the operands fit, or NULL.  */
+
+static const struct i51_opcode *
+i51_find_row (const char *mnemonic, const struct i51_operand *ops, int nops)
+{
+  const struct i51_opcode *first, *opc;
+
+  first = str_hash_find (i51_opcode_hash, mnemonic);
+  if (first == NULL)
+    return NULL;
+  for (opc = first; opc->name != NULL && strcmp (opc->name, first->name) == 0;
+       opc++)
+    if (i51_row_fits (opc, ops, nops))
+      return opc;
+  return NULL;
+}
+
+/* The generic jump and call of MCS-51 assembly: nothing is relaxed, so
+   they are the long forms, which reach the whole code space.  */
+
+static const char *
+i51_alias (const char *mnemonic)
+{
+  if (strcmp (mnemonic, "jmp") == 0)
+    return "ljmp";
+  if (strcmp (mnemonic, "call") == 0)
+    return "lcall";
+  return NULL;
+}
+
+/* Put an operand field of kind FIELD holding EXP.  An ACALL or AJMP
+   target shares its two bytes with OPCODE.  Every field goes through a
+   fixup, so md_apply_fix () makes every range check.  */
+
+static void
+i51_emit_field (expressionS *exp, enum i51_field field, unsigned int opcode)
+{
+  bfd_reloc_code_real_type reloc = i51_field_relocs[field];
+  int size = field >= I51_PAGE ? 2 : 1;
+  unsigned int contents = 0;
+  char *f = frag_more (size);
+  fixS *fixp;
+
+  switch (exp->X_op)
+    {
+    case O_i51_high:
+    case O_i51_low:
+      if (field != I51_DIRECT && field != I51_IMMEDIATE)
+	{
+	  as_bad (_("HIGH() and LOW() name a byte, and are allowed only on "
+		    "an eight-bit operand"));
+	  return;
+	}
+      reloc = exp->X_op == O_i51_high ? BFD_RELOC_I51_8_HIGH
+				      : BFD_RELOC_I51_8_LOW;
+      exp->X_op = O_symbol;
+      break;
+    case O_i51_b2b:
+      reloc = BFD_RELOC_I51_8_B2B;
+      contents = exp->X_md;
+      exp->X_op = O_symbol;
+      exp->X_md = 0;
+      break;
+    default:
+      break;
+    }
+
+  /* A constant target is written in place too, so that the object
+     disassembles to it; the linker writes the field again.  */
+  if (field == I51_PAGE)
+    contents = i51_addr11_insn (opcode, (exp->X_op == O_constant
+					 ? exp->X_add_number : 0));
+  md_number_to_chars (f, contents, size);
+
+  fixp = fix_new_exp (frag_now, f - frag_now->fr_literal, size, exp,
+		      field == I51_REL, reloc);
+  if (reloc == BFD_RELOC_I51_8_DIR && exp->X_op == O_symbol)
+    fixp->tc_fix_data = exp->X_add_symbol;
+}
+
+/* Assemble the row OPC with its operands.  The fields follow the opcode
+   byte in operand order, except that MOV direct,direct puts its source
+   first; a register is in the opcode byte.  */
+
+static void
+i51_emit (const struct i51_opcode *opc, struct i51_operand *ops, int nops)
+{
+  unsigned int bin = opc->bin;
+  int i;
+
+  for (i = 0; i < nops; i++)
+    if (opc->args[i] == 'R')
+      bin |= ops[i].reg & 7;
+    else if (opc->args[i] == 'I')
+      bin |= ops[i].reg & 1;
+
+  if (opc->args[0] == '1')
+    {
+      i51_emit_field (&ops[0].exp, I51_PAGE, bin);
+      return;
+    }
+
+  md_number_to_chars (frag_more (1), bin, 1);
+  if (strcmp (opc->args, "DDN") == 0)
+    {
+      i51_emit_field (&ops[1].exp, I51_DIRECT, 0);
+      i51_emit_field (&ops[0].exp, I51_DIRECT, 0);
+      return;
+    }
+  for (i = 0; i < nops; i++)
+    switch (opc->args[i])
+      {
+      case 'D':
+	i51_emit_field (&ops[i].exp, I51_DIRECT, 0);
+	break;
+      case '#':
+	i51_emit_field (&ops[i].exp,
+			opc->args[0] == 'P' ? I51_DATA16 : I51_IMMEDIATE, 0);
+	break;
+      case 'B':
+      case '/':
+	i51_emit_field (&ops[i].exp, I51_BIT, 0);
+	break;
+      case 'J':
+	i51_emit_field (&ops[i].exp, I51_REL, 0);
+	break;
+      case '6':
+	i51_emit_field (&ops[i].exp, I51_CODE16, 0);
+	break;
+      default:
+	break;
+      }
+}
+
+static void
+i51_assemble (char *str)
+{
+  struct i51_operand ops[I51_MAX_OPERANDS];
+  const struct i51_opcode *opc;
+  const char *alias;
+  char name[I51_MNEMONIC_MAX + 1];
+  size_t len, i;
+  int nops = 0;
+  int op;
+
+  memset (ops, 0, sizeof (ops));
+  str = skip_space (str);
+  for (len = 0; is_part_of_name (str[len]); len++)
+    ;
+  if (len == 0)
+    {
+      as_bad (_("can't find opcode"));
+      return;
+    }
+  if (len > I51_MNEMONIC_MAX)
+    {
+      as_bad (_("unknown opcode `%.*s'"), (int) len, str);
+      return;
+    }
+  for (i = 0; i < len; i++)
+    name[i] = TOLOWER ((unsigned char) str[i]);
+  name[len] = 0;
+
+  input_line_pointer = skip_space (str + len);
+  if (!is_end_of_stmt (*input_line_pointer))
+    for (;;)
+      {
+	if (nops == I51_MAX_OPERANDS)
+	  {
+	    as_bad (_("too many operands"));
+	    return;
+	  }
+	if (!i51_parse_operand (&ops[nops++]))
+	  return;
+	SKIP_WHITESPACE ();
+	if (*input_line_pointer != ',')
+	  break;
+	++input_line_pointer;
+      }
+  if (!is_end_of_stmt (*input_line_pointer))
+    {
+      as_bad (_("junk at end of line, first unrecognized character is `%c'"),
+	      *input_line_pointer);
+      return;
+    }
+
+  alias = i51_alias (name);
+  opc = i51_find_row (name, ops, nops);
+  if (opc == NULL && alias != NULL)
+    opc = i51_find_row (alias, ops, nops);
+  if (opc == NULL)
+    {
+      if (str_hash_find (i51_opcode_hash, name) == NULL && alias == NULL)
+	{
+	  as_bad (_("unknown opcode `%s'"), name);
+	  return;
+	}
+      /* HIGH () or LOW () where the row wants a code or bit address.  */
+      for (op = 0; op < nops; op++)
+	if (ops[op].exp.X_op == O_i51_high || ops[op].exp.X_op == O_i51_low)
+	  {
+	    ops[op].cls = 'E';
+	    if (i51_find_row (name, ops, nops) != NULL
+		|| (alias != NULL && i51_find_row (alias, ops, nops) != NULL))
+	      {
+		as_bad (_("HIGH() and LOW() name a byte, and are not allowed "
+			  "on a code or bit address"));
+		return;
+	      }
+	    ops[op].cls = 'D';
+	  }
+      as_bad (_("invalid instruction operands"));
+      return;
+    }
+
+  i51_emit (opc, ops, nops);
+  dwarf2_emit_insn (opc->size);
+}
+
+void
+md_assemble (char *str)
+{
+  char *saved = input_line_pointer;
+
+  if (seg_info (now_seg)->bss)
+    {
+      as_bad (_("an instruction in %s, which has no contents"),
+	      segment_name (now_seg));
+      return;
+    }
+  i51_assemble (str);
+  input_line_pointer = saved;
+}
+
+/* Fixups.  */
+
+valueT
+md_section_align (asection *seg, valueT addr)
+{
+  int align = bfd_section_alignment (seg);
+
+  return (addr + ((valueT) 1 << align) - 1) & -((valueT) 1 << align);
+}
+
+/* A relative branch is measured from the following instruction, which
+   starts right after the displacement byte.  */
+
+long
+md_pcrel_from_section (fixS *fixp, segT sec)
+{
+  if (fixp->fx_addsy != NULL
+      && (!S_IS_DEFINED (fixp->fx_addsy)
+	  || S_GET_SEGMENT (fixp->fx_addsy) != sec))
+    return 0;
+  return fixp->fx_frag->fr_address + fixp->fx_where + 1;
+}
+
+/* A direct operand cannot reach RAM at 0x80 or above, which is the
+   special function register page to a direct address.  A symbol the
+   assembler places has its offset in its own space here, a lower bound
+   on its address.  */
+
+/* Whether SEC is a section of internal RAM.  A symbol of another space
+   is the linker's to refuse, with the space named.  */
+
+static bool
+i51_internal_ram (segT sec)
+{
+  static const char *const ram[] =
+  {
+    ".data", ".bss", ".rdata", ".rbss", ".bdata", ".bbss", ".idata", ".ibss"
+  };
+  const char *name = segment_name (sec);
+  size_t i;
+
+  for (i = 0; i < ARRAY_SIZE (ram); i++)
+    {
+      size_t len = strlen (ram[i]);
+
+      if (strncmp (name, ram[i], len) == 0
+	  && (name[len] == 0 || name[len] == '.'))
+	return true;
+    }
+  return false;
+}
+
+static void
+i51_check_direct (fixS *fixp, offsetT value)
+{
+  symbolS *sym = fixp->tc_fix_data;
+  offsetT addr;
+
+  if (sym == NULL
+      || !S_IS_DEFINED (sym)
+      || S_IS_COMMON (sym)
+      || !i51_internal_ram (S_GET_SEGMENT (sym)))
+    return;
+
+  addr = (fixp->fx_addsy != NULL
+	  ? (offsetT) S_GET_VALUE (fixp->fx_addsy) + (offsetT) fixp->fx_offset
+	  : value);
+  if (addr >= 0x80)
+    as_bad_where (fixp->fx_file, fixp->fx_line,
+		  _("`%s' is at 0x%llx, which a direct address cannot reach: "
+		    "0x80 and above is the special function register page, "
+		    "and RAM there is reachable only through @R0/@R1"),
+		  S_GET_NAME (sym), (unsigned long long) addr);
+}
+
+/* Refuse VALUE outside the range of the field FIXP fills.  */
+
+static void
+i51_check_range (fixS *fixp, offsetT value)
+{
+  size_t i;
+
+  for (i = 0; i < ARRAY_SIZE (i51_ranges); i++)
+    if (i51_ranges[i].reloc == fixp->fx_r_type)
+      {
+	if (value < i51_ranges[i].lo || value > i51_ranges[i].hi)
+	  as_bad_where (fixp->fx_file, fixp->fx_line,
+			_("%s out of range: %lld"), _(i51_ranges[i].what),
+			(long long) value);
+	return;
+      }
+}
+
+void
+md_apply_fix (fixS *fixp, valueT *valuep, segT seg)
+{
+  bfd_byte *where = (bfd_byte *) fixp->fx_frag->fr_literal + fixp->fx_where;
+  offsetT value = *valuep;
+  long bit;
+
+
+  /* Final here: a fixup with no symbol left on it, other than an
+     ACALL/AJMP target, whose page is only known once the code is placed;
+     and a branch to a strong symbol of this section.  A branch to a weak
+     symbol, to an absolute address or to another section is the
+     linker's.  */
+  if (fixp->fx_addsy == NULL && fixp->fx_subsy == NULL && !fixp->fx_pcrel
+      && fixp->fx_r_type != BFD_RELOC_I51_11)
+    fixp->fx_done = 1;
+  else if (fixp->fx_pcrel && fixp->fx_addsy != NULL && fixp->fx_subsy == NULL
+	   && S_GET_SEGMENT (fixp->fx_addsy) == seg
+	   && S_IS_DEFINED (fixp->fx_addsy) && !S_IS_WEAK (fixp->fx_addsy))
+    fixp->fx_done = 1;
+
+  /* i51_check_range () states the rule of an operand field, which the
+     width test in write.c cannot.  A datum is left to that test when its
+     value is known here, and to the linker when it is not: its addend
+     alone is not the value.  */
+  fixp->fx_no_overflow = (!fixp->fx_done
+			  || (fixp->fx_r_type != BFD_RELOC_8
+			      && fixp->fx_r_type != BFD_RELOC_16
+			      && fixp->fx_r_type != BFD_RELOC_32));
+
+  if (fixp->fx_subsy != NULL)
+    as_bad_subtract (fixp);
+
+  i51_check_direct (fixp, value);
+
+  if (!fixp->fx_done)
+    {
+      /* A constant ACALL/AJMP target is checked here; a branch to an
+	 absolute address gets the displacement it has if the section
+	 starts at zero written in place, for the disassembly of the
+	 object.  */
+      if (fixp->fx_r_type == BFD_RELOC_I51_11 && fixp->fx_addsy == NULL)
+	i51_check_range (fixp, value);
+      if (fixp->fx_r_type == BFD_RELOC_I51_7_PCREL
+	  && fixp->fx_addsy != NULL
+	  && S_GET_SEGMENT (fixp->fx_addsy) == absolute_section
+	  && value >= -128 && value <= 127)
+	where[0] = value & 0xff;
+      fixp->fx_addnumber = value;
+      return;
+    }
+
+  i51_check_range (fixp, value);
+  switch (fixp->fx_r_type)
+    {
+    case BFD_RELOC_I51_8_HIGH:
+      where[0] = (value >> 8) & 0xff;
+      break;
+
+    case BFD_RELOC_8:
+    case BFD_RELOC_I51_8_LOW:
+    case BFD_RELOC_I51_8_IMM:
+    case BFD_RELOC_I51_8_DIR:
+    case BFD_RELOC_I51_8_BIT:
+    case BFD_RELOC_I51_7_PCREL:
+      where[0] = value & 0xff;
+      break;
+
+    case BFD_RELOC_16:
+    case BFD_RELOC_I51_16_CODE:
+      bfd_putb16 (value, where);
+      break;
+
+    case BFD_RELOC_32:
+      bfd_putb32 (value, where);
+      break;
+
+    case BFD_RELOC_I51_8_B2B:
+      /* The byte holds the bit number inside the byte VALUE names.  */
+      bit = i51_bit_address (value, where[0]);
+      if (where[0] > 7)
+	as_bad_where (fixp->fx_file, fixp->fx_line,
+		      _("bit number %d of B2B() is not 0..7"), where[0]);
+      else if (bit < 0)
+	as_bad_where (fixp->fx_file, fixp->fx_line,
+		      _("B2B(%#llx,%d): %#llx is not bit addressable"),
+		      (unsigned long long) value, where[0],
+		      (unsigned long long) value);
+      where[0] = bit < 0 ? 0 : bit;
+      break;
+
+    case BFD_RELOC_I51_13_PCODE:
+      if (value > I51_PCODE_ADDR_MASK)
+	as_bad_where (fixp->fx_file, fixp->fx_line,
+		      _("pcode exec address out of 13-bit range: %#llx"),
+		      (unsigned long long) value);
+      else if (value < I51_PCODE_ADDR_MIN)
+	as_bad_where (fixp->fx_file, fixp->fx_line,
+		      _("pcode exec address underflow: %#llx"),
+		      (unsigned long long) value);
+      bfd_putb16 ((bfd_getb16 (where) & I51_PCODE_FLAGS_MASK)
+		  | (value & I51_PCODE_ADDR_MASK), where);
+      break;
+
+    default:
+      as_fatal (_("line %d: unknown relocation type: 0x%x"),
+		fixp->fx_line, fixp->fx_r_type);
+      break;
+    }
+}
+
+arelent *
+tc_gen_reloc (asection *seg ATTRIBUTE_UNUSED, fixS *fixp)
+{
+  arelent *reloc = XNEW (arelent);
+
+  reloc->sym_ptr_ptr = XNEW (asymbol *);
+  *reloc->sym_ptr_ptr = symbol_get_bfdsym (fixp->fx_addsy);
+  reloc->address = fixp->fx_frag->fr_address + fixp->fx_where;
+  reloc->howto = bfd_reloc_type_lookup (stdoutput, fixp->fx_r_type);
+  if (reloc->howto == NULL)
+    {
+      as_bad_where (fixp->fx_file, fixp->fx_line,
+		    _("reloc %d not supported by object file format"),
+		    (int) fixp->fx_r_type);
+      return NULL;
+    }
+  /* A displacement is measured from the byte after it.  */
+  reloc->addend = fixp->fx_offset - (fixp->fx_pcrel ? 1 : 0);
+  return reloc;
+}
+
+/* TC_CONS_FIX_NEW: the fixup of a datum.  HIGH (), LOW () and B2B () name
+   one byte.  */
+
+void
+i51_cons_fix_new (fragS *frag, int where, int nbytes, expressionS *exp,
+		  bfd_reloc_code_real_type reloc ATTRIBUTE_UNUSED)
+{
+  switch (exp->X_op)
+    {
+    case O_i51_high:
+    case O_i51_low:
+    case O_i51_b2b:
+      if (nbytes != 1)
+	{
+	  as_bad (_("HIGH(), LOW() and B2B() need a one byte operand"));
+	  return;
+	}
+      reloc = (exp->X_op == O_i51_high ? BFD_RELOC_I51_8_HIGH
+	       : exp->X_op == O_i51_low ? BFD_RELOC_I51_8_LOW
+	       : BFD_RELOC_I51_8_B2B);
+      if (exp->X_op == O_i51_b2b)
+	frag->fr_literal[where] = exp->X_md;
+      exp->X_op = O_symbol;
+      exp->X_md = 0;
+      break;
+    default:
+      switch (nbytes)
+	{
+	case 1:
+	  reloc = BFD_RELOC_8;
+	  break;
+	case 2:
+	  reloc = BFD_RELOC_16;
+	  break;
+	case 4:
+	  reloc = BFD_RELOC_32;
+	  break;
+	default:
+	  as_bad (_("cannot relocate %d bytes of data"), nbytes);
+	  return;
+	}
+      break;
+    }
+
+  fix_new_exp (frag, where, nbytes, exp, false, reloc);
+}
+
+const char *
+md_atof (int type, char *litp, int *sizep)
+{
+  return ieee_md_atof (type, litp, sizep, target_big_endian);
+}
+
+symbolS *
+md_undefined_symbol (char *name ATTRIBUTE_UNUSED)
+{
+  return NULL;
+}
+
+/* Directives.  */
+
+/* .bit VALUES: one byte per bit, each 0 or 1.  */
+
+static void
+i51_bit (int ignore ATTRIBUTE_UNUSED)
+{
+  expressionS exp;
+
+  if (is_it_end_of_statement ())
+    {
+      demand_empty_rest_of_line ();
+      return;
+    }
+
+  do
+    {
+      expression (&exp);
+      if (exp.X_op != O_constant
+	  || exp.X_add_number < 0 || exp.X_add_number > 1)
+	{
+	  as_bad (_("a bit value is a constant 0 or 1"));
+	  ignore_rest_of_line ();
+	  return;
+	}
+      emit_expr (&exp, 1);
+    }
+  while (*input_line_pointer++ == ',');
+
+  input_line_pointer--;
+  demand_empty_rest_of_line ();
+}
+
+/* .using BANK: the register bank AR0..AR7 name the registers of.  */
+
+static void
+i51_using (int ignore ATTRIBUTE_UNUSED)
+{
+  offsetT bank = get_absolute_expression ();
+
+  if (bank < 0 || bank > 3)
+    {
+      as_bad (_("expected a register bank number 0, 1, 2 or 3"));
+      ignore_rest_of_line ();
+      return;
+    }
+  i51_regbank = bank;
+  if (i51_regbank > i51_regbank_max)
+    i51_regbank_max = i51_regbank;
+  demand_empty_rest_of_line ();
+}
+
+/* md_cleanup, at the end of each input file: .using does not carry into
+   the next.  */
+
+void
+i51_cleanup (void)
+{
+  i51_regbank = -1;
+}
+
+/* md_finish: the common __RB__ reserves the register banks up to the
+   highest one any .using of the assembly selected.  */
+
+void
+i51_finish (void)
+{
+  symbolS *sym;
+
+  if (i51_regbank_max < 0)
+    return;
+  sym = symbol_find ("__RB__");
+  if (sym != NULL && (S_IS_DEFINED (sym) || S_IS_COMMON (sym)))
+    return;
+  sym = symbol_find_or_make ("__RB__");
+  i51_rb_symbol = sym;
+  S_SET_VALUE (sym, (valueT) (i51_regbank_max + 1) * 8);
+  S_SET_ALIGN (sym, 1);
+  S_SET_EXTERNAL (sym);
+  S_SET_SEGMENT (sym, i51_common_section (".regbank"));
+}
+
+/* The section of SPACE, made on first use.  A file may have made a
+   section of that name with .section already: its flags are then left as
+   they are, the way obj-elf.c leaves a section it did not create.  */
+
+static segT
+i51_space_section (int space)
+{
+  const char *name = i51_spaces[space].name;
+  bool fresh;
+
+  if (space == I51_BSS)
+    return bss_section;
+  if (i51_space_segs[space] != NULL)
+    return i51_space_segs[space];
+
+  /* subseg_new () makes the section current; the caller decides that.  */
+  fresh = bfd_get_section_by_name (stdoutput, name) == NULL;
+  i51_space_segs[space] = subseg_get (name, 0);
+  if (fresh)
+    {
+      flagword keep = i51_spaces[space].keep;
+
+      bfd_set_section_flags (i51_space_segs[space],
+			     bfd_applicable_section_flags (stdoutput) & keep);
+      if ((keep & SEC_LOAD) == 0)
+	seg_info (i51_space_segs[space])->bss = 1;
+    }
+  return i51_space_segs[space];
+}
+
+/* .rbss, .xdata and the other memory-space directives.  */
+
+static void
+i51_space (int space)
+{
+  segT sec = i51_space_section (space);
+
+  obj_elf_section_change_hook ();
+  subseg_set (sec, (subsegT) get_absolute_expression ());
+  demand_empty_rest_of_line ();
+}
+
+/* The rest of a common directive of SPACE after the name and the size,
+   for s_comm_internal ().  A name is a common of one space only.  */
+
+static symbolS *
+i51_common_parse (int space, symbolS *symbolP, addressT size)
+{
+  asection *com = i51_common_section (i51_spaces[space].name);
+  int is_local = symbol_get_obj (symbolP)->local;
+  addressT align = 0;
+
+  if (strcmp (S_GET_NAME (symbolP), "__RB__") == 0)
+    {
+      as_bad (_("`__RB__' is the register-bank common of .using and cannot "
+		"be defined"));
+      i51_rb_reported = true;
+      ignore_rest_of_line ();
+      return NULL;
+    }
+  if (S_IS_COMMON (symbolP) && S_GET_SEGMENT (symbolP) != com)
+    {
+      as_bad (_("`%s' is already a common of another memory space"),
+	      S_GET_NAME (symbolP));
+      ignore_rest_of_line ();
+      return NULL;
+    }
+  if (space == I51_BSS)
+    {
+      /* With no alignment, bfd would align to the size, up to 16: a byte
+	 is aligned to a byte here.  */
+      symbolP = elf_common_parse (0, symbolP, size);
+      if (symbolP != NULL && !is_local && S_GET_ALIGN (symbolP) == 0)
+	S_SET_ALIGN (symbolP, 1);
+      return symbolP;
+    }
+
+  if (*input_line_pointer == ',')
+    {
+      align = parse_align (1);
+      if (align == (addressT) -1)
+	return NULL;
+      if (align > 16)
+	{
+	  as_bad (_("alignment too large: 0x10000 is the most"));
+	  ignore_rest_of_line ();
+	  return NULL;
+	}
+    }
+
+  if (str_hash_find (i51_common_decls, S_GET_NAME (symbolP)) == NULL)
+    {
+      struct i51_common_decl *decl = XNEW (struct i51_common_decl);
+
+      decl->file = as_where (&decl->line);
+      decl->space = space;
+      str_hash_insert (i51_common_decls, S_GET_NAME (symbolP), decl, 0);
+    }
+
+  if (is_local)
+    {
+      bss_alloc_section (symbolP, size, align, i51_space_section (space));
+      S_CLEAR_EXTERNAL (symbolP);
+    }
+  else
+    {
+      S_SET_VALUE (symbolP, size);
+      S_SET_ALIGN (symbolP, (addressT) 1 << align);
+      S_SET_EXTERNAL (symbolP);
+      S_SET_SEGMENT (symbolP, com);
+    }
+  symbol_get_bfdsym (symbolP)->flags |= BSF_OBJECT;
+  return symbolP;
+}
+
+/* Refuse a memory-space common that a directive other than the common
+   directives - .lcomm, .tls_common, a label - placed elsewhere.  */
+
+static void
+i51_check_common (symbolS *sym)
+{
+  struct i51_common_decl *decl;
+  int space;
+
+  decl = str_hash_find (i51_common_decls, S_GET_NAME (sym));
+  if (decl == NULL)
+    return;
+  space = decl->space;
+  if (S_GET_SEGMENT (sym) != i51_common_section (i51_spaces[space].name)
+      && S_GET_SEGMENT (sym) != i51_space_segs[space])
+    as_bad_where (decl->file, decl->line,
+		  _("`%s' is declared a common of %s here and placed "
+		    "elsewhere"), S_GET_NAME (sym), i51_spaces[space].name);
+}
+
+/* .rcomm, .xcomm and the rest, and .comm too, so that a name cannot be
+   a common of two spaces.  */
+
+static void
+i51_common (int space)
+{
+  s_comm_internal (space, i51_common_parse);
+}
+
+/* .pcode ADDRESS [OPERAND[, OPERAND[, OPERAND]]]: an entry of the
+   byte-coded call format.  Each operand has an allocation and an indirect
+   flag, the first and last a swap flag too; a zero byte of a constant
+   operand is left out and its allocation flag clear.  */
+
+#define I51_PCODE_HI		0x80	/* the high byte is stored */
+#define I51_PCODE_LO		0x40	/* the low byte is stored */
+#define I51_PCODE_SWAP		0x02	/* swapped */
+#define I51_PCODE_INDIRECT	0x8000	/* indirect */
+
+enum pcode_mode
+{
+  PCODE_DIRECTWORD,
+  PCODE_DIRECTBYTE,
+  PCODE_DIRECTSWAP,
+  PCODE_DIRECTSHL8,
+  PCODE_INDIRECTWORD,
+  PCODE_INDIRECTBYTE,
+  PCODE_INDIRECTSWAP
+};
+
+/* Match pcode keyword KW at input_line_pointer, ignoring case, and step
+   over it.  A keyword ending in a name character has to end there.  */
+
+static bool
+pcode_keyword (const char *kw)
+{
+  size_t len = strlen (kw);
+  size_t i;
+
+  for (i = 0; i < len; i++)
+    if (TOUPPER ((unsigned char) input_line_pointer[i]) != kw[i])
+      return false;
+  if (is_part_of_name (kw[len - 1])
+      && is_part_of_name (input_line_pointer[len]))
+    return false;
+  /* A bare keyword is a symbol of the program when one has its name, and
+     one made later is refused.  */
+  if (ISALPHA (kw[0]))
+    {
+      if (i51_user_symbol (input_line_pointer, len))
+	return false;
+      i51_note_use (kw, false);
+    }
+  input_line_pointer += len;
+  return true;
+}
+
+/* Parse one operand into EX and *MODE; SEPARATOR says whether a comma
+   comes first.  An absent operand is a zero byte the entry leaves out.  */
+
+static bool
+pcode_operand (expressionS *ex, enum pcode_mode *mode, bool separator)
+{
+  static const struct
+  {
+    const char *kw;
+    enum pcode_mode mode;
+  } keywords[] =
+  {
+    { "#BYTE", PCODE_DIRECTBYTE },   { "#SWAP", PCODE_DIRECTSWAP },
+    { "#SHL8", PCODE_DIRECTSHL8 },   { "#WORD", PCODE_DIRECTWORD },
+    { "BYTE",  PCODE_DIRECTBYTE },   { "SWAP",  PCODE_DIRECTSWAP },
+    { "SHL8",  PCODE_DIRECTSHL8 },   { "WORD",  PCODE_DIRECTWORD },
+    { "@BYTE", PCODE_INDIRECTBYTE }, { "@SWAP", PCODE_INDIRECTSWAP },
+    { "@WORD", PCODE_INDIRECTWORD },
+    { "#",     PCODE_DIRECTWORD },   { "@",     PCODE_INDIRECTWORD },
+  };
+  size_t i;
+
+  memset (ex, 0, sizeof (*ex));
+  SKIP_WHITESPACE ();
+  if (is_end_of_stmt (*input_line_pointer))
+    {
+      ex->X_op = O_constant;
+      *mode = PCODE_DIRECTBYTE;
+      return true;
+    }
+
+  if (separator)
+    {
+      if (*input_line_pointer != ',')
+	{
+	  as_bad (_("expected comma after pcode operand"));
+	  return false;
+	}
+      input_line_pointer++;
+      SKIP_WHITESPACE ();
+    }
+  else if (*input_line_pointer == ',')
+    {
+      as_bad (_("the pcode address is separated from its first operand "
+		"by white space, not a comma"));
+      return false;
+    }
+
+  *mode = PCODE_DIRECTWORD;
+  for (i = 0; i < ARRAY_SIZE (keywords); i++)
+    if (pcode_keyword (keywords[i].kw))
+      {
+	*mode = keywords[i].mode;
+	break;
+      }
+  SKIP_WHITESPACE ();
+  expression (ex);
+  if (ex->X_op == O_absent)
+    {
+      as_bad (_("missing pcode operand"));
+      return false;
+    }
+  return true;
+}
+
+/* Whether a constant byte operand V stored as V + ADJUST is put: a zero
+   one is left out.  */
+
+static bool
+pcode_byte_present (offsetT v, offsetT adjust)
+{
+  return (v & 0xff) != 0 || (v != 0 && (((valueT) v + adjust) & 0xff) != 0);
+}
+
+/* Put a byte operand, left out when it is a zero constant.  ADJUST is
+   added to the value; a constant whose low byte is zero but whose stored
+   byte is not is put too.  */
+
+static void
+pcode_byte (expressionS *ex, offsetT adjust)
+{
+  char *f;
+
+  if (ex->X_op == O_constant)
+    {
+      if (pcode_byte_present (ex->X_add_number, adjust))
+	md_number_to_chars (frag_more (1),
+			    ((valueT) ex->X_add_number + adjust) & 0xff, 1);
+      return;
+    }
+  f = frag_more (1);
+  md_number_to_chars (f, 0, 1);
+  ex->X_add_number += adjust;
+  fix_new_exp (frag_now, f - frag_now->fr_literal, 1, ex, false, BFD_RELOC_8);
+}
+
+/* Put a word operand, high byte first or, SWAPPED, low byte first.  A
+   zero byte of a constant is left out.  */
+
+static void
+pcode_word (expressionS *ex, bool swapped)
+{
+  char *f;
+
+  if (ex->X_op == O_constant)
+    {
+      unsigned int hi = (ex->X_add_number >> 8) & 0xff;
+      unsigned int lo = ex->X_add_number & 0xff;
+      unsigned int first = swapped ? lo : hi;
+      unsigned int second = swapped ? hi : lo;
+
+      if (first != 0)
+	md_number_to_chars (frag_more (1), first, 1);
+      if (second != 0)
+	md_number_to_chars (frag_more (1), second, 1);
+      return;
+    }
+
+  f = frag_more (2);
+  md_number_to_chars (f, 0, 2);
+  if (!swapped)
+    fix_new_exp (frag_now, f - frag_now->fr_literal, 2, ex, false,
+		 BFD_RELOC_16);
+  else
+    {
+      fix_new_exp (frag_now, f - frag_now->fr_literal, 1, ex, false,
+		   BFD_RELOC_I51_8_LOW);
+      fix_new_exp (frag_now, f + 1 - frag_now->fr_literal, 1, ex, false,
+		   BFD_RELOC_I51_8_HIGH);
+    }
+}
+
+static void
+pcode_write_operand (expressionS *ex, enum pcode_mode mode)
+{
+  switch (mode)
+    {
+    case PCODE_DIRECTBYTE:
+    case PCODE_DIRECTSHL8:
+    case PCODE_INDIRECTWORD:
+    case PCODE_INDIRECTSWAP:
+      pcode_byte (ex, 0);
+      break;
+    case PCODE_INDIRECTBYTE:
+      /* Stored decremented by one, through the addend for a symbol.  */
+      pcode_byte (ex, -1);
+      break;
+    case PCODE_DIRECTWORD:
+      pcode_word (ex, false);
+      break;
+    case PCODE_DIRECTSWAP:
+      pcode_word (ex, true);
+      break;
+    }
+}
+
+/* The allocation, swap and indirect flags of one operand.  A constant
+   is checked as the fixup of a symbol would check the value stored.  */
+
+static unsigned int
+pcode_flags (expressionS *ex, enum pcode_mode mode, bool swapable)
+{
+  bool constant = ex->X_op == O_constant;
+  offsetT v = ex->X_add_number;
+  offsetT stored = mode == PCODE_INDIRECTBYTE ? (offsetT) ((valueT) v - 1) : v;
+  bool word = mode == PCODE_DIRECTWORD || mode == PCODE_DIRECTSWAP;
+  unsigned int flags = 0;
+
+  if (constant && (mode == PCODE_DIRECTSWAP ? stored < -32768 || stored > 65535
+		   : word ? stored < -65535 || stored > 65535
+		   : stored < -255 || stored > 255))
+    as_bad (_("pcode operand out of range: %ld"), (long) v);
+  if (!swapable && (mode == PCODE_DIRECTSWAP || mode == PCODE_INDIRECTSWAP))
+    as_bad (_("this pcode operand cannot be swapped"));
+
+  switch (mode)
+    {
+    case PCODE_DIRECTBYTE:
+    case PCODE_INDIRECTWORD:
+    case PCODE_INDIRECTBYTE:
+    case PCODE_INDIRECTSWAP:
+      if (!constant || pcode_byte_present (v, stored - v))
+	flags |= I51_PCODE_LO;
+      break;
+    case PCODE_DIRECTSHL8:
+      if (!constant || (v & 0xff) != 0)
+	flags |= I51_PCODE_HI;
+      break;
+    case PCODE_DIRECTWORD:
+      if (!constant || (v & 0xff00) != 0)
+	flags |= I51_PCODE_HI;
+      if (!constant || (v & 0x00ff) != 0)
+	flags |= I51_PCODE_LO;
+      break;
+    case PCODE_DIRECTSWAP:
+      if (!constant || (v & 0x00ff) != 0)
+	flags |= I51_PCODE_HI;
+      if (!constant || (v & 0xff00) != 0)
+	flags |= I51_PCODE_LO;
+      break;
+    }
+  if (mode == PCODE_DIRECTSWAP || mode == PCODE_INDIRECTSWAP)
+    flags |= I51_PCODE_SWAP;
+  if (mode == PCODE_INDIRECTWORD || mode == PCODE_INDIRECTBYTE
+      || mode == PCODE_INDIRECTSWAP)
+    flags |= I51_PCODE_INDIRECT;
+  return flags;
+}
+
+/* Whether the text from START to END is the name of HIGH, LOW or B2B.  */
+
+static bool
+i51_operator_name (const char *start, const char *end)
+{
+  static const char *const names[] = { "HIGH", "LOW", "B2B" };
+  size_t i;
+
+  for (i = 0; i < ARRAY_SIZE (names); i++)
+    if ((size_t) (end - start) == strlen (names[i])
+	&& strncasecmp (start, names[i], end - start) == 0)
+      return true;
+  return false;
+}
+
+static void
+i51_pcode (int ignore ATTRIBUTE_UNUSED)
+{
+  expressionS addr, op[3];
+  enum pcode_mode mode[3];
+  unsigned int f0, f1, f2, pflags;
+  char *f, *end, save;
+  int i, depth;
+  int errors = had_errors ();
+
+  /* The address is one term - a number, a name, or an expression in
+     parentheses - so the sign, parenthesis, `#' or `@' of an operand ends
+     it:
+     `.pcode 0x200 -1' has an operand.  */
+  SKIP_WHITESPACE ();
+  end = input_line_pointer;
+  depth = 0;
+  while (!is_end_of_stmt (*end)
+	 && (depth > 0
+	     || (!is_whitespace (*end) && *end != '#' && *end != '@'
+		 && ((*end != '+' && *end != '-' && *end != '(')
+		     || end == input_line_pointer
+		     || (*end == '(' && i51_operator_name (input_line_pointer,
+						       end))))))
+    {
+      if (*end == '(')
+	depth++;
+      else if (*end == ')' && depth > 0 && --depth == 0)
+	{
+	  end++;
+	  break;
+	}
+      end++;
+    }
+  save = *end;
+  *end = 0;
+  expression (&addr);
+  if (addr.X_op == O_absent)
+    as_bad (_("missing pcode address"));
+  else if (*input_line_pointer == ',')
+    as_bad (_("the pcode address is separated from its first operand "
+	      "by white space, not a comma"));
+  else if (input_line_pointer != end && had_errors () == errors)
+    as_bad (_("junk in pcode address: `%s'"), input_line_pointer);
+  *end = save;
+  input_line_pointer = end;
+  if (had_errors () != errors)
+    {
+      ignore_rest_of_line ();
+      return;
+    }
+  for (i = 0; i < 3; i++)
+    if (!pcode_operand (&op[i], &mode[i], i != 0))
+      {
+	ignore_rest_of_line ();
+	return;
+      }
+  demand_empty_rest_of_line ();
+
+  /* The first operand's flags stand where they are; the second's
+     allocation moves two bits right and its indirect flag one, the
+     third's four and two, and its swap flag one.  */
+  f0 = pcode_flags (&op[0], mode[0], true);
+  f1 = pcode_flags (&op[1], mode[1], false);
+  f2 = pcode_flags (&op[2], mode[2], true);
+  pflags = (f0 | ((f1 & (I51_PCODE_HI | I51_PCODE_LO)) >> 2)
+	    | ((f1 & I51_PCODE_INDIRECT) >> 1)
+	    | ((f2 & (I51_PCODE_HI | I51_PCODE_LO)) >> 4)
+	    | ((f2 & I51_PCODE_INDIRECT) >> 2)
+	    | ((f2 & I51_PCODE_SWAP) >> 1));
+
+  f = frag_more (2);
+  md_number_to_chars (f, pflags & I51_PCODE_FLAGS_MASK, 2);
+  fix_new_exp (frag_now, f - frag_now->fr_literal, 2, &addr, false,
+	       BFD_RELOC_I51_13_PCODE);
+
+  md_number_to_chars (frag_more (1), pflags & 0xff, 1);
+  for (i = 0; i < 3; i++)
+    pcode_write_operand (&op[i], mode[i]);
+}
