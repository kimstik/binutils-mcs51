+
+/* Fold a `.bit' suffix on a numeric operand into a bit address.
+
+   Named bits (acc.7) resolve through the operand hash table, but a plain
+   number does not: expression () stops at the dot and leaves `.3' behind.
+   MCS-51 maps a byte address and bit number onto a single bit address -
+   0x20..0x2f are the bit-addressable RAM bytes, and an SFR in 0x80..0xf8 is
+   bit-addressable when its address is a multiple of eight.  */
+
+static void
+i51_fold_bit_suffix (expressionS *exp)
+{
+  valueT addr;
+  int bit;
+
+  if (exp->X_op != O_constant
+      || input_line_pointer[0] != '.'
+      || input_line_pointer[1] < '0' || input_line_pointer[1] > '7')
+    return;
+
+  addr = exp->X_add_number;
+  bit = input_line_pointer[1] - '0';
+
+  /* Step over the `.N' either way.  Leaving it behind on the error path
+     turned one bad bit address into three diagnostics, the last of them
+     against a line number past the end of the file.  */
+  input_line_pointer += 2;
+
+  if (addr >= 0x20 && addr <= 0x2f)
+    exp->X_add_number = (addr - 0x20) * 8 + bit;
+  else if (addr >= 0x80 && addr <= 0xF8 && (addr & 7) == 0)
+    exp->X_add_number = addr + bit;
+  else
+    as_bad (_("0x%lx is not bit addressable"), (unsigned long) addr);
+}
+/* Extract one word from FROM and copy it to TO.  */
+
+static char *
+extract_word (char *from, char *to, int limit)
+{
+  char *op_end;
+  int size = 0;
+
+  /* Drop leading whitespace.  */
+  from = skip_space (from);
+  *to = 0;
+
+  /* Find the op code end.  */
+  for (op_end = from; *op_end != 0 && is_part_of_name (*op_end);)
+    {
+      to[size++] = *op_end++;
+      if (size + 1 >= limit)
+	break;
+    }
+
+  to[size] = 0;
+  return op_end;
+}
+
+/* Extract one word from FROM and copy it to TO.  */
+
+static char *
+extract_op (char *from, char *to, int limit)
+{
+  char *op_end;
+  int size = 0;
+
+  /* Drop leading whitespace.  */
+  from = skip_space (from);
+  *to = 0;
+
+  /* Find the op code end.  */
+  for (op_end = from; *op_end != 0 && *op_end != ',' && *op_end != ' ';)
+    {
+      to[size++] = toupper ((unsigned char) *op_end++);
+      if (size + 1 >= limit)
+	break;
+    }
+
+  to[size] = 0;
+  return op_end;
+}
