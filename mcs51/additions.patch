+void
+md_assemble (char *str)
+{
+  int errors_before = had_errors ();
+
+#ifdef ASMDBG
+  fprintf(stderr, "%s\n",str);
+#endif
+  op_expr1.X_op = O_max;
+  op_expr2.X_op = O_max;
+
+  str = skip_space (extract_word (str, op, sizeof (op)));
+
+  if (!op[0])
+    {
+      as_bad (_("can't find opcode "));
+      return;
+    }
+
+  regno = 0;
+
+  opcode = (struct i51_opcodes_s *) str_hash_find (i51_hash, op);
+
+  if (opcode == NULL)
+    {
+      as_bad (_("unknown opcode `%s'"), op);
+      return;
+    }
+  else 
+    {
+      op1mode = 'N';
+      op2mode = 'N';
+      line = skip_space (str);
+      if (*line != 0)
+	{
+	  if (opcode->args[0] == 'N')
+	    {
+	      as_bad (_("garbage at end of line"));
+	      return;
+	    }
+	  i51_parse_operand1 ();
+	  line = skip_space (line);
+          if ((*line) && (opcode->args[1] == 'N'))
+	    {
+	      as_bad (_("garbage at end of line"));
+	      return;
+	    }
+	  if (*line == ',')
+	    {
+	      line++;
+	      i51_parse_operand2 ();
+	      line = skip_space (line);
+	      if ((*line) && (opcode->args[2] == 'N'))
+		{
+		  as_bad (_("garbage at end of line"));
+		  return;
+		}
+	      if (opcode->args[2] == 'J')
+		{
+		  if (*line == ',')
+		    {
+		      input_line_pointer = line+1;
+		      //PARSE EXPRESION 2
+		      expression (&op_expr2);
+		      line = input_line_pointer;
+		      if (op_expr2.X_op == O_absent)
+			{
+			  as_bad (_("missing operand 3"));
+			  return;
+			}
+		    }
+		  else
+		    {
+		      as_bad (_("missing operand 3"));
+		      return;
+		    }
+		}
+	    }
+	  else if (opcode->args[1] != 'N')
+	    {
+	      as_bad (_("missing operand 2"));
+	      return;
+	    }
+#ifdef ASMDBG
+	  fprintf(stderr, "args: %s reg: %i\n\n", opcode->args, regno);
+#endif
+            input_line_pointer = line;
+	}
+      else
+	{
+	  if (opcode->args[0] != 'N')
+	    {
+	      as_bad (_("missing operand 1"));
+	      return;
+	    }
+	}
+      /* i51_parse_operand1 / 2 report their own errors and return with the
+	 operand expressions left as they found them - op_expr1 and op_expr2
+	 still carry the O_max marker set above.  Handing one of those to
+	 i51_build_ins reaches fix_new_exp with an expression gas cannot
+	 make a symbol out of, and gas dies with an internal error instead
+	 of the diagnostic already printed.  Emit nothing once the line has
+	 gone wrong.  */
+      if (had_errors () != errors_before)
+	return;
+
+      if ((op1mode == opcode->args[0]) && (op2mode == opcode->args[1]))
+	{
+	  i51_build_ins (opcode, regno, &op_expr1, &op_expr2);
+	}
+      else
+	{
+#ifdef ASMDBG
+	  fprintf(stderr,"invalid instruction operands %c/%c %c/%c", op1mode, opcode->args[0], op2mode, opcode->args[1]);
+#endif
+	  as_bad (_("invalid instruction operands"));
+	  return;
+	}
+    }
+}
+
+/* GAS will call this function for each section at the end of the assembly,
+   to permit the CPU backend to adjust the alignment of a section.  */
+
+valueT
+md_section_align (asection *seg, valueT addr)
+{
+  int align = bfd_section_alignment (seg);
+  return ((addr + ((valueT) 1 << align) - 1) & -((valueT) 1 << align));
+}
+
+/* If you define this macro, it should return the offset between the
+   address of a PC relative fixup and the position from which the PC
+   relative adjustment should be made.  On many processors, the base
+   of a PC relative instruction is the next instruction, so this
+   macro would return the length of an instruction.  */
+
+long
+md_pcrel_from_section (fixS *fixp, segT sec)
+{
+  if (fixp->fx_addsy != (symbolS *) NULL
+      && (!S_IS_DEFINED (fixp->fx_addsy)
+	  || (S_GET_SEGMENT (fixp->fx_addsy) != sec)))
+    return 0;
+  return fixp->fx_frag->fr_address + fixp->fx_where + 1;
+}
+
+/* GAS will call this for each fixup.  It should store the correct
+   value in the object file.  */
+
+void
+md_apply_fix (fixS *fixp, valueT *valuep, segT seg)
+{
+  bfd_byte *where;
+  unsigned long insn;
+  long value;
+
+  if (fixp->fx_addsy == (symbolS *) NULL)
+    {
+      value = *valuep;
+      fixp->fx_done = 1;
+    }
+  else if (fixp->fx_pcrel)
+    {
+      segT s = S_GET_SEGMENT (fixp->fx_addsy);
+
+      /* fixup_segment () has already added whatever part of the symbol
+	 value it was willing to fold and subtracted the address the
+	 displacement is measured from, so *VALUEP is the finished
+	 displacement.  Adding the symbol value again counted it twice for
+	 a symbol defined in this section that still carries a relocation -
+	 a global, which gas leaves on the fixup because the linker may
+	 override it - and put every branch to such a label out by the
+	 label's own address.  A local label is folded away before this
+	 point and arrives with no symbol at all.  */
+      value = *valuep;
+
+      /* A target in this section or in the absolute section is final
+	 here; anything else has to reach the linker.  */
+      if (s == seg || s == absolute_section)
+	fixp->fx_done = 1;
+    }
+  else
+    {
+      value = fixp->fx_offset;
+
+      if (fixp->fx_subsy != (symbolS *) NULL)
+	{
+	  if (S_GET_SEGMENT (fixp->fx_subsy) == absolute_section)
+	    {
+	      value -= S_GET_VALUE (fixp->fx_subsy);
+	      fixp->fx_done = 1;
+	    }
+	  else
+	    {
+	      /* We don't actually support subtracting a symbol.  */
+	      as_bad_where (fixp->fx_file, fixp->fx_line,
+			    _("expression too complex"));
+	    }
+	}
+    }
+
+  switch (fixp->fx_r_type)
+    {
+    default:
+      fixp->fx_no_overflow = 1;
+      break;
+    }
+
+  if (fixp->fx_done)
+    {
+      /* Fetch the instruction, insert the fully resolved operand
+	 value, and stuff the instruction back again.  */
+      where = (bfd_byte *) fixp->fx_frag->fr_literal + fixp->fx_where;
+
+      switch (fixp->fx_r_type)
+	{
+	case BFD_RELOC_I51_8_LOW:
+	  ((bfd_byte *) where)[0] = (bfd_byte) (value & 0xFF);
+	  break;
+
+	case BFD_RELOC_I51_8_HIGH:
+	  if (value < -65536 || value > 65535)
+	    as_bad_where (fixp->fx_file, fixp->fx_line,
+			  _("operand out of range: %ld"), value);
+	  value >>= 8;
+	  /* Fall through.  */
+
+	case BFD_RELOC_8:
+	case BFD_RELOC_I51_8_BIT:
+	  if (value < -256 || value > 255)
+	    as_bad_where (fixp->fx_file, fixp->fx_line,
+			  _("operand out of range: %ld"), value);
+	  ((bfd_byte *) where)[0] = (bfd_byte) (value & 0xFF);
+	  break;
+
+	case BFD_RELOC_I51_7_PCREL:
+	  if (value < -128 || value > 127)
+	    as_bad_where (fixp->fx_file, fixp->fx_line,
+			  _("operand out of range: %ld"), value);
+	  ((bfd_byte *) where)[0] = (bfd_byte) value;
+#ifdef ASMDBG
+	  fprintf(stderr, "fbdreloc7: %lx\n", value);
+#endif
+	  break;
+
+	case BFD_RELOC_16:
+	  bfd_putb16 ((bfd_vma) value, where);
+	  break;
+
+	case BFD_RELOC_I51_11:
+	  /* Only A10..A0 are encoded; A15..A11 come from the address of
+	     the following instruction, so the target has to sit in the
+	     same 2K page.  */
+	  {
+	    long pc = (fixp->fx_frag->fr_address + fixp->fx_where + 2);
+
+	    if (((value ^ pc) & 0xF800) != 0)
+	      as_bad_where (fixp->fx_file, fixp->fx_line,
+			    _("ACALL/AJMP target 0x%lx is not in the same "
+			      "2K page as 0x%lx"),
+			    (unsigned long) value, (unsigned long) pc);
+	  }
+	  insn = bfd_getb16 (where) & 0x1F00;
+	  value = (((value & 0x0700) << 5) | (value & 0x00FF));
+	  value |= insn;
+	  bfd_putb16 ((bfd_vma) value, where);
+	  break;
+
+	case BFD_RELOC_I51_8_B2B:
+	  /* The byte already holds the bit offset inside the byte named by
+	     the symbol; fold the two into a bit address.  Mirrors
+	     R_I51_8_B2B in bfd/elf32-i51.c.  */
+	  {
+	    long off = where[0];
+
+	    if (value >= 0x20 && value < 0x30)
+	      {
+		if ((value - 0x20) * 8 + off >= 0x80)
+		  as_bad_where (fixp->fx_file, fixp->fx_line,
+				_("operand out of bit range: B2B(%ld,%ld)."),
+				value, off);
+		where[0] = (bfd_byte) ((value - 0x20) * 8 + off);
+	      }
+	    else if (value >= 0x80 && value <= 0xF8 && (value & 7) == 0)
+	      where[0] = (bfd_byte) (value + off);
+	    else
+	      as_bad_where (fixp->fx_file, fixp->fx_line,
+			    _("0x%lx is not bit addressable"),
+			    (unsigned long) value);
+	  }
+	  break;
+
+	case BFD_RELOC_I51_13_PCODE:
+	  /* Mirrors R_I51_13_PCODE in bfd/elf32-i51.c.  */
+	  if (value < 0x0100)
+	    as_bad_where (fixp->fx_file, fixp->fx_line,
+			  _("pcode exec address underflow: 0x%lx"),
+			  (unsigned long) value);
+	  insn = bfd_getb16 (where) & 0xE000;
+	  bfd_putb16 ((bfd_vma) (insn | (value & 0x1FFF)), where);
+	  break;
+
+	default:
+	  as_fatal (_("line %d: unknown relocation type: 0x%x"),
+		    fixp->fx_line, fixp->fx_r_type);
+	  break;
+	}
+    }
+  else
+    {
+      switch (fixp->fx_r_type)
+	{
+	default:
+	  break;
+	}
+      fixp->fx_addnumber = value;
+    }
+}
+
+/* Turn a string in input_line_pointer into a floating point constant
+   of type TYPE, and store the appropriate bytes in *LITP.  The number
+   of LITTLENUMS emitted is stored in *SIZEP.  An error message is
+   returned, or NULL on OK.  */
+
+const char *
+md_atof (int type, char *litp, int *sizep)
+{
+  int prec;
+  LITTLENUM_TYPE words[4];
+  char *t;
+  int i;
+
+  switch (type)
+    {
+    case 'f':
+      prec = 2;
+      break;
+
+    case 'd':
+      prec = 4;
+      break;
+
+    default:
+      *sizep = 0;
+      return _("bad call to md_atof");
+    }
+
+  t = atof_ieee (input_line_pointer, type, words);
+  if (t)
+    input_line_pointer = t;
+
+  *sizep = prec * 2;
+
+  if (target_big_endian)
+    {
+      for (i = 0; i < prec; i++)
+	{
+	  md_number_to_chars (litp, (valueT) words[i], 2);
+	  litp += 2;
+	}
+    }
+  else
+    {
+      for (i = prec - 1; i >= 0; i--)
+	{
+	  md_number_to_chars (litp, (valueT) words[i], 2);
+	  litp += 2;
+	}
+    }
+
+  return NULL;
+}
+
+static void
+i51_bit (int ignore ATTRIBUTE_UNUSED)
+{
+  expressionS exp;
+
+  if (is_it_end_of_statement ())
+    {
+      demand_empty_rest_of_line ();
+      return;
+    }
+
+  do
+    {
+      /* A bit is a 0 or a 1, so the byte relocation a HIGH()/LOW()
+	 prefix asks for has nothing to address here, and the emit_expr ()
+	 below would drop it.  */
+      if (TC_PARSE_CONS_EXPRESSION (&exp, (unsigned int) 1) != BFD_RELOC_NONE)
+	{
+	  as_bad (_("HIGH()/LOW() is not allowed in `.bit'"));
+	  ignore_rest_of_line ();
+	  return;
+	}
+      if (exp.X_op == O_constant)
+	{
+	  if ((exp.X_add_number > 1) || (exp.X_add_number < 0))
+	    {
+	      as_bad (_("bit value is not in range 0..1 %ld"),
+		      (long) exp.X_add_number);
+	      return;
+	    }
+	}
+      emit_expr (&exp, (unsigned int) 1);
+    }
+  while (*input_line_pointer++ == ',');
+
+  input_line_pointer--;		/* Put terminator back into stream.  */
+
+  demand_empty_rest_of_line ();
+}
+
+/* Handle .local directive - remove built-in operands from hash table.
+   This allows user code to redefine built-in register names with .equ */
+static void
+i51_local (int ignore ATTRIBUTE_UNUSED)
+{
+  char *name;
+  char c;
+  char opname[256];
+
+  if (is_it_end_of_statement ())
+    {
+      demand_empty_rest_of_line ();
+      return;
+    }
+
+  /* Process comma-separated list of symbols to remove from operand hash */
+  do
+    {
+      /* Get symbol name */
+      name = input_line_pointer;
+      c = get_symbol_name (&name);
+
+      /* Convert to uppercase and try to remove from operand hash */
+      extract_op (name, opname, sizeof (opname));
+      if (i51_operand && str_hash_find (i51_operand, opname))
+        str_hash_delete (i51_operand, opname);
+
+      /* Restore character and skip whitespace */
+      (void) restore_line_pointer (c);
+      SKIP_WHITESPACE ();
+
+      /* Check for comma */
+      if (*input_line_pointer == ',')
+        ++input_line_pointer;
+      else
+        break;
+    }
+  while (*input_line_pointer);
+
+  demand_empty_rest_of_line ();
+}
+
+symbolS *
+md_undefined_symbol (char *name)
+{
+  /* expression () reaches here from inside i51_parse_operand1 / 2, which are
+     using the shared op[] and oper: keep to locals.  */
+  char symop[sizeof (op)];
+  struct i51_directop_s *symoper;
+
+  extract_op (name, symop, sizeof (symop));
+  symoper = (struct i51_directop_s *) str_hash_find (i51_operand, symop);
+  if (symoper == NULL) return 0;
+  if ((symoper->ref == 'D') || (symoper->ref == 'B'))
+    {
+      return (symbol_new (name, absolute_section, &zero_address_frag, symoper->value));
+    }
+  else if (symoper->ref == 'U')
+    {
+      if (regbank == 0xFF)
+	{
+	  as_bad (_("missing .using"));
+	  return 0;
+	}
+      return (symbol_new (name, absolute_section, &zero_address_frag, regbank + symoper->value));
+    }
+  else return 0;
+}
+
+void
+md_convert_frag (bfd *abfd ATTRIBUTE_UNUSED, asection *sec ATTRIBUTE_UNUSED, fragS *fragP ATTRIBUTE_UNUSED)
+{
+  abort ();
+}
+
+/* A `BFD_ASSEMBLER' GAS will call this to generate a reloc.  GAS
+   will pass the resulting reloc to `bfd_install_relocation'.  This
+   currently works poorly, as `bfd_install_relocation' often does the
+   wrong thing, and instances of `tc_gen_reloc' have been written to
+   work around the problems, which in turns makes it difficult to fix
+   `bfd_install_relocation'.  */
+
+/* If while processing a fixup, a reloc really needs to be created
+   then it is done here.  */
+
+arelent *
+tc_gen_reloc (asection *seg ATTRIBUTE_UNUSED, fixS *fixp)
+{
+  arelent *reloc;
+
+  reloc = (arelent *) xmalloc (sizeof (arelent));
+
+  reloc->sym_ptr_ptr = (asymbol **) xmalloc (sizeof (asymbol *));
+  *reloc->sym_ptr_ptr = symbol_get_bfdsym (fixp->fx_addsy);
+
+  reloc->address = fixp->fx_frag->fr_address + fixp->fx_where;
+  reloc->howto = bfd_reloc_type_lookup (stdoutput, fixp->fx_r_type);
+  if (reloc->howto == (reloc_howto_type *) NULL)
+    {
+      as_bad_where (fixp->fx_file, fixp->fx_line,
+		    _("reloc %d not supported by object file format"),
+		    (int) fixp->fx_r_type);
+      return NULL;
+    }
+
+  if (fixp->fx_r_type == BFD_RELOC_VTABLE_INHERIT
+      || fixp->fx_r_type == BFD_RELOC_VTABLE_ENTRY)
+     reloc->address = fixp->fx_offset;
+
+  reloc->addend = fixp->fx_offset;
+
+  if (fixp->fx_pcrel)
+    reloc->addend -= 1;
+
+  return reloc;
+}
+
+void
+i51_parse_operand1 (void)
+{
+  int temp;
+
+  line = skip_space (line);
+  input_line_pointer = line;
+  line = extract_op (line, op, sizeof (op));
+  oper = (struct i51_directop_s *) str_hash_find (i51_operand, op);
+  op1hlmode = 0;
+  if (oper == NULL)
+    {
+      if (op[0] == '@')
+	{
+	  as_bad (_("indirect prefix not allowed 1: `%s'"), op);
+	  return;
+	}
+      else if (op[0] == '#')
+	{
+	  input_line_pointer++;
+	  op1mode = '#';                     /* # - #data */
+
+	  /* Scan for a HIGH()/LOW() prefix.  */
+	  if (i51_prefix_keyword ("HIGH"))
+	    op1hlmode = I51_OP_HIGH_ADDR;
+	  else if (i51_prefix_keyword ("LOW"))
+	    op1hlmode = I51_OP_LOW_ADDR;
+
+	  while (((opcode->insn_size & 0x80) == 0) && ( opcode->args[0] != op1mode)) opcode++;
+	  if (opcode->args[0] != op1mode)
+	    {
+	      as_bad (_("direct prefix not allowed 1: `%s'"), op);
+	      return;
+	    }
+	} 
+      else
+	{
+	  op1mode = ' ';
+
+	  /* Scan for a HIGH()/LOW()/B2B() prefix.  */
+	  if (i51_prefix_keyword ("HIGH"))
+	    op1hlmode = I51_OP_HIGH_ADDR;
+	  else if (i51_prefix_keyword ("LOW"))
+	    op1hlmode = I51_OP_LOW_ADDR;
+	  else if (i51_prefix_keyword ("B2B"))
+	    {
+	      /* B2B reads its own argument list below, so it steps over the
+		 '(' that HIGH and LOW leave for expression ().  */
+	      input_line_pointer++;
+	      op1hlmode = I51_OP_B2B;
+	    }
+
+	  while (((opcode->insn_size & 0x80) == 0) && 
+		 ( opcode->args[0] != 'B') && /* B - bit */
+		 ( opcode->args[0] != 'D') && /* D - data */
+		 ( opcode->args[0] != 'J') && /* J - jump rel */
+		 ( opcode->args[0] != '1') && /* 1 - jump addr 11 */
+		 ( opcode->args[0] != '6')    /* 6 - jump addr 16 */
+		 ) opcode++;
+	}
+      if ((opcode->insn_size & 0x80) != 0)
+	{
+	  op1mode = opcode->args[0];
+	}
+      else if (( opcode->args[0] != 'B') && ( opcode->args[0] != 'D'))
+	{
+	  op1mode = opcode->args[0];
+	}
+      //PARSE EXPRESION 1
+      expression (&op_expr1);
+      i51_fold_bit_suffix (&op_expr1);
+      if (op_expr1.X_op == O_absent)
+	{
+	  as_bad (_("missing operand 1"));
+	  return;
+	}
+
+      if (op1hlmode == I51_OP_B2B)
+	{
+	  SKIP_WHITESPACE ();
+	  if (*input_line_pointer != ',')
+	    {
+	      as_bad (_("Expected comma after symbol-name"));
+	      ignore_rest_of_line ();
+	      return;
+	    }
+	  input_line_pointer++;		/* skip ',' */
+	  if ((temp = get_absolute_expression ()) < 0)
+	    {
+	      as_bad (_("BYTE2BIT offset (%d.) <0! Ignored."), temp);
+	      ignore_rest_of_line ();
+	      return;
+	    }
+	  SKIP_WHITESPACE ();
+	  if (*input_line_pointer != ')')
+	    {
+	      as_bad (_("Expected ) after offset"));
+	      ignore_rest_of_line ();
+	      return;
+	    }
+	  input_line_pointer++;		/* skip ')' */
+	  b2b_offset = temp;
+	}
+
+      line = input_line_pointer;
+
+#ifdef ASMDBG
+      fprintf(stderr, "op1: %c %s\n", op1mode, op);
+#endif
+    }
+  else
+    {
+      op1mode = oper->ref;
+      if(op1mode == 'U') op1mode = 'D';
+      while (((opcode->insn_size & 0x80) == 0) && ( opcode->args[0] != op1mode)) opcode++;
+      if (opcode->args[0] != op1mode)
+	{
+	  as_bad (_("unknown instruction operand 1: `%s'"), op);
+	  return;
+	}
+      if ((op1mode == 'R') || (op1mode == 'I'))
+	{
+	  regno = oper->value;
+	}
+      else if (oper->ref == 'U')
+	{
+	  if (regbank == 0xFF)
+	    {
+	      as_bad (_("missing .using"));
+	      return;
+	    }
+	  op_expr1.X_op = O_constant;
+	  op_expr1.X_add_number = regbank + oper->value;
+	}
+      else if ((op1mode == 'D') || (op1mode == 'B'))
+	{
+	  op_expr1.X_op = O_constant;
+	  op_expr1.X_add_number = oper->value;
+	}
+#ifdef ASMDBG
+      fprintf(stderr, "op1: %c %s\n", op1mode, op);
+#endif
+    }
+}
+
+void
+i51_parse_operand2 (void)
+{
+  int temp;
+
+  /* Skip the blanks after the comma before recording where the operand
+     starts: the '#' and '/' branches below step over one character to
+     drop the prefix, and the HIGH(/LOW( scan matches from here too.  */
+  line = skip_space (line);
+  input_line_pointer = line;
+  line = extract_op (line, op, sizeof (op));
+  oper = (struct i51_directop_s *) str_hash_find (i51_operand, op);
+  op2hlmode = 0;
+  if (oper == NULL)
+    {
+      if (op[0] == '@')
+	{
+	  as_bad (_("indirect prefix not allowed 2: `%s'"), op);
+	  return;
+	}
+      else if (op[0] == '#')
+	{
+	  input_line_pointer++;
+	  op2mode = op[0];   /* # - #data */
+
+	  /* Scan for a HIGH()/LOW() prefix.  */
+	  if (i51_prefix_keyword ("HIGH"))
+	    op2hlmode = I51_OP_HIGH_ADDR;
+	  else if (i51_prefix_keyword ("LOW"))
+	    op2hlmode = I51_OP_LOW_ADDR;
+
+	  while (((opcode->insn_size & 0x80) == 0) && ( opcode->args[1] != op2mode)) opcode++;
+	  if (opcode->args[1] != op2mode)
+	    {
+	      as_bad (_("direct prefix not allowed 2: `%s'"), op);
+	      return;
+	    }
+	  if (op1mode == ' ') op1mode = 'D';
+	} 
+      else if (op[0] == '/')
+	{
+	  op2mode = op[0];   /* - - /bit  */
+	  while (((opcode->insn_size & 0x80) == 0) && ( opcode->args[1] != op2mode)) opcode++;
+	  if (opcode->args[1] != op2mode)
+	    {
+	      as_bad (_("negation prefix not allowed 2: `%s'"), op);
+	      return;
+	    }
+	  if (op1mode == ' ') op1mode = 'B';
+	  input_line_pointer++;
+	} 
+      else
+	{
+
+	  /* Scan for a HIGH()/LOW()/B2B() prefix.  */
+	  if (i51_prefix_keyword ("HIGH"))
+	    op2hlmode = I51_OP_HIGH_ADDR;
+	  else if (i51_prefix_keyword ("LOW"))
+	    op2hlmode = I51_OP_LOW_ADDR;
+	  else if ((op_expr1.X_op == O_max) && i51_prefix_keyword ("B2B"))
+	    {
+	      /* B2B reads its own argument list below, so it steps over the
+		 '(' that HIGH and LOW leave for expression ().  */
+	      input_line_pointer++;
+	      op2hlmode = I51_OP_B2B;
+	    }
+
+	  while (((opcode->insn_size & 0x80) == 0) && 
+		 ( opcode->args[1] != 'B') && /* B - bit */
+		 ( opcode->args[1] != 'D') && /* D - data */
+		 ( opcode->args[1] != 'J') && /* J - jump rel */
+		 ( opcode->args[1] != 'd')    /* d - data16 */
+		 ) opcode++;
+	}
+      op2mode = opcode->args[1];
+      
+      if (op1mode == ' ') op1mode = opcode->args[0];
+
+      //PARSE EXPRESION 1 / 2
+      if (op_expr1.X_op == O_max)
+	{
+	  op1hlmode = op2hlmode;
+	  expression (&op_expr1);
+	  i51_fold_bit_suffix (&op_expr1);
+	  if (op_expr1.X_op == O_absent)
+	    {
+	      as_bad (_("missing operand 2"));
+	      return;
+	    }
+	  if (op2hlmode == I51_OP_B2B)
+	    {
+	      SKIP_WHITESPACE ();
+	      if (*input_line_pointer != ',')
+		{
+		  as_bad (_("Expected comma after symbol-name"));
+		  ignore_rest_of_line ();
+		  return;
+		}
+	      input_line_pointer++;		/* skip ',' */
+	      if ((temp = get_absolute_expression ()) < 0)
+		{
+		  as_bad (_("BYTE2BIT offset (%d.) <0! Ignored."), temp);
+		  ignore_rest_of_line ();
+		  return;
+		}
+	      SKIP_WHITESPACE ();
+	      if (*input_line_pointer != ')')
+		{
+		  as_bad (_("Expected ) after offset"));
+		  ignore_rest_of_line ();
+		  return;
+		}
+	      input_line_pointer++;		/* skip ')' */
+	      b2b_offset = temp;
+	    }
+	}
+      else
+	{
+	  expression (&op_expr2);
+	  i51_fold_bit_suffix (&op_expr2);
+	  if (op_expr2.X_op == O_absent)
+	    {
+	      as_bad (_("missing operand 2"));
+	      return;
+	    }
+	}
+
+      line = input_line_pointer;
+
+#ifdef ASMDBG
+      fprintf(stderr, "op2: %c %s\n", op2mode, op);
+#endif
+    }
+  else
+    {
+      op2mode = oper->ref;
+      if(op2mode == 'U') op2mode = 'D';
+      while (((opcode->insn_size & 0x80) == 0) && ( opcode->args[1] != op2mode)) opcode++;
+      if (opcode->args[1] != op2mode)
+	{
+	  as_bad (_("unknown instruction operand 2: `%s'"), op);
+	  return;
+	}
+      if ((opcode->args[0] != op1mode) &&
+	  ((op1mode != ' ') || ((opcode->args[0] != 'B') && (opcode->args[0] != 'D'))) )
+	{
+	  as_bad (_("unknown instruction operand 2: `%s'"), op);
+	  return;
+	}
+      if (op1mode == ' ') op1mode = opcode->args[0];
+      if ((op2mode == 'R') || (op2mode == 'I'))
+	{
+	  regno = oper->value;
+	}
+      else if (oper->ref == 'U')
+	{
+	  if (regbank == 0xFF)
+	    {
+	      as_bad (_("missing .using"));
+	      return;
+	    }
+	  if (op_expr1.X_op == O_max)
+	    {
+	      op_expr1.X_op = O_constant;
+	      op_expr1.X_add_number = regbank + oper->value;
+	    }
+	  else
+	    {
+	      op_expr2.X_op = O_constant;
+	      op_expr2.X_add_number = regbank + oper->value;
+	    }
+	}
+      else if ((op2mode == 'D') || (op2mode == 'B') || (op2mode == '/'))
+	{
+	  if (op_expr1.X_op == O_max)
+	    {
+	      op_expr1.X_op = O_constant;
+	      op_expr1.X_add_number = oper->value;
+	    }
+	  else
+	    {
+	      op_expr2.X_op = O_constant;
+	      op_expr2.X_add_number = oper->value;
+	    }
+	}
+#ifdef ASMDBG
+      fprintf(stderr, "op2: %c %s\n", op2mode, op);
+#endif
+    }
+}
+
+void
+i51_build_ins (struct i51_opcodes_s *opc, unsigned char regnumber, expressionS *expr1, expressionS *expr2)
+{
+  unsigned char bin_opcode;
+  char *frag;
+
+  bin_opcode = opc->bin_opcode;
+  /* place register operand to instruction code */
+  switch (opc->mreloc) {
+  case 'I':			// register indirect            - IIIIIIIr
+  case 'i':			// reg. indirect, data          - IIIIIIIr dddddddd
+  case 'X':			// reg. indirect, r. jump 8 bit - IIIIIIIr dddddddd aaaaaaaa
+    regnumber &= 0x01;
+    bin_opcode |= regnumber;
+    break;
+  case 'R':			// register                     - IIIIIrrr
+  case 'r':			// register,data                - IIIIIrrr dddddddd
+  case 'Y':			// register, rel. jump 8 bit    - IIIIIrrr dddddddd aaaaaaaa
+  case 'W':			// register, rel. jump 8 bit    - IIIIIrrr aaaaaaaa
+    regnumber &= 0x07;
+    bin_opcode |= regnumber;
+    break;
+  default:
+    break;
+  }
+
+  switch (opc->mreloc) {
+  case '7':			//relative jump 8 bit          - IIIIIIII aaaaaaaa
+  case 'W':			//register, rel. jump 8 bit    - IIIIIrrr aaaaaaaa
+  case '1':			//jump 11 bit                  - aaaIIIII aaaaaaaa
+  case '6':			//data/jump 16 bit             - IIIIIIII aaaaaaaa aaaaaaaa
+    if (op1hlmode)
+      {
+	as_bad (_("HI/LOW/B2B prefix not allowed"));
+	return;
+      }
+  default:
+    break;
+  }
+
+  switch (opc->mreloc) {
+  case 'N':			//none                - IIIIIIII
+  case 'I':			//register indirect   - IIIIIIIr
+  case 'R':			//register            - IIIIIrrr
+    frag = frag_more (1);
+    number_to_chars_bigendian (frag, bin_opcode, 1);
+    break;
+
+  case 'D':			//data 8 bit                   - IIIIIIII dddddddd
+  case 'i':			//reg. indirect, data          - IIIIIIIr dddddddd
+  case 'r':			//register,data                - IIIIIrrr dddddddd
+    frag = frag_more (1);
+    number_to_chars_bigendian (frag, bin_opcode, 1);
+    fixup8 (expr1, I51_OP_IMM8, op1hlmode);
+    break;
+
+  case '7':			//relative jump 8 bit          - IIIIIIII aaaaaaaa
+  case 'W':			//register, rel. jump 8 bit    - IIIIIrrr aaaaaaaa
+    frag = frag_more (1);
+    number_to_chars_bigendian (frag, bin_opcode, 1);
+    fixup8 (expr1, I51_OP_JUMP_REL, 0);
+    break;
+
+  case '1':			//jump 11 bit                  - aaaIIIII aaaaaaaa
+    fixup11(expr1, bin_opcode, I51_OP_JUMP_INPAGE, 0);
+    break;
+
+  case 'B':			//bitdata 8 bit                - IIIIIIII bbbbbbbb
+    frag = frag_more (1);
+    number_to_chars_bigendian (frag, bin_opcode, 1);
+    fixup8 (expr1, I51_OP_BIT, op1hlmode);
+    break;
+
+  case 'd':			//data,data 8 bit              - IIIIIIII dddddddd dddddddd
+    frag = frag_more (1);
+    number_to_chars_bigendian (frag, bin_opcode, 1);
+    fixup8 (expr2, I51_OP_IMM8, op2hlmode);
+    fixup8 (expr1, I51_OP_IMM8, op1hlmode);
+    break;
+
+  case 'a':			//adr,data 8 bit               - IIIIIIII aaaaaaaa dddddddd
+    frag = frag_more (1);
+    number_to_chars_bigendian (frag, bin_opcode, 1);
+    fixup8 (expr1, I51_OP_IMM8, op1hlmode);
+    fixup8 (expr2, I51_OP_IMM8, op2hlmode);
+    break;
+
+  case 'J':			//bit, r. jump 8 bit           - IIIIIIII bbbbbbbb aaaaaaaa
+    frag = frag_more (1);
+    number_to_chars_bigendian (frag, bin_opcode, 1);
+    fixup8 (expr1, I51_OP_BIT, op1hlmode);
+    fixup8 (expr2, I51_OP_JUMP_REL, 0);
+    break;
+
+  case 'X':			//reg. indirect, r. jump 8 bit - IIIIIIIr dddddddd aaaaaaaa
+  case 'Y':			//register, rel. jump 8 bit    - IIIIIrrr dddddddd aaaaaaaa
+  case 'Z':			//data 8 bit, r. jump 8 bit    - IIIIIIII dddddddd aaaaaaaa
+    frag = frag_more (1);
+    number_to_chars_bigendian (frag, bin_opcode, 1);
+    fixup8 (expr1, I51_OP_IMM8, op1hlmode);
+    fixup8 (expr2, I51_OP_JUMP_REL, 0);
+    break;
+
+  case '6':			//data/jump 16 bit             - IIIIIIII aaaaaaaa aaaaaaaa
+    frag = frag_more (1);
+    number_to_chars_bigendian (frag, bin_opcode, 1);
+    fixup16 (expr1, I51_OP_IMM16, 0);
+    break;
+  }
+}
+
+/* Checks that the number 'num' fits for a given mode.  */
+static int
+check_range (long num, int mode)
+{
+  switch (mode)
+    {
+    case I51_OP_IMM8:
+    case I51_OP_BIT:
+      /* One byte holds -128..255.  The old test asked only that the top 24
+	 bits were all clear or all set, which let -129..-256 through and
+	 truncated them without a word.  */
+      return (num >= -128 && num <= 255) ? 1 : 0;
+
+    case I51_OP_JUMP_REL:
+      return (num >= -128 && num <= 127) ? 1 : 0;
+
+    case I51_OP_JUMP_INPAGE:
+      return (((num & 0xFFFF0000) == 0) || ((num & 0xFFFF0000) == 0xFFFF0000)) ? 1 : 0;
+
+    case I51_OP_IMM16:
+    case I51_OP_HIGH_ADDR:
+      return (((num & 0xFFFF0000) == 0) || ((num & 0xFFFF0000) == 0xFFFF0000)) ? 1 : 0;
+
+    case I51_OP_LOW_ADDR:
+      return 1;
+
+    default:
+      return 0;
+    }
+}
+
+/* Gas fixup generation.  */
+
+/* Put a 1 byte expression described by 'oper'.  If this expression contains
+   unresolved symbols, generate an 8-bit fixup.  */
+static void
+fixup8 (expressionS *ex, int mode, int opmode)
+{
+  char *f;
+
+  f = frag_more (1);
+
+  /* A relative branch operand is an absolute target address even when it
+     is a plain constant: the displacement is only known once the address
+     of this frag is, so it always goes through a fixup.  */
+  if (ex->X_op == O_constant && mode != I51_OP_JUMP_REL)
+    {
+      switch (opmode) {
+      case I51_OP_HIGH_ADDR:
+	if (!check_range (ex->X_add_number, opmode))
+	  {
+	    as_bad (_("HIGH Operand out of 8-bit range: `%ld'."),
+		    (long) ex->X_add_number);
+	  }
+	number_to_chars_bigendian (f, ((ex->X_add_number >> 8)) & 0xFF, 1);
+	break;
+      case I51_OP_LOW_ADDR:
+	if (!check_range (ex->X_add_number, opmode))
+	  {
+	    as_bad (_("LOW Operand out of 8-bit range: `%ld'."),
+		    (long) ex->X_add_number);
+	  }
+	number_to_chars_bigendian (f, (ex->X_add_number & 0xFF), 1);
+	break;
+      case I51_OP_B2B:
+	if ((ex->X_add_number < 0x20) ||
+	    ((ex->X_add_number < 0x30) && (((ex->X_add_number - 0x20) * 8 + b2b_offset) >= 0x80)) ||
+	    ((ex->X_add_number >= 0x30) && (ex->X_add_number < 0x80)) ||
+	    ((ex->X_add_number + b2b_offset) > 0xFF) )
+	  {
+	    as_bad (_("Operand out of bit range: B2B(%ld,%d)."),
+		    (long) ex->X_add_number, b2b_offset);
+	  }
+	if (ex->X_add_number < 0x30)
+	  {
+	    number_to_chars_bigendian (f, ((ex->X_add_number - 0x20) * 8 + b2b_offset), 1);
+	  }
+	else
+	  {
+	    number_to_chars_bigendian (f, (ex->X_add_number + b2b_offset), 1);
+	  }
+	break;
+      default:
+	if (!check_range (ex->X_add_number, mode))
+	  {
+	    as_bad (_("Operand out of 8-bit range: `%ld'."),
+		    (long) ex->X_add_number);
+	  }
+	number_to_chars_bigendian (f, (ex->X_add_number & 0xFF), 1);
+	break;
+      }
+    }
+  else if (ex->X_op != O_register)
+    {
+      switch (mode) {
+      case I51_OP_IMM8:
+	/* Now create an 8-bit fixup.  If there was some %hi or %lo
+	 modifier, generate the reloc accordingly.  */
+	fix_new_exp (frag_now, f - frag_now->fr_literal, 1,
+		     ex, false,
+		     ((opmode & I51_OP_HIGH_ADDR)
+		      ? BFD_RELOC_I51_8_HIGH
+		      : ((opmode & I51_OP_LOW_ADDR)
+			 ? BFD_RELOC_I51_8_LOW : BFD_RELOC_8)));
+	number_to_chars_bigendian (f, 0, 1);
+	break;
+      case I51_OP_JUMP_REL:
+	/* Now create an 8-bit relative jump fixup */
+	fix_new_exp (frag_now, f - frag_now->fr_literal, 1,
+		     ex, true, BFD_RELOC_I51_7_PCREL);
+	number_to_chars_bigendian (f, 0, 1);
+	break;
+      case I51_OP_BIT:
+	/* Now create an 8-bit bit B2B area fixup */
+	fix_new_exp (frag_now, f - frag_now->fr_literal, 1,
+		     ex, false,
+		     (opmode & I51_OP_B2B 
+		      ? BFD_RELOC_I51_8_B2B : BFD_RELOC_I51_8_BIT));
+	number_to_chars_bigendian (f, (opmode & I51_OP_B2B
+				       ? b2b_offset : 0), 1);
+	break;
+      }
+    }
+  else
+    {
+      as_fatal (_("Operand `%x' not recognized in fixup8."), ex->X_op);
+    }
+}
+
+/* Put a 11 bit expression described by 'oper'.  If this expression contains
+   unresolved symbols, generate an 11-bit fixup.  */
+static void
+fixup11 (expressionS *ex, unsigned int opc, int mode, int opmode ATTRIBUTE_UNUSED)
+{
+  char *f;
+
+  f = frag_more (2);
+
+  if (ex->X_op == O_constant && !check_range (ex->X_add_number, mode))
+    {
+      as_bad (_("Operand out of 16-bit range: `%ld'."),
+	      (long) ex->X_add_number);
+    }
+  if (ex->X_op != O_register)
+    {
+      switch (mode) {
+      case I51_OP_JUMP_INPAGE:
+	/* Now create an 11-bit inpage jump fixup */
+	fix_new_exp (frag_now, f - frag_now->fr_literal, 2,
+		     ex, false, BFD_RELOC_I51_11);
+	number_to_chars_bigendian (f, (opc << 8), 2);
+	break;
+      }
+    }
+  else
+    {
+      as_fatal (_("Operand `%x' not recognized in fixup8."), ex->X_op);
+    }
+}
+
+/* Put a 2 byte expression described by 'oper'.  If this expression contains
+   unresolved symbols, generate a 16-bit fixup.  */
+static void
+fixup16 (expressionS *ex, int mode, int opmode ATTRIBUTE_UNUSED)
+{
+  char *f;
+
+  f = frag_more (2);
+
+  if (ex->X_op == O_constant)
+    {
+      if (!check_range (ex->X_add_number, mode))
+	{
+	  as_bad (_("Operand out of 16-bit range: `%ld'."),
+		  (long) ex->X_add_number);
+	}
+      number_to_chars_bigendian (f, ex->X_add_number & 0x0FFFF, 2);
+    }
+  else if (ex->X_op != O_register)
+    {
+      /* Now create a 16-bit fixup.  */
+      fix_new_exp (frag_now, f - frag_now->fr_literal, 2,
+			  ex,
+			  false,
+			  BFD_RELOC_16);
+      number_to_chars_bigendian (f, 0, 2);
+    }
+  else
+    {
+      as_fatal (_("Operand `%x' not recognized in fixup16."), ex->X_op);
+    }
+}
+
+/* Match one operand-prefix keyword - HIGH, LOW or B2B - at
+   input_line_pointer.  The comparison ignores case and allows space
+   before the parenthesis, and the keyword has to end where it ends: a
+   plain prefix match would take the LOW out of a symbol called LOWMARK
+   and assemble the rest.
+
+   On a match input_line_pointer is left on the '(', so that the caller's
+   expression () reads the operand as an ordinary parenthesised
+   expression and consumes the matching ')'.  B2B reads its own argument
+   list instead and steps over the '(' itself.  Nothing moves when the
+   keyword is not there.  */
+
+static int
+i51_prefix_keyword (const char *kw)
+{
+  size_t len = strlen (kw);
+  char *p = skip_space (input_line_pointer);
+
+  if (strncasecmp (p, kw, len) != 0)
+    return 0;
+  if (is_part_of_name (p[len]))
+    return 0;
+
+  p = skip_space (p + len);
+  if (*p != '(')
+    return 0;
+
+  input_line_pointer = p;
+  return 1;
+}
+
+/* Parse one operand of a data allocation directive, reached from read.c
+   through TC_PARSE_CONS_EXPRESSION.  `.byte LOW (x)' and `.byte HIGH (x)'
+   name the two halves of a 16-bit value, which is how a little-endian
+   datum is written for a machine whose section contents are big endian.
+   The relocation the prefix asks for is returned, BFD_RELOC_NONE when
+   there is no prefix.  */
+
+bfd_reloc_code_real_type
+i51_parse_cons_expression (expressionS *exp, int nbytes)
+{
+  int hlmode = 0;
+
+  if (i51_prefix_keyword ("HIGH"))
+    hlmode = I51_OP_HIGH_ADDR;
+  else if (i51_prefix_keyword ("LOW"))
+    hlmode = I51_OP_LOW_ADDR;
+
+  /* Both relocations write a single byte and neither has a wider form,
+     so a prefix on a wider datum has no encoding at all.  Say so, and
+     read what follows as the parenthesised expression it looks like, to
+     keep the rest of the line in step.  */
+  if (hlmode != 0 && nbytes != 1)
+    {
+      as_bad (_("HIGH()/LOW() needs a one byte operand"));
+      hlmode = 0;
+    }
+
+  expression (exp);
+
+  if (hlmode == I51_OP_HIGH_ADDR)
+    return BFD_RELOC_I51_8_HIGH;
+  if (hlmode == I51_OP_LOW_ADDR)
+    return BFD_RELOC_I51_8_LOW;
+  return BFD_RELOC_NONE;
+}
+
+/* Generate the fixup for one operand of a data allocation directive,
+   reached from read.c through TC_CONS_FIX_NEW.  RELOC is what
+   i51_parse_cons_expression () returned, and BFD_RELOC_NONE leaves the
+   width to decide.  The port relocates one byte and two; it has no
+   wider relocation to name.  */
+
+void
+i51_cons_fix_new (fragS *frag, int where, int nbytes, expressionS *exp,
+		  bfd_reloc_code_real_type reloc)
+{
+  if (reloc == BFD_RELOC_NONE)
+    {
+      switch (nbytes)
+	{
+	case 1:
+	  reloc = BFD_RELOC_8;
+	  break;
+	case 2:
+	  reloc = BFD_RELOC_16;
+	  break;
+	default:
+	  as_bad (_("cannot relocate %d bytes of data"), nbytes);
+	  return;
+	}
+    }
+
+  fix_new_exp (frag, where, nbytes, exp, false, reloc);
+}
+
+int
+i51_section_flags (int flags, int attr, int type ATTRIBUTE_UNUSED)
+{
+  if (attr & SHF_REGBANK)
+    flags |= SEC_IS_COMMON;
+
+  return flags;
+}
+
+static void
+i51_using (int par ATTRIBUTE_UNUSED)
+{
+  SKIP_WHITESPACE ();
+  switch (*input_line_pointer)
+    {
+    case '0':  /* Reg bank 0 */
+      regbank = 0;
+      break;
+    case '1':  /* Reg bank 1 */
+      regbank = 8;
+      break;
+    case '2':  /* Reg bank 2 */
+      regbank = 16;
+      break;
+    case '3':  /* Reg bank 3 */
+      regbank = 24;
+      break;
+    default:
+      /* Do not step over the character: at end of line that would be the
+	 newline, and the rest of the file would shift by a line.  */
+      as_bad (_("expected a register bank number 0, 1, 2 or 3"));
+      ignore_rest_of_line ();
+      return;
+    }
+  input_line_pointer++;
+  if (regbank > regused) regused = regbank;
+  /* Without this anything after the bank number is handed back to the
+     reader as a statement of its own: `.using 1 nop' assembled a nop.  */
+  demand_empty_rest_of_line ();
+}
+
+void
+i51_cleanup (void)
+{
+  symbolS *symbolP;
+
+  if (regbank != 0xFF)
+    {
+
+  symbolP = symbol_find_or_make ("__RB__");
+
+  S_SET_VALUE (symbolP, (valueT) regused+8);
+  S_SET_EXTERNAL (symbolP);
+  S_SET_SEGMENT (symbolP, &scom_section);
+
+  know (symbol_get_frag (symbolP) == &zero_address_frag);
+
+      regbank = 0xFF;
+      regused = 0;
+    }
+}
+
+/* What a memory-space section carries: the bss spaces hold sizes only,
+   the data spaces hold bytes.  */
+#define I51_SPACE_BSS   SEC_ALLOC
+#define I51_SPACE_DATA  (SEC_ALLOC | SEC_LOAD | SEC_RELOC | SEC_DATA)
+
+/* The section a memory-space directive switches into, or that a local
+   memory-space common is allocated in, created the first time it is
+   needed.  KEEP is what a section created here is allowed to carry.
+
+   The section may be there already, because a file is free to declare
+   .rbss itself with .section and fill it with real data.  Flags and the
+   bss marker are therefore set only on a section created here, the way
+   obj-elf.c sets them only for a section it creates.  Setting them a
+   second time takes SEC_LOAD off a section that already holds data and
+   marks it contentless, and every byte in it is then dropped from the
+   object with nothing said.  */
+
+static segT
+i51_space_section (const char *name, flagword keep)
+{
+  int fresh = bfd_get_section_by_name (stdoutput, name) == NULL;
+  segT sec = subseg_new (name, 0);
+
+  if (fresh)
+    {
+      flagword applicable = bfd_applicable_section_flags (stdoutput);
+
+      bfd_set_section_flags (sec, applicable & keep);
+      /* A space that holds no bytes must not pick up SEC_HAS_CONTENTS
+	 from the frags an allocation leaves behind.  */
+      if ((keep & SEC_LOAD) == 0)
+	seg_info (sec)->bss = 1;
+    }
+  return sec;
+}
+
+void
+i51_common (int common_segment)
+{
+  char *name;
+  char c;
+  int temp, size, alignment;
+  symbolS *symbolP;
+  int align;
+
+  if (flag_mri)
+    {
+      as_bad (_("not implemented in MRI mode"));
+      return;
+    }
+
+  c = get_symbol_name (&name);
+  /* The name is NUL-terminated in place, so the symbol has to be taken before
+     restore_line_pointer () writes the delimiter back over the NUL.  */
+  symbolP = symbol_find_or_make (name);
+  (void) restore_line_pointer (c);
+  SKIP_WHITESPACE ();
+  if (*input_line_pointer != ',')
+    {
+      as_bad (_("Expected comma after symbol-name"));
+      ignore_rest_of_line ();
+      return;
+    }
+  input_line_pointer++;		/* skip ',' */
+  if ((temp = get_absolute_expression ()) < 0)
+    {
+      as_bad (_(".COMMon length (%d.) <0! Ignored."), temp);
+      ignore_rest_of_line ();
+      return;
+    }
+  size = temp;
+  if (S_IS_DEFINED (symbolP) && ! S_IS_COMMON (symbolP))
+    {
+      as_bad (_("Ignoring attempt to re-define symbol"));
+      ignore_rest_of_line ();
+      return;
+    }
+  if (S_GET_VALUE (symbolP) != 0)
+    {
+      if (S_GET_VALUE (symbolP) != (valueT) size)
+	{
+	  as_warn (_("Length of .comm \"%s\" is already %ld. Not changed to %d."),
+		   S_GET_NAME (symbolP), (long) S_GET_VALUE (symbolP), size);
+	}
+    }
+  know (symbol_get_frag (symbolP) == &zero_address_frag);
+  if (*input_line_pointer != ',')
+    temp = 0;
+  else
+    {
+      input_line_pointer++;
+      SKIP_WHITESPACE ();
+      temp = get_absolute_expression ();
+      if (temp < 0)
+	{
+	  temp = 0;
+	  as_warn (_("Common alignment negative; 0 assumed"));
+	}
+    }
+  /* The loop below consumes TEMP, so keep the alignment the line asked for:
+     S_SET_ALIGN wants the byte alignment, and handing it the leftover 1
+     recorded every explicitly aligned common as unaligned.  */
+  alignment = temp;
+  if (temp)
+    {
+      /* convert to a power of 2 alignment */
+      for (align = 0; (temp & 1) == 0; temp >>= 1, ++align);
+      if (temp != 1)
+	{
+	  as_bad (_("Common alignment not a power of 2"));
+	  ignore_rest_of_line ();
+	  return;
+	}
+    }
+  else
+    align = 0;
+  if (symbol_get_obj (symbolP)->local)
+    {
+      segT old_sec;
+      int old_subsec;
+      char *pfrag;
+
+      /* allocate_?bss: */
+      old_sec = now_seg;
+      old_subsec = now_subseg;
+
+      switch (common_segment & 0x7F)
+	{
+	case 0: //comm
+	  record_alignment (bss_section, align);
+	  subseg_set (bss_section, 0);
+	  if (align)
+	    frag_align (align, 0, 0);
+	  if (S_GET_SEGMENT (symbolP) == bss_section)
+	    symbol_get_frag (symbolP)->fr_symbol = 0;
+	  symbol_set_frag (symbolP, frag_now);
+	  pfrag = frag_var (rs_org, 1, 1, (relax_substateT) 0, symbolP,
+			    (offsetT) size, (char *) 0);
+	  *pfrag = 0;
+	  S_SET_SIZE (symbolP, size);
+	  S_SET_SEGMENT (symbolP, bss_section);
+	  break;
+	case 1: //rcomm
+	  if (rbss_section == NULL)
+	    rbss_section = i51_space_section (".rbss", I51_SPACE_BSS);
+	  record_alignment (rbss_section, align);
+	  subseg_set (rbss_section, 0);
+	  if (align)
+	    frag_align (align, 0, 0);
+	  if (S_GET_SEGMENT (symbolP) == rbss_section)
+	    symbol_get_frag (symbolP)->fr_symbol = 0;
+	  symbol_set_frag (symbolP, frag_now);
+	  pfrag = frag_var (rs_org, 1, 1, (relax_substateT) 0, symbolP,
+			    (offsetT) size, (char *) 0);
+	  *pfrag = 0;
+	  S_SET_SIZE (symbolP, size);
+	  S_SET_SEGMENT (symbolP, rbss_section);
+	  break;
+	case 2: //bitcomm
+	  if (bitbss_section == NULL)
+	    bitbss_section = i51_space_section (".bitbss", I51_SPACE_BSS);
+	  record_alignment (bitbss_section, align);
+	  subseg_set (bitbss_section, 0);
+	  if (align)
+	    frag_align (align, 0, 0);
+	  if (S_GET_SEGMENT (symbolP) == bitbss_section)
+	    symbol_get_frag (symbolP)->fr_symbol = 0;
+	  symbol_set_frag (symbolP, frag_now);
+	  pfrag = frag_var (rs_org, 1, 1, (relax_substateT) 0, symbolP,
+			    (offsetT) size, (char *) 0);
+	  *pfrag = 0;
+	  S_SET_SIZE (symbolP, size);
+	  S_SET_SEGMENT (symbolP, bitbss_section);
+	  break;
+	case 3: //icomm
+	  if (ibss_section == NULL)
+	    ibss_section = i51_space_section (".ibss", I51_SPACE_BSS);
+	  record_alignment (ibss_section, align);
+	  subseg_set (ibss_section, 0);
+	  if (align)
+	    frag_align (align, 0, 0);
+	  if (S_GET_SEGMENT (symbolP) == ibss_section)
+	    symbol_get_frag (symbolP)->fr_symbol = 0;
+	  symbol_set_frag (symbolP, frag_now);
+	  pfrag = frag_var (rs_org, 1, 1, (relax_substateT) 0, symbolP,
+			    (offsetT) size, (char *) 0);
+	  *pfrag = 0;
+	  S_SET_SIZE (symbolP, size);
+	  S_SET_SEGMENT (symbolP, ibss_section);
+	  break;
+	case 4: //xcomm
+	  if (xbss_section == NULL)
+	    xbss_section = i51_space_section (".xbss", I51_SPACE_BSS);
+	  record_alignment (xbss_section, align);
+	  subseg_set (xbss_section, 0);
+	  if (align)
+	    frag_align (align, 0, 0);
+	  if (S_GET_SEGMENT (symbolP) == xbss_section)
+	    symbol_get_frag (symbolP)->fr_symbol = 0;
+	  symbol_set_frag (symbolP, frag_now);
+	  pfrag = frag_var (rs_org, 1, 1, (relax_substateT) 0, symbolP,
+			    (offsetT) size, (char *) 0);
+	  *pfrag = 0;
+	  S_SET_SIZE (symbolP, size);
+	  S_SET_SEGMENT (symbolP, xbss_section);
+	  break;
+	case 5: //ecomm
+	  if (ebss_section == NULL)
+	    ebss_section = i51_space_section (".ebss", I51_SPACE_BSS);
+	  record_alignment (ebss_section, align);
+	  subseg_set (ebss_section, 0);
+	  if (align)
+	    frag_align (align, 0, 0);
+	  if (S_GET_SEGMENT (symbolP) == ebss_section)
+	    symbol_get_frag (symbolP)->fr_symbol = 0;
+	  symbol_set_frag (symbolP, frag_now);
+	  pfrag = frag_var (rs_org, 1, 1, (relax_substateT) 0, symbolP,
+			    (offsetT) size, (char *) 0);
+	  *pfrag = 0;
+	  S_SET_SIZE (symbolP, size);
+	  S_SET_SEGMENT (symbolP, ebss_section);
+	  break;
+	case 6: //bcomm
+	  if (bbss_section == NULL)
+	    bbss_section = i51_space_section (".bbss", I51_SPACE_BSS);
+	  record_alignment (bbss_section, align);
+	  subseg_set (bbss_section, 0);
+	  if (align)
+	    frag_align (align, 0, 0);
+	  if (S_GET_SEGMENT (symbolP) == bbss_section)
+	    symbol_get_frag (symbolP)->fr_symbol = 0;
+	  symbol_set_frag (symbolP, frag_now);
+	  pfrag = frag_var (rs_org, 1, 1, (relax_substateT) 0, symbolP,
+			    (offsetT) size, (char *) 0);
+	  *pfrag = 0;
+	  S_SET_SIZE (symbolP, size);
+	  S_SET_SEGMENT (symbolP, bbss_section);
+	  break;
+	}
+      S_CLEAR_EXTERNAL (symbolP);
+      subseg_set (old_sec, old_subsec);
+    }
+  else
+    {
+      S_SET_VALUE (symbolP, (valueT) size);
+      S_SET_ALIGN (symbolP, alignment);
+      S_SET_EXTERNAL (symbolP);
+      switch (common_segment) {
+      case 0: //comm
+	S_SET_SEGMENT (symbolP, bfd_com_section_ptr);
+	break;
+      case 1: //rcomm
+	S_SET_SEGMENT (symbolP, &rcom_section);
+	break;
+      case 2: //bitcomm
+	S_SET_SEGMENT (symbolP, &bitcom_section);
+	break;
+      case 3: //icomm
+	S_SET_SEGMENT (symbolP, &icom_section);
+	break;
+      case 4: //xcomm
+	S_SET_SEGMENT (symbolP, &xcom_section);
+	break;
+      case 5: //ecomm
+	S_SET_SEGMENT (symbolP, &ecom_section);
+	break;
+      case 6: //bcomm
+	S_SET_SEGMENT (symbolP, &bcom_section);
+	break;
+      }
+    }
+  
+  symbol_get_bfdsym (symbolP)->flags |= BSF_OBJECT;
+
+  demand_empty_rest_of_line ();
+  return;
+}
