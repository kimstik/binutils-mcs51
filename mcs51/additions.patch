+
+static bool
+i51_elf_section_from_shdr (bfd *abfd,
+			    Elf_Internal_Shdr *hdr,
+			    const char *name,
+			    int shindex)
+{
+  asection *newsect;
+  flagword flags;
+
+  if (! _bfd_elf_make_section_from_shdr (abfd, hdr, name, shindex))
+    return 0;
+
+  newsect = hdr->bfd_section;
+  flags = bfd_section_flags (newsect);
+
+  if (hdr->sh_flags & SHF_CDATA) flags |= SEC_IS_COMMON;
+
+  bfd_set_section_flags (newsect, flags);
+
+  return 1;
+}
+
+static bool
+i51_elf_fake_sections (bfd *abfd ATTRIBUTE_UNUSED,
+		       Elf_Internal_Shdr *shdr,
+		       asection *asect)
+{
+  register const char * name;
+
+  name = bfd_section_name (asect);
+
+  if (strcmp (name, ".rbbs") == 0)
+    {
+      shdr->sh_flags |= SHF_RDATA;
+    }
+  else if (strcmp (name, ".bbbs") == 0)
+    {
+      shdr->sh_flags |= SHF_BDATA;
+    }
+  else if (strcmp (name, ".ibbs") == 0)
+    {
+      shdr->sh_flags |= SHF_IDATA;
+    }
+  else if (strcmp (name, ".xbbs") == 0)
+    {
+      shdr->sh_flags |= SHF_XDATA;
+    }
+  else if (strcmp (name, ".ebbs") == 0)
+    {
+      shdr->sh_flags |= SHF_EDATA;
+    }
+
+  return 1;
+}
+
+
+/* Given a BFD section, try to locate the corresponding ELF section
+   index.  */
+
+bool
+elf32_i51_section_from_bfd_section (abfd, sec, retval)
+     bfd *abfd ATTRIBUTE_UNUSED;
+     asection *sec;
+     int *retval;
+{
+  const char *name;
+
+  /* Don't process special BFD sections */
+  if (bfd_is_abs_section (sec)
+      || bfd_is_und_section (sec)
+      || bfd_is_com_section (sec)
+      || bfd_is_ind_section (sec))
+    return 0;
+
+  name = bfd_section_name (sec);
+  if (name == NULL || name[0] == '\0')
+    return 0;
+
+  if (strcmp (name, ".regbank") == 0)
+    {
+      *retval = SHN_I51_REGBANK;
+      return 1;
+    }
+  else if (strcmp (name, ".rbss") == 0)
+    {
+      *retval = SHN_I51_RDATA_C;
+      return 1;
+    }
+  else if (strcmp (name, ".bbss") == 0)
+    {
+      *retval = SHN_I51_BDATA_C;
+      return 1;
+    }
+  else if (strcmp (name, ".ibss") == 0)
+    {
+      *retval = SHN_I51_IDATA_C;
+      return 1;
+    }
+  else if (strcmp (name, ".xbss") == 0)
+    {
+      *retval = SHN_I51_XDATA_C;
+      return 1;
+    }
+  else if (strcmp (name, ".ebss") == 0)
+    {
+      *retval = SHN_I51_EDATA_C;
+      return 1;
+    }
+  else if (strcmp (name, ".bitbss") == 0)
+    {
+      *retval = SHN_I51_BITDATA_C;
+      return 1;
+    }
+  return 0;
+}
