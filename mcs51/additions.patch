diff --git a/include/elf/i51.h b/include/elf/i51.h
new file mode 100644
index 00000000..4528f4d2
--- /dev/null
+++ b/include/elf/i51.h
@@ -0,0 +1,147 @@
+/* MCS-51 ELF support for BFD.
+   Copyright (C) 2001 Free Software Foundation, Inc.
+   Contributed by Radek Benedikt <benedikt@lphard.cz>
+
+This file is part of BFD, the Binary File Descriptor library.
+
+This program is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 2 of the License, or
+(at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+You should have received a copy of the GNU General Public License
+along with this program; if not, write to the Free Software Foundation, Inc.,
+59 Temple Place - Suite 330, Boston, MA 02111-1307, USA.  */
+
+#ifndef _ELF_I51_H
+#define _ELF_I51_H
+
+#include "elf/reloc-macros.h"
+
+/* The machine number is the registered EM_8051 (165), defined in
+   elf/common.h.  Objects are ELFDATA2MSB, container and section contents
+   alike, which is what the gABI requires EI_DATA to describe.
+
+   The MCS-51 itself has no architectural byte order: Intel's manuals never
+   use the words, because the instruction set has no 16-bit load or store to
+   data memory at all ("this is the only instruction which moves 16 bits of
+   data at once" is said of MOV DPTR,#data16, which reads an immediate out of
+   the code stream).  Byte order is therefore defined per construct, and the
+   two conventions Intel lands on are opposites: a 16-bit address inside an
+   instruction is stored high byte first (LJMP/LCALL addr16, MOV DPTR,#data16,
+   and ASM51's DW, which writes code memory), while LCALL pushes the PC low
+   byte first onto an upward-growing stack, leaving it low-byte-at-lower-
+   address in RAM.
+
+   Only the first of those two ever reaches an object file.  Stack frames and
+   SFR register pairs live in RAM at run time and are never section contents,
+   so everything gas writes into a section - instruction operands, and .word /
+   .long / .short through number_to_chars_bigendian - is big endian without
+   exception.  ELFDATA2MSB is the truthful declaration for that, and matches
+   both the 2001 original this port descends from and the gas half's
+   TARGET_BYTES_BIG_ENDIAN.
+
+   R_I51_L and R_I51_H address the two halves of a 16-bit value explicitly and
+   do not depend on the vector.  */
+
+/* Relocations.
+
+   R_I51_8 (6) records that one byte is relocated and nothing more.  It is
+   what every eight-bit operand got before R_I51_8_DIR and R_I51_8_IMM
+   existed, so an object built by an older assembler carries it for an
+   immediate, for a direct address, for a byte of data and for a byte
+   operand of .pcode alike.  The last two keep it: a datum has no operand
+   kind and a pcode byte is its own thing.  The linker therefore checks 6
+   as neither of the two below - it writes the low byte of whatever the
+   symbol resolved to and says nothing about the rest, which is what the
+   objects already on disk were linked by.
+
+   R_I51_R1 (1) and R_I51_R3 (2) were never emitted and relocate nothing;
+   the numbers stay reserved.
+
+   R_I51_16 (9) is a 16-bit number - MOV DPTR,#data16 or a .word - and
+   R_I51_16_CODE (14) a 16-bit code address, the target of an LJMP or an
+   LCALL.  The linker refuses a code address that names data memory.  An
+   object built before 14 existed carries 9 for both and is linked as it
+   always was.
+
+   R_I51_32 (15) is a 32-bit datum: .long, and the addresses in debugging
+   information.  */
+START_RELOC_NUMBERS (elf_i51_reloc_type)
+     RELOC_NUMBER (R_I51_NONE,			0)
+     RELOC_NUMBER (R_I51_R1,			1)
+     RELOC_NUMBER (R_I51_R3,			2)
+     RELOC_NUMBER (R_I51_7_PCREL,		3)
+     RELOC_NUMBER (R_I51_11, 			4)
+     RELOC_NUMBER (R_I51_8_BIT,			5)
+     RELOC_NUMBER (R_I51_8,			6)
+     RELOC_NUMBER (R_I51_L,			7)
+     RELOC_NUMBER (R_I51_H,			8)
+     RELOC_NUMBER (R_I51_16,			9)
+     RELOC_NUMBER (R_I51_8_B2B,			10)
+     RELOC_NUMBER (R_I51_13_PCODE,		11)
+     RELOC_NUMBER (R_I51_8_DIR,			12)
+     RELOC_NUMBER (R_I51_8_IMM,			13)
+     RELOC_NUMBER (R_I51_16_CODE,		14)
+     RELOC_NUMBER (R_I51_32,			15)
+END_RELOC_NUMBERS (R_I51_max)
+
+/* Object file flags, the e_flags field of the ELF header.
+
+   Nothing in this port reads or writes e_flags, so every object it has
+   produced carries zero there.  The low four bits are reserved now, as
+   a generation number for this target's ABI - the memory-space scheme
+   that the SHN_I51_* indices and the SHF_* codes below describe - so
+   that the field has one meaning rather than whichever meaning the
+   first tool to claim a bit gives it.  Zero means unversioned: an
+   object from before the number existed, which is every object written
+   so far.  A generation is to be stamped when the memory-space scheme
+   is next revised, and a tool that meets a generation it does not
+   implement should refuse the object rather than lay it out by rules
+   that no longer apply.  The remaining twenty-eight bits are
+   unassigned.  */
+#define EF_I51_ABI_MASK		0x0000000f
+#define EF_I51_ABI_UNVERSIONED	0
+
+#define SHF_CDATA   0xE0000000 /* Processor-specific - common data mask */
+#define SHF_REGBANK 0x20000000 /* Processor-specific - register bank */
+#define SHF_RDATA   0x40000000 /* Processor-specific - rdata */
+#define SHF_BDATA   0x60000000 /* Processor-specific - bdata */
+#define SHF_IDATA   0x80000000 /* Processor-specific - idata */
+#define SHF_XDATA   0xA0000000 /* Processor-specific - xdata */
+#define SHF_EDATA   0xC0000000 /* Processor-specific - edata */
+
+/* Section indices of the memory-space commons.  They are written to and
+   read from an object file as 0xff00..0xff06, but bfd carries a section
+   index in a 32-bit field whose reserved range starts at SHN_LORESERVE,
+   so a bare 0xff0n would be taken for an ordinary section number too
+   large for st_shndx and spilled into a .symtab_shndx table.  Naming
+   them relative to SHN_LORESERVE is what puts them in the reserved
+   range in both worlds.  */
+#define SHN_I51_REGBANK SHN_LORESERVE        /* Register bank common */
+#define SHN_I51_RDATA_C (SHN_LORESERVE + 1)  /* rdata common */
+#define SHN_I51_BDATA_C (SHN_LORESERVE + 2)  /* bdata common */
+#define SHN_I51_IDATA_C (SHN_LORESERVE + 3)  /* idata common */
+#define SHN_I51_XDATA_C (SHN_LORESERVE + 4)  /* xdata common */
+#define SHN_I51_EDATA_C (SHN_LORESERVE + 5)  /* edata common */
+#define SHN_I51_BITDATA_C (SHN_LORESERVE + 6) /* bitdata common */
+
+/* What a symbol carrying one of those indices says about itself.  It is
+   a common: nothing has placed it, and the two fields state how much
+   room it needs and how that room has to be aligned.  st_size is the
+   size, in the units of the symbol's own space - bytes everywhere but
+   SHN_I51_BITDATA_C, where the unit is a bit - and st_value is the
+   required alignment, in those same units.  That is the convention
+   SHN_COMMON follows in the gABI, and it is the one this port already
+   writes: gas records the alignment argument of .rcomm and its
+   neighbours through S_SET_ALIGN (), and where the directive names no
+   alignment bfd derives one from the size, exactly as it does for an
+   ordinary common.  st_value on such a symbol is therefore never an
+   address, and a reader must not take it for one.  */
+
+#endif /* _ELF_I51_H */
