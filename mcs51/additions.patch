+   You should have received a copy of the GNU General Public License
+   along with this program; if not, write to the Free Software
+   Foundation, Inc., 51 Franklin Street - Fifth Floor, Boston,
+   MA 02110-1301, USA.  */
+
+#ifndef _ELF_I51_H
+#define _ELF_I51_H
+
+#include "elf/reloc-macros.h"
+
+/* The machine is EM_8051 (165).  Objects are ELFDATA2MSB: everything in a
+   section is stored high byte first, as the 16-bit addresses inside the
+   instructions are; a little-endian datum is written per datum with
+   R_I51_L and R_I51_H.  */
+
+/* Relocations.  R_I51_8 is a byte, R_I51_8_DIR a direct address and
+   R_I51_8_IMM an immediate.  R_I51_16 is a sixteen-bit number and
+   R_I51_16_CODE the target of an LJMP or LCALL.  R_I51_32 is a .long or
+   an address in debugging information.  R_I51_R1 and R_I51_R3 are
+   reserved.  */
+START_RELOC_NUMBERS (elf_i51_reloc_type)
+     RELOC_NUMBER (R_I51_NONE,			0)
+     RELOC_NUMBER (R_I51_R1,			1)
+     RELOC_NUMBER (R_I51_R3,			2)
+     RELOC_NUMBER (R_I51_7_PCREL,		3)
+     RELOC_NUMBER (R_I51_11,			4)
+     RELOC_NUMBER (R_I51_8_BIT,			5)
+     RELOC_NUMBER (R_I51_8,			6)
+     RELOC_NUMBER (R_I51_L,			7)
+     RELOC_NUMBER (R_I51_H,			8)
+     RELOC_NUMBER (R_I51_16,			9)
+     RELOC_NUMBER (R_I51_8_B2B,			10)
+     RELOC_NUMBER (R_I51_13_PCODE,		11)
+     RELOC_NUMBER (R_I51_8_DIR,			12)
+     RELOC_NUMBER (R_I51_8_IMM,			13)
+     RELOC_NUMBER (R_I51_16_CODE,		14)
+     RELOC_NUMBER (R_I51_32,			15)
+END_RELOC_NUMBERS (R_I51_max)
+
+/* The low four bits of e_flags are the generation of this target's ABI.
+   In generation 0 the st_value of a memory-space common is no alignment
+   anyone asked for and is not honoured; in generation 1 it is the
+   alignment the common directive gave, 1 when it gave none.  A tool
+   refuses a generation it does not know.  */
+#define EF_I51_ABI_MASK		0x0000000f
+#define EF_I51_ABI_UNVERSIONED	0
+#define EF_I51_ABI_ALIGNED_COMMONS 1
+#define EF_I51_ABI_CURRENT	EF_I51_ABI_ALIGNED_COMMONS
+
+/* A memory-space code in the top three bits of sh_flags, compared whole
+   under SHF_I51_SPACE.  A section that carries one and has no contents
+   is a memory-space common.  The field shares bit 31 with SHF_EXCLUDE.  */
+#define SHF_I51_SPACE	0xE0000000
+#define SHF_I51_REGBANK	0x20000000	/* register bank */
+#define SHF_I51_RDATA	0x40000000	/* rdata */
+#define SHF_I51_BDATA	0x60000000	/* bdata */
+#define SHF_I51_IDATA	0x80000000	/* idata */
+#define SHF_I51_XDATA	0xA0000000	/* xdata */
+#define SHF_I51_EDATA	0xC0000000	/* edata */
+
+/* The section index of a common of each memory space, in the reserved
+   range: bfd carries st_shndx in 32 bits, so the indices are named from
+   SHN_LORESERVE rather than written as 0xff0n.  st_size is the size, in
+   bits for SHN_I51_BITDATA_C and in bytes elsewhere, and st_value the
+   alignment, as for SHN_COMMON.  */
+#define SHN_I51_REGBANK SHN_LORESERVE		/* register bank */
+#define SHN_I51_RDATA_C (SHN_LORESERVE + 1)	/* rdata */
+#define SHN_I51_BDATA_C (SHN_LORESERVE + 2)	/* bdata */
+#define SHN_I51_IDATA_C (SHN_LORESERVE + 3)	/* idata */
+#define SHN_I51_XDATA_C (SHN_LORESERVE + 4)	/* xdata */
+#define SHN_I51_EDATA_C (SHN_LORESERVE + 5)	/* edata */
+#define SHN_I51_BITDATA_C (SHN_LORESERVE + 6)	/* bitdata */
+
+/* Each memory-space common, as X (SECTION, SHNDX): the section the
+   linker collects the commons of that space in - a linker script places
+   them by this name - and the section index they carry.  */
+#define I51_COMMON_SPACES(X)			\
+  X (".regbank", SHN_I51_REGBANK)		\
+  X (".rbss",	 SHN_I51_RDATA_C)		\
+  X (".bbss",	 SHN_I51_BDATA_C)		\
+  X (".ibss",	 SHN_I51_IDATA_C)		\
+  X (".xbss",	 SHN_I51_XDATA_C)		\
+  X (".ebss",	 SHN_I51_EDATA_C)		\
+  X (".bitbss",	 SHN_I51_BITDATA_C)
+
+/* The sections of the memory-space directives, as X (SECTION, SPACE,
+   KIND): SPACE is DIRECT, INDIRECT, BIT, XDATA, EDATA or EEPROM, and KIND
+   BSS or DATA.  */
+#define I51_SPACE_SECTIONS(X)			\
+  X (".rbss",	 DIRECT,   BSS)			\
+  X (".bbss",	 DIRECT,   BSS)			\
+  X (".ibss",	 INDIRECT, BSS)			\
+  X (".xbss",	 XDATA,	   BSS)			\
+  X (".ebss",	 EDATA,	   BSS)			\
+  X (".bitbss",	 BIT,	   BSS)			\
+  X (".rdata",	 DIRECT,   DATA)		\
+  X (".bdata",	 DIRECT,   DATA)		\
+  X (".idata",	 INDIRECT, DATA)		\
+  X (".xdata",	 XDATA,	   DATA)		\
+  X (".edata",	 EDATA,	   DATA)		\
+  X (".bitdata", BIT,	   DATA)		\
+  X (".eeprom",	 EEPROM,   DATA)
+
+/* The bit address of bit BIT of the byte at BYTE, or -1 when that byte is
+   not bit addressable: the RAM bytes 0x20..0x2f and the special function
+   registers at a multiple of eight in 0x80..0xf8.  */
+
+static inline long
+i51_bit_address (long byte, long bit)
+{
+  if (bit < 0 || bit > 7)
+    return -1;
+  if (byte >= 0x20 && byte <= 0x2f)
+    return (byte - 0x20) * 8 + bit;
+  if (byte >= 0x80 && byte <= 0xf8 && (byte & 7) == 0)
+    return byte + bit;
+  return -1;
+}
+
+/* The two bytes of an ACALL or AJMP of OPCODE to TARGET: A10..A8 in the
+   top bits of the opcode byte, A7..A0 in the next.  */
+
+static inline unsigned int
+i51_addr11_insn (unsigned int opcode, unsigned long target)
+{
+  return (opcode << 8) | ((target & 0x700) << 5) | (target & 0xff);
+}
+
+/* The execution address of a .pcode entry: thirteen bits under three
+   flags.  */
+#define I51_PCODE_ADDR_MIN	0x100
+#define I51_PCODE_ADDR_MASK	0x1fff
+#define I51_PCODE_FLAGS_MASK	0xe000
+
+#endif /* _ELF_I51_H */
