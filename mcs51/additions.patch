+  P - DPTR
+  @ - @A+DPTR
+  X - @A+PC
+  I - @R0, @R1
+  J - jump rel
+  / - /C
+  T - @DPTR
+  # - #data
+  d - data16
+  1 - jump addr 11
+  6 - jump addr 16
