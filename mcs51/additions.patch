diff --git a/ld/scripttempl/elf32i51.sc b/ld/scripttempl/elf32i51.sc
new file mode 100644
index 00000000..fbe9a587
--- /dev/null
+++ b/ld/scripttempl/elf32i51.sc
@@ -0,0 +1,249 @@
+# Copyright (C) 2014-2025 Free Software Foundation, Inc.
+#
+# Copying and distribution of this file, with or without modification,
+# are permitted in any medium without royalty provided the copyright
+# notice and this notice are preserved.
+#
+# Default linker script for the Intel MCS-51 (8051).
+#
+# The 8051 is a Harvard machine with several disjoint address spaces:
+# code, directly addressed internal RAM, indirectly addressed internal
+# RAM, the bit space, external RAM (xdata, edata) and EEPROM.  The
+# relocations of this port (R_I51_8_B2B in particular) need every RAM
+# symbol to carry its true on-chip address, so the spaces cannot be
+# spread over disjoint VMA windows of one flat address space.  Instead
+# only the code sections are allocated; every RAM space is emitted as a
+# non-alloc (INFO) section whose VMA is the real address inside its own
+# space.  Sections of different spaces may then share VMA ranges without
+# tripping the linker's overlap check, and objcopy -O ihex/binary
+# extracts just the code image.
+
+test -z "${RELOCATING}" && exit 0
+
+cat <<EOF
+/* Copyright (C) 2014-2025 Free Software Foundation, Inc.
+
+   Copying and distribution of this script, with or without modification,
+   are permitted in any medium without royalty provided the copyright
+   notice and this notice are preserved.  */
+
+OUTPUT_FORMAT("${OUTPUT_FORMAT}")
+OUTPUT_ARCH(${ARCH})
+
+/* The assembler folds every symbol to upper case, so upper-case names
+   are the only ones object code can actually refer to.  Every symbol
+   this script defines for use from code is therefore upper-case.  */
+ENTRY(_START)
+
+MEMORY
+{
+  /* Code space.  64K is the architectural limit; the smaller ROM of a
+     concrete chip is a property of that chip, not of this script.  */
+  rom (rx) : ORIGIN = 0x0000, LENGTH = 0x10000
+}
+
+SECTIONS
+{
+  /* ----------------------------------------------------- code space */
+  .text :
+  {
+    PROVIDE (_START = .);
+    KEEP (*(.vectors))
+    KEEP (*(vectors))
+    *(.init)
+    *(.init.*)
+    *(.text)
+    *(.text.*)
+    *(.gnu.linkonce.t.*)
+    *(.rodata)
+    *(.rodata.*)
+    *(.gnu.linkonce.r.*)
+    *(.fini)
+    *(.fini.*)
+
+    /* Default target for the startup hooks below: a single RET.  */
+    __I51_RET = .;
+    BYTE(0x22)
+    _ETEXT = .;
+  } > rom
+
+  /* Startup hooks called by compiler run-time startup code.  When the
+     program leaves one undefined it binds to the RET above, so calling
+     it is a no-op instead of a jump into the reset vector.  */
+  PROVIDE (__GSINIT_STARTUP = __I51_RET);
+  PROVIDE (__EXTERNAL_STARTUP = __I51_RET);
+  PROVIDE (__INIT_DATA = __I51_RET);
+
+  /* -------------------- directly addressed internal RAM, 0x00-0xFF */
+  /* Register banks and register-area data sit at 0x00.  */
+  .regbank 0x00 (INFO) :
+  {
+    /* The assignment also pins the section: a section with a symbol
+       assignment keeps its address statement even when empty.  */
+    __REGBANK_START = .;
+    *(.regbank)
+  }
+  .rdata (ADDR (.regbank) + SIZEOF (.regbank)) (INFO) :
+  {
+    __RDATA_START = .;
+    *(.rdata)
+    *(.rdata.*)
+  }
+  .rbss (ADDR (.rdata) + SIZEOF (.rdata)) (INFO) :
+  {
+    *(.rbss)
+    *(.rbss.*)
+    __RDATA_END = .;
+  }
+
+  /* Bit-addressable bytes, 0x20-0x2F.  */
+  .bdata MAX (0x20, ADDR (.rbss) + SIZEOF (.rbss)) (INFO) :
+  {
+    __BDATA_START = .;
+    *(.bdata)
+    *(.bdata.*)
+  }
+  .bbss (ADDR (.bdata) + SIZEOF (.bdata)) (INFO) :
+  {
+    *(.bbss)
+    *(.bbss.*)
+    __BDATA_END = .;
+  }
+
+  /* ------------------------------------------------------ bit space */
+  /* Addresses here are bit numbers.  Named bits are carved out of the
+     bit-addressable bytes right after .bbss: byte 0x20+n carries the
+     bits 8n..8n+7.  */
+  .bit ((ADDR (.bbss) + SIZEOF (.bbss) - 0x20) * 8) (INFO) :
+  {
+    __BIT_START = .;
+    *(.bitdata)
+    *(.bitdata.*)
+  }
+  .bitbss (ADDR (.bit) + SIZEOF (.bit)) (INFO) :
+  {
+    *(.bitbss)
+    *(.bitbss.*)
+    __BIT_END = .;
+  }
+
+  /* ------------------- rest of the directly addressed internal RAM */
+  /* Resumes after the bytes the bit sections consumed.  */
+  .data (ADDR (.bbss) + SIZEOF (.bbss) + (SIZEOF (.bit) + SIZEOF (.bitbss) + 7) / 8) (INFO) :
+  {
+    __DATA_START = .;
+    *(.data)
+    *(.data.*)
+    *(.gnu.linkonce.d.*)
+  }
+  .bss (ADDR (.data) + SIZEOF (.data)) (INFO) :
+  {
+    *(.bss)
+    *(.bss.*)
+    *(COMMON)
+    __DATA_END = .;
+  }
+
+  /* ----------------------- indirectly addressed internal RAM */
+  /* The same physical RAM continues; above 0x7F it is reachable only
+     through @R0/@R1, so indirect data simply follows the direct data
+     in one allocation arena.  */
+  .idata (ADDR (.bss) + SIZEOF (.bss)) (INFO) :
+  {
+    __IDATA_START = .;
+    *(.idata)
+    *(.idata.*)
+  }
+  .ibss (ADDR (.idata) + SIZEOF (.idata)) (INFO) :
+  {
+    *(.ibss)
+    *(.ibss.*)
+    __IDATA_END = .;
+  }
+
+  /* First free internal RAM byte: bottom of the upward-growing stack. */
+  PROVIDE (STACK = __IDATA_END);
+  PROVIDE (__STACK = STACK);
+
+  /* --------------------------- external RAM (xdata), 0x0000-0xFFFF */
+  .xdata 0x0000 (INFO) :
+  {
+    __XDATA_START = .;
+    *(.xdata)
+    *(.xdata.*)
+  }
+  .xbss (ADDR (.xdata) + SIZEOF (.xdata)) (INFO) :
+  {
+    *(.xbss)
+    *(.xbss.*)
+    __XDATA_END = .;
+  }
+
+  /* ------------------------------- second external space (edata) */
+  .edata 0x0000 (INFO) :
+  {
+    __EDATA_START = .;
+    *(.edata)
+    *(.edata.*)
+  }
+  .ebss (ADDR (.edata) + SIZEOF (.edata)) (INFO) :
+  {
+    *(.ebss)
+    *(.ebss.*)
+    __EDATA_END = .;
+  }
+
+  /* --------------------------------------------------------- EEPROM */
+  .eeprom 0x0000 (INFO) :
+  {
+    __EEPROM_START = .;
+    *(.eeprom)
+    *(.eeprom.*)
+    __EEPROM_END = .;
+  }
+
+  /* Space limits.  Code size is bounded by the rom region above.  */
+  ASSERT (__IDATA_END <= 0x100, "internal RAM overflow (past 0xFF)")
+  ASSERT (SIZEOF (.bdata) + SIZEOF (.bbss) == 0 || __BDATA_END <= 0x30,
+          "bit-addressable data overflow (past 0x2F)")
+  ASSERT (SIZEOF (.bit) + SIZEOF (.bitbss) == 0
+          || (__BIT_END <= 0x80 && ADDR (.data) <= 0x30),
+          "bit space overflow (past bit 0x7F)")
+  ASSERT (__XDATA_END <= 0x10000, "xdata overflow (past 0xFFFF)")
+  ASSERT (__EDATA_END <= 0x10000, "edata overflow (past 0xFFFF)")
+
+  /* Stabs debugging sections */
+  .stab          0 : { *(.stab) }
+  .stabstr       0 : { *(.stabstr) }
+  .stab.excl     0 : { *(.stab.excl) }
+  .stab.exclstr  0 : { *(.stab.exclstr) }
+  .stab.index    0 : { *(.stab.index) }
+  .stab.indexstr 0 : { *(.stab.indexstr) }
+  .comment       0 : { *(.comment) }
+
+  /* DWARF debug sections */
+  .debug          0 : { *(.debug) }
+  .line           0 : { *(.line) }
+  .debug_srcinfo  0 : { *(.debug_srcinfo) }
+  .debug_sfnames  0 : { *(.debug_sfnames) }
+  .debug_aranges  0 : { *(.debug_aranges) }
+  .debug_pubnames 0 : { *(.debug_pubnames) }
+  .debug_info     0 : { *(.debug_info .gnu.linkonce.wi.*) }
+  .debug_abbrev   0 : { *(.debug_abbrev) }
+  .debug_line     0 : { *(.debug_line .debug_line.* .debug_line_end ) }
+  .debug_frame    0 : { *(.debug_frame) }
+  .debug_str      0 : { *(.debug_str) }
+  .debug_loc      0 : { *(.debug_loc) }
+  .debug_macinfo  0 : { *(.debug_macinfo) }
+  .debug_weaknames 0 : { *(.debug_weaknames) }
+  .debug_funcnames 0 : { *(.debug_funcnames) }
+  .debug_typenames 0 : { *(.debug_typenames) }
+  .debug_varnames  0 : { *(.debug_varnames) }
+  .debug_pubtypes 0 : { *(.debug_pubtypes) }
+  .debug_ranges   0 : { *(.debug_ranges) }
+  .debug_macro    0 : { *(.debug_macro) }
+
+  /* Discard standard sections not used in embedded systems */
+  /DISCARD/ : { *(.note.GNU-stack) *(.gnu_debuglink) *(.gnu.lto_*) }
+}
+EOF
diff --git a/opcodes/i51-dis.c b/opcodes/i51-dis.c
new file mode 100644
index 00000000..c035f4ab
--- /dev/null
+++ b/opcodes/i51-dis.c
@@ -0,0 +1,395 @@
+/* Disassemble MCS-51 instructions.
+   Copyright 2001 Free Software Foundation, Inc.
+
+   Contributed by Radek Benedikt <benedikt@lphard.cz>
+
+This program is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 2 of the License, or
+(at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+You should have received a copy of the GNU General Public License
+along with this program; if not, write to the Free Software
+Foundation, Inc., 59 Temple Place - Suite 330, Boston, MA 02111-1307, USA.  */
+
+#include "sysdep.h"
+#include <assert.h>
+#include "dis-asm.h"
+#include "disassemble.h"
+#include "opintl.h"
+
+
+struct i51_opcodes_s
+{
+  const char *name;
+  const char *args;
+  int insn_size;		/* in bytes */
+  unsigned char bin_opcode;
+  unsigned char bin_mask;
+};
+
+#define I51_INS(NAME, ARGS, SIZE, OPCODE, MRELOC, BIN, MASK) \
+{NAME, ARGS, SIZE, BIN, MASK},
+
+static struct i51_opcodes_s i51_opcodes[] =
+{
+  #include "opcode/i51.h"
+  {NULL, NULL, 0, 0, 0}
+};
+
+static int
+i51dis_opcode (bfd_vma addr, disassemble_info *info)
+{
+  bfd_byte buffer[1];
+  int status;
+  status = info->read_memory_func(addr, buffer, 1, info);
+  if (status != 0)
+    {
+      info->memory_error_func(status, addr, info);
+      return -1;
+    }
+  return buffer[0];
+}
+
+static int
+i51dis_op16 (bfd_vma addr, disassemble_info *info)
+{
+  bfd_byte buffer[2];
+  int status;
+  status = info->read_memory_func(addr, buffer, 2, info);
+  if (status != 0)
+    {
+      info->memory_error_func(status, addr, info);
+      return -1;
+    }
+  return bfd_getb16(buffer);
+}
+
+/* Which symbols may name an address in disassembly.
+
+   The MCS-51 has five address spaces that all start at zero, and a
+   symbol carries no note of which one it belongs to beyond the section
+   it sits in.  A consumer looking for the symbol nearest a code address
+   will therefore find SFR equates - ACC, P1, TCON, thousands of them,
+   all absolute and all below 0x100 - and data symbols from IDATA, XDATA,
+   the bit space and the EEPROM image, and name a subroutine after one of
+   them.  While a section carrying code is being disassembled, only a
+   symbol from a section carrying code may name an address in it.
+
+   Elsewhere - `objdump -D' walking .rbss, .xbss and the rest - every
+   symbol is let through again, so those sections keep their labels.  */
+
+bool
+i51_symbol_is_valid (asymbol *sym, struct disassemble_info *info)
+{
+  if (sym == NULL || sym->section == NULL)
+    return false;
+
+  if (info == NULL
+      || info->section == NULL
+      || (info->section->flags & SEC_CODE) == 0)
+    return true;
+
+  /* An absolute symbol belongs to no space at all.  */
+  if (bfd_is_abs_section (sym->section))
+    return false;
+
+  return (sym->section->flags & SEC_CODE) != 0;
+}
+
+/* The style an operand string is printed in.  The operand syntax is
+   self-describing: `#' starts an immediate, `0x' a direct byte or bit
+   address, `.' a branch displacement, `/' a complemented bit address,
+   and everything else names a register - A, AB, C, DPTR, R0..R7, @R0,
+   @DPTR, @A+DPTR, @A+PC.  */
+
+static enum disassembler_style
+i51_operand_style (const char *op)
+{
+  switch (op[0])
+    {
+    case '#':	return dis_style_immediate;
+    case '.':	return dis_style_address_offset;
+    case '/':	return dis_style_address;
+    case '0':	return dis_style_address;
+    default:	return dis_style_register;
+    }
+}
+
+int
+print_insn_i51 (bfd_vma addr, disassemble_info *info)
+{
+  int insn;
+  int opdata;
+  int disp;
+  int rel_addr;
+  struct i51_opcodes_s *opcode;
+  void *stream = info->stream;
+  fprintf_styled_ftype prin = info->fprintf_styled_func;
+  int ok = 0;
+  int offset = 0;
+  char op1[16], op2[16], op3[16], comment1[40], comment2[40];
+  int inslen = 1;
+  /* An absolute code address in op1 is handed to print_address_func so
+     the consumer can name it: `lcall 0x1a <helper>'.  The string built
+     in op1 is the fallback for a consumer that supplies no such hook.  */
+  bfd_vma code_target = 0;
+  int op1_is_code_addr = 0;
+
+  insn = i51dis_opcode (addr, info);
+  if (insn < 0)
+    return -1;
+  addr++;  
+  for (opcode = i51_opcodes; opcode->name; opcode++)
+    {
+      if ((insn & opcode->bin_mask) == opcode->bin_opcode)
+	break;
+    }
+  
+  op1[0] = 0;
+  op2[0] = 0;
+  op3[0] = 0;
+  comment1[0] = 0;
+  comment2[0] = 0;
+
+  if (opcode->name)
+    {
+      inslen = (opcode->insn_size) & 0x03;
+      ok = 1;
+      switch (opcode->args[0]) {
+	case 'N':	//none
+	  break;
+	case 'A':	//A reg
+	  sprintf (op1,"A");
+	  break;
+	case 'C':	//AB reg
+	  sprintf (op1,"AB");
+	  break;
+	case 'r':	//C reg
+	  sprintf (op1,"C");
+	  break;
+	case 'P':	//DPTR
+	  sprintf (op1,"DPTR");
+	  break;
+	case '@':	//@A+DPTR
+	  sprintf (op1,"@A+DPTR");
+	  break;
+	case 'T':	//@DPTR
+	  sprintf (op1,"@DPTR");
+	  break;
+	case 'D':	//data
+	case 'B':	//bit
+	  opdata = i51dis_opcode (addr, info);
+	  if (opdata < 0)
+	    return -1;
+	  addr++;
+	  offset++;
+	  sprintf (op1,"0x%02X",opdata);
+	  break;
+	case 'R':	//R0..R7
+	  sprintf (op1,"R%c",(insn&0x07)+'0');
+	  break;
+	case 'I':	//@R0, @R1
+	  sprintf (op1,"@R%c",(insn&0x01)+'0');
+	  break;
+	case 'J':	//jump rel
+	  opdata = i51dis_opcode (addr, info);
+	  if (opdata < 0)
+	    return -1;
+	  addr++;
+	  /* Sign-extend the encoded displacement before deciding its sign:
+	     testing bit 7 of (displacement + insn length) turns the largest
+	     forward branches into backward ones.  */
+	  disp = ((opdata ^ 0x80) & 0xFF) - 0x80;
+	  rel_addr = disp + 2;
+	  if (rel_addr < 0)
+	    sprintf (op1,".-0x%02X",-rel_addr);
+	  else
+	    sprintf (op1,".+0x%02X",rel_addr);
+	  sprintf (comment1, "0x%04lX",
+		   (unsigned long) ((addr + disp) & 0xFFFF));
+	  break;
+	case '1':	//jump addr 11
+	  opdata = i51dis_opcode (addr, info);
+	  if (opdata < 0)
+	    return -1;
+	  addr++;
+	  code_target = (addr & 0xF800) + (((insn >> 5) & 0x07) << 8) + opdata;
+	  op1_is_code_addr = 1;
+	  sprintf (op1,"0x%04lX", (unsigned long) code_target);
+	  break;
+	case '6':	//jump addr 16
+	  opdata = i51dis_op16 (addr, info);
+	  if (opdata < 0)
+	    return -1;
+	  addr += 2;
+	  code_target = (bfd_vma) (unsigned) opdata;
+	  op1_is_code_addr = 1;
+	  sprintf (op1,"0x%04X",(unsigned) opdata);
+	  break;
+      }
+      switch (opcode->args[1]) {
+	case 'N':	//none
+	  break;
+	case 'A':	//A reg
+	  sprintf (op2,"A");
+	  break;
+	case 'r':	//C reg
+	  sprintf (op2,"C");
+	  break;
+	case '@':	//@A+DPTR
+	  sprintf (op2,"@A+DPTR");
+	  break;
+	case 'X':	//@A+PC
+	  sprintf (op2,"@A+PC");
+	  break;
+	case '/':	// /bit
+	  opdata = i51dis_opcode (addr, info);
+	  if (opdata < 0)
+	    return -1;
+	  addr++;
+	  offset++;
+	  sprintf (op2,"/0x%02X",opdata);
+	  break;
+	case 'T':	//@DPTR
+	  sprintf (op2,"@DPTR");
+	  break;
+	case 'B':	//bit
+	case 'D':	//data
+	  opdata = i51dis_opcode (addr, info);
+	  if (opdata < 0)
+	    return -1;
+	  addr++;
+	  offset++;
+	  sprintf (op2,"0x%02X",opdata);
+	  /* MOV direct,direct (0x85) is the one insn that encodes the
+	     source byte first, so the operands come out swapped.  */
+	  if (opcode->args[0] == 'D')
+	    {
+	      char tmp[16];
+	      strcpy (tmp, op1);
+	      strcpy (op1, op2);
+	      strcpy (op2, tmp);
+	    }
+	  break;
+	case 'R':	//R0..R7
+	  sprintf (op2,"R%c",(insn&0x07)+'0');
+	  break;
+	case 'I':	//@R0, @R1
+	  sprintf (op2,"@R%c",(insn&0x01)+'0');
+	  break;
+	case 'J':	//jump rel
+	  opdata = i51dis_opcode (addr, info);
+	  if (opdata < 0)
+	    return -1;
+	  addr++;
+	  /* Sign-extend the encoded displacement before deciding its sign:
+	     testing bit 7 of (displacement + insn length) turns the largest
+	     forward branches into backward ones.  */
+	  disp = ((opdata ^ 0x80) & 0xFF) - 0x80;
+	  rel_addr = disp + 2+offset;
+	  if (rel_addr < 0)
+	    sprintf (op2,".-0x%02X",-rel_addr);
+	  else
+	    sprintf (op2,".+0x%02X",rel_addr);
+	  sprintf (comment1, "0x%04lX",
+		   (unsigned long) ((addr + disp) & 0xFFFF));
+	  break;
+	case '#':	//#data
+	  if(opcode->args[0] == 'P') {
+	    opdata = i51dis_op16 (addr, info);
+	    if (opdata < 0)
+	      return -1;
+	    addr+=2;
+	    sprintf (op2,"#0x%04X",(unsigned) opdata);
+	  } else {
+	    opdata = i51dis_opcode (addr, info);
+	    if (opdata < 0)
+	      return -1;
+	    addr++;
+	    offset++;
+	    sprintf (op2,"#0x%02X",opdata);
+	    if ((opdata >= ' ') && (opdata < 0x7F)) {
+	      sprintf (comment1, "#%u\t#'%c'", opdata, opdata);
+	    } else {
+	      sprintf (comment1, "#%u", opdata);
+	    }
+	  }
+	  break;
+      }
+      switch (opcode->args[2]) {
+	case 'N':	//none
+	  break;
+	case 'J':	//jump rel
+	  opdata = i51dis_opcode (addr, info);
+	  if (opdata < 0)
+	    return -1;
+	  addr++;
+	  /* Sign-extend the encoded displacement before deciding its sign:
+	     testing bit 7 of (displacement + insn length) turns the largest
+	     forward branches into backward ones.  */
+	  disp = ((opdata ^ 0x80) & 0xFF) - 0x80;
+	  rel_addr = disp + 2+offset;
+	  if (rel_addr < 0)
+	    sprintf (op3,".-0x%02X",-rel_addr);
+	  else
+	    sprintf (op3,".+0x%02X",rel_addr);
+	  sprintf (comment1, "0x%04lX",
+		   (unsigned long) ((addr + disp) & 0xFFFF));
+	  break;
+      }
+    }
+
+  if (!ok)
+    {
+      /* Unknown opcode, or invalid combination of operands.  */
+      sprintf (op1, "0x%02X", insn);
+      sprintf (comment1, "????");
+      comment2[0] = 0;
+      op1_is_code_addr = 0;
+    }
+
+  (*prin) (stream, ok ? dis_style_mnemonic : dis_style_assembler_directive,
+	   "%s", ok ? opcode->name : ".byte");
+
+  if (*op1)
+    {
+      (*prin) (stream, dis_style_text, "\t");
+      /* An absolute code address goes through print_address_func, which
+	 is what lets a consumer print the symbol it lands on.  Older
+	 callers may leave the hook unset, so fall back to the string.  */
+      if (op1_is_code_addr && info->print_address_func != NULL)
+	(*info->print_address_func) (code_target, info);
+      else
+	(*prin) (stream, i51_operand_style (op1), "%s", op1);
+    }
+
+  if (*op2)
+    {
+      (*prin) (stream, dis_style_text, ", ");
+      (*prin) (stream, i51_operand_style (op2), "%s", op2);
+    }
+
+  if (*op3)
+    {
+      (*prin) (stream, dis_style_text, ", ");
+      (*prin) (stream, i51_operand_style (op3), "%s", op3);
+    }
+
+  if (*comment1) {
+    if (*op2)
+      (*prin) (stream, dis_style_comment_start, "\t; %s", comment1);
+    else
+      (*prin) (stream, dis_style_comment_start, "\t\t; %s", comment1);
+  }
+
+  if (*comment2)
+    (*prin) (stream, dis_style_comment_start, " %s", comment2);
+
+  return inslen;
+}
