diff --git a/ld/scripttempl/elf32i51.sc b/ld/scripttempl/elf32i51.sc
new file mode 100644
index 00000000..925bbfb8
--- /dev/null
+++ b/ld/scripttempl/elf32i51.sc
@@ -0,0 +1,278 @@
+# Copyright (C) 2014-2026 Free Software Foundation, Inc.
+#
+# Copying and distribution of this file, with or without modification,
+# are permitted in any medium without royalty provided the copyright
+# notice and this notice are preserved.
+#
+# Default linker script for the Intel MCS-51 (8051).
+#
+# The 8051 is a Harvard machine with several disjoint address spaces:
+# code, directly addressed internal RAM, indirectly addressed internal
+# RAM, the bit space, external RAM (xdata, edata) and EEPROM.  A RAM
+# symbol has its address inside its own space, so only the code sections
+# are allocated; every other space is a non-alloc (INFO) section whose
+# VMA is that address.  Sections of different spaces may then share VMA
+# ranges, and objcopy -O ihex/binary extracts the code image.
+
+if test -z "${RELOCATING}"; then
+  cat <<EOF
+OUTPUT_FORMAT("${OUTPUT_FORMAT}")
+OUTPUT_ARCH(${ARCH})
+
+SECTIONS
+{
+  .text		0 : { *(.text) }
+  .regbank	0 : { *(.regbank) }
+  .rdata	0 : { *(.rdata) }
+  .rbss		0 : { *(.rbss) }
+  .bdata	0 : { *(.bdata) }
+  .bbss		0 : { *(.bbss) }
+  .bitdata	0 : { *(.bitdata) }
+  .bitbss	0 : { *(.bitbss) }
+  .data		0 : { *(.data) }
+  .bss		0 : { *(.bss) }
+  .idata	0 : { *(.idata) }
+  .ibss		0 : { *(.ibss) }
+  .xdata	0 : { *(.xdata) }
+  .xbss		0 : { *(.xbss) }
+  .edata	0 : { *(.edata) }
+  .ebss		0 : { *(.ebss) }
+  .eeprom	0 : { *(.eeprom) }
+EOF
+  source_sh $srcdir/scripttempl/misc-sections.sc
+  source_sh $srcdir/scripttempl/DWARF.sc
+  echo "}"
+  exit 0
+fi
+
+cat <<EOF
+/* Copyright (C) 2014-2026 Free Software Foundation, Inc.
+
+   Copying and distribution of this script, with or without modification,
+   are permitted in any medium without royalty provided the copyright
+   notice and this notice are preserved.  */
+
+OUTPUT_FORMAT("${OUTPUT_FORMAT}")
+OUTPUT_ARCH(${ARCH})
+
+/* The assembler folds every symbol to upper case, so upper-case names
+   are the only ones object code can actually refer to.  Every symbol
+   this script defines for use from code is therefore upper-case.  */
+ENTRY(_START)
+
+MEMORY
+{
+  /* Code space.  64K is the architectural limit; the smaller ROM of a
+     concrete chip is a property of that chip, not of this script.  */
+  rom (rx) : ORIGIN = 0x0000, LENGTH = 0x10000
+}
+
+SECTIONS
+{
+  /* ----------------------------------------------------- code space */
+  .text :
+  {
+    PROVIDE (_START = .);
+    KEEP (*(.vectors))
+    KEEP (*(vectors))
+    *(.init)
+    *(.init.*)
+    *(.text)
+    *(.text.*)
+    *(.gnu.linkonce.t.*)
+    *(.rodata)
+    *(.rodata.*)
+    *(.gnu.linkonce.r.*)
+    *(.fini)
+    *(.fini.*)
+
+    /* Default target for the startup hooks below: a single RET.  */
+    __I51_RET = .;
+    BYTE(0x22)
+    _ETEXT = .;
+  } > rom
+
+  /* Startup hooks called by compiler run-time startup code.  When the
+     program leaves one undefined it binds to the RET above, so calling
+     it is a no-op instead of a jump into the reset vector.
+
+     Each hook is provided under both spellings of its name.  This
+     assembler folds every symbol to upper case, so an object it built
+     carries the upper-case name; a producer that does not fold - a C
+     compiler, or an object written by another tool - leaves the name
+     lower case, and a PROVIDE of the upper-case name alone would never
+     bind it.  The reference would then stay undefined, and the call
+     would go wherever the link left it rather than to the RET.  */
+  PROVIDE (__GSINIT_STARTUP = __I51_RET);
+  PROVIDE (__gsinit_startup = __I51_RET);
+  PROVIDE (__EXTERNAL_STARTUP = __I51_RET);
+  PROVIDE (__external_startup = __I51_RET);
+  PROVIDE (__INIT_DATA = __I51_RET);
+  PROVIDE (__init_data = __I51_RET);
+
+  /* -------------------- directly addressed internal RAM, 0x00-0xFF */
+  /* Register banks and register-area data sit at 0x00.  */
+  .regbank 0x00 (INFO) :
+  {
+    /* The assignment also pins the section: a section with a symbol
+       assignment keeps its address statement even when empty.  */
+    __REGBANK_START = .;
+    *(.regbank)
+    /* Bank 0 is the one in use from reset, whether or not a file says
+       .using, so its eight registers are always reserved; .using in a
+       file reserves up to the highest bank it selects.  */
+    . = MAX (., 0x08);
+  }
+  .rdata (ADDR (.regbank) + SIZEOF (.regbank)) (INFO) :
+  {
+    __RDATA_START = .;
+    *(.rdata)
+    *(.rdata.*)
+  }
+  .rbss (ADDR (.rdata) + SIZEOF (.rdata)) (INFO) :
+  {
+    *(.rbss)
+    *(.rbss.*)
+    __RDATA_END = .;
+  }
+
+  /* Bit-addressable bytes, 0x20-0x2F.  */
+  .bdata MAX (0x20, ADDR (.rbss) + SIZEOF (.rbss)) (INFO) :
+  {
+    __BDATA_START = .;
+    *(.bdata)
+    *(.bdata.*)
+  }
+  .bbss (ADDR (.bdata) + SIZEOF (.bdata)) (INFO) :
+  {
+    *(.bbss)
+    *(.bbss.*)
+    __BDATA_END = .;
+  }
+
+  /* ------------------------------------------------------ bit space */
+  /* Addresses here are bit numbers.  Named bits are carved out of the
+     bit-addressable bytes right after .bbss: byte 0x20+n carries the
+     bits 8n..8n+7.  */
+  .bit ((ADDR (.bbss) + SIZEOF (.bbss) - 0x20) * 8) (INFO) :
+  {
+    __BIT_START = .;
+    *(.bitdata)
+    *(.bitdata.*)
+  }
+  .bitbss (ADDR (.bit) + SIZEOF (.bit)) (INFO) :
+  {
+    *(.bitbss)
+    *(.bitbss.*)
+    __BIT_END = .;
+  }
+
+  /* ------------------- rest of the directly addressed internal RAM */
+  /* Resumes after the bytes the bit sections consumed.  */
+  .data (ADDR (.bbss) + SIZEOF (.bbss)
+         + (SIZEOF (.bit) + SIZEOF (.bitbss) + 7) / 8) (INFO) :
+  {
+    __DATA_START = .;
+    *(.data)
+    *(.data.*)
+    *(.gnu.linkonce.d.*)
+  }
+  .bss (ADDR (.data) + SIZEOF (.data)) (INFO) :
+  {
+    *(.bss)
+    *(.bss.*)
+    *(COMMON)
+    __DATA_END = .;
+  }
+
+  /* ----------------------- indirectly addressed internal RAM */
+  /* The same physical RAM continues; above 0x7F it is reachable only
+     through @R0/@R1, so indirect data simply follows the direct data
+     in one allocation arena.  */
+  .idata (ADDR (.bss) + SIZEOF (.bss)) (INFO) :
+  {
+    __IDATA_START = .;
+    *(.idata)
+    *(.idata.*)
+  }
+  .ibss (ADDR (.idata) + SIZEOF (.idata)) (INFO) :
+  {
+    *(.ibss)
+    *(.ibss.*)
+    __IDATA_END = .;
+  }
+
+  /* First free internal RAM byte: bottom of the upward-growing stack.
+     __STACK_SIZE bytes of internal RAM are kept free for it, and
+     __IRAM_SIZE is the size of the internal RAM: 0x100 on an 8052, 0x80
+     on an 8051 - give the part's size with --defsym.  */
+  PROVIDE (STACK = __IDATA_END);
+  PROVIDE (__STACK = STACK);
+  PROVIDE (__STACK_SIZE = 0x10);
+  PROVIDE (__IRAM_SIZE = 0x100);
+  PROVIDE (__EEPROM_SIZE = 0x10000);
+
+  /* --------------------------- external RAM (xdata), 0x0000-0xFFFF */
+  .xdata 0x0000 (INFO) :
+  {
+    __XDATA_START = .;
+    *(.xdata)
+    *(.xdata.*)
+  }
+  .xbss (ADDR (.xdata) + SIZEOF (.xdata)) (INFO) :
+  {
+    *(.xbss)
+    *(.xbss.*)
+    __XDATA_END = .;
+  }
+
+  /* ------------------------------- second external space (edata) */
+  .edata 0x0000 (INFO) :
+  {
+    __EDATA_START = .;
+    *(.edata)
+    *(.edata.*)
+  }
+  .ebss (ADDR (.edata) + SIZEOF (.edata)) (INFO) :
+  {
+    *(.ebss)
+    *(.ebss.*)
+    __EDATA_END = .;
+  }
+
+  /* --------------------------------------------------------- EEPROM */
+  .eeprom 0x0000 (INFO) :
+  {
+    __EEPROM_START = .;
+    *(.eeprom)
+    *(.eeprom.*)
+    __EEPROM_END = .;
+  }
+
+  /* Space limits.  Code size is bounded by the rom region above.  */
+  ASSERT (__DATA_END <= 0x80,
+          "directly addressed RAM overflow (.data and .bss past 0x7F)")
+  ASSERT (__IDATA_END <= __IRAM_SIZE, "internal RAM overflow")
+  ASSERT (STACK + __STACK_SIZE <= __IRAM_SIZE,
+          "no room for __STACK_SIZE bytes of stack in internal RAM")
+  ASSERT (SIZEOF (.bdata) + SIZEOF (.bbss) == 0 || __BDATA_END <= 0x30,
+          "bit-addressable data overflow (past 0x2F)")
+  ASSERT (SIZEOF (.bit) + SIZEOF (.bitbss) == 0
+          || (__BIT_END <= 0x80 && ADDR (.data) <= 0x30),
+          "bit space overflow (past bit 0x7F)")
+  ASSERT (__XDATA_END <= 0x10000, "xdata overflow (past 0xFFFF)")
+  ASSERT (__EDATA_END <= 0x10000, "edata overflow (past 0xFFFF)")
+  ASSERT (__EEPROM_END <= __EEPROM_SIZE,
+          "EEPROM overflow (past __EEPROM_SIZE)")
+
+EOF
+
+source_sh $srcdir/scripttempl/misc-sections.sc
+source_sh $srcdir/scripttempl/DWARF.sc
+
+cat <<EOF
+
+  /* Discard standard sections not used in embedded systems */
+  /DISCARD/ : { *(.note.GNU-stack) *(.gnu_debuglink) *(.gnu.lto_*) }
+}
+EOF
