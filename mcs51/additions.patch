+  { "B.3",      'B', 0xF3, I51_MCU_ALL },
+  { "B.4",      'B', 0xF4, I51_MCU_ALL },
+  { "B.5",      'B', 0xF5, I51_MCU_ALL },
+  { "B.6",      'B', 0xF6, I51_MCU_ALL },
+  { "B.7",      'B', 0xF7, I51_MCU_ALL },
+  { NULL, 0, 0, 0 }
+};
+
+static htab_t i51_opcode_hash;
+static htab_t i51_name_hash;
+
+/* Where the source first used a name as a built-in name, or a name
+   NAME.N as bit N of NAME, which a symbol of that name defined later
+   would contradict.  */
+struct i51_name_use
+{
+  const char *file;
+  unsigned int line;
+  bool bit;
+};
+static htab_t i51_names_used;
+static struct i51_name_use *i51_name_use (const char *);
+
+/* Where each memory-space common was declared, and in which space.  */
+struct i51_common_decl
+{
+  const char *file;
+  unsigned int line;
+  int space;
+};
+static htab_t i51_common_decls;
+
+/* The __RB__ common the assembler made, and whether a definition of the
+   name by the program was reported where it was made.  */
+static symbolS *i51_rb_symbol;
+static bool i51_rb_reported;
+
+static void i51_check_common (symbolS *);
+
+/* The register bank of the last .using in this file, -1 before the first,
+   and the highest bank any .using of the assembly selected.  */
+static int i51_regbank = -1;
+static int i51_regbank_max = -1;
+
+/* HIGH (x), LOW (x) and B2B (x, n) are operators of the expression
+   language.  With a constant operand they fold to a constant.  Otherwise
+   the expression keeps the operator, its operand in X_add_symbol and
+   X_add_number as an O_symbol would and B2B's bit number in X_md, and the
+   fixup of an instruction operand or a one-byte datum applies it.  */
+#define O_i51_high O_md1
+#define O_i51_low  O_md2
+#define O_i51_b2b  O_md3
+#define I51_IS_OPERATOR(OP) ((OP) >= O_i51_high && (OP) <= O_i51_b2b)
+
+/* The expression being read: whether an operator may be left for a fixup
+   to apply, how many were, the addend of the operand of the last one -
+   expression () folds a constant added to the operator's result into the
+   same field - and the kind of value a bit or byte operator made, which a
+   constant result keeps.  */
+static bool i51_operators_allowed;
+static int i51_operators_pending;
+static offsetT i51_operator_addend;
+static char i51_operator_class;
+
+#define I51_MAX_OPERANDS 3
+
+/* One parsed operand.  CLS is the opcode-table letter it matches: a
+   fixed operand is its own letter and REG its register number; `#' is an
+   immediate and `/' a complemented bit; `D' is a byte that can only be a
+   direct address and `B' a value that can only be a bit address; `E' is
+   any other expression, a direct, bit or code address as the row asks.  */
+struct i51_operand
+{
+  char cls;
+  unsigned int reg;
+  expressionS exp;
+};
+
+/* What an operand field holds, which decides its relocation and range.  */
+enum i51_field
+{
+  I51_DIRECT, I51_IMMEDIATE, I51_BIT, I51_REL,
+  I51_PAGE, I51_CODE16, I51_DATA16
+};
+
+static const bfd_reloc_code_real_type i51_field_relocs[] =
+{
+  [I51_DIRECT] = BFD_RELOC_I51_8_DIR,
+  [I51_IMMEDIATE] = BFD_RELOC_I51_8_IMM,
+  [I51_BIT] = BFD_RELOC_I51_8_BIT,
+  [I51_REL] = BFD_RELOC_I51_7_PCREL,
+  [I51_PAGE] = BFD_RELOC_I51_11,
+  [I51_CODE16] = BFD_RELOC_I51_16_CODE,
+  [I51_DATA16] = BFD_RELOC_16,
+};
+
+/* The range of the value each operand field stores.  A datum of one, two
+   or four bytes is checked by write.c as on every target.  */
+static const struct
+{
+  bfd_reloc_code_real_type reloc;
+  offsetT lo, hi;
+  const char *what;
+} i51_ranges[] =
+{
+  { BFD_RELOC_I51_8_IMM,	-128, 255,	N_("8-bit immediate") },
+  { BFD_RELOC_I51_8_DIR,	0, 255,		N_("direct address") },
+  { BFD_RELOC_I51_8_BIT,	0, 255,		N_("bit address") },
+  { BFD_RELOC_I51_8_HIGH,	-32768, 65535,	N_("operand of HIGH()") },
+  { BFD_RELOC_I51_7_PCREL,	-128, 127,	N_("relative branch") },
+  { BFD_RELOC_I51_11,		0, 65535,	N_("code address") },
+  { BFD_RELOC_I51_16_CODE,	0, 65535,	N_("code address") },
+};
+
+/* The sections of the memory-space directives.  */
+
+#define I51_SPACE_BSS   SEC_ALLOC
+#define I51_SPACE_DATA  (SEC_ALLOC | SEC_LOAD | SEC_RELOC | SEC_DATA)
+
+static const struct
+{
+  const char *name;
+  flagword keep;
+} i51_spaces[I51_NSPACES] =
+{
+#define I51_SPACE_SECTION(NAME, SPACE, KIND) { NAME, I51_SPACE_##KIND },
+  { ".bss", I51_SPACE_BSS },
+  I51_SPACE_SECTIONS (I51_SPACE_SECTION)
+#undef I51_SPACE_SECTION
+};
+
+static segT i51_space_segs[I51_NSPACES];
+
+/* The fake common sections a memory-space common is a common of, made
+   like bfd_com_section but named after the space: bfd turns the name into
+   the space's reserved section index.  */
+#define I51_COMMON_NAME(NAME, SHNDX) NAME,
+static const char *const i51_common_names[] =
+{
+  I51_COMMON_SPACES (I51_COMMON_NAME)
+};
+#undef I51_COMMON_NAME
+static asection i51_com_sections[ARRAY_SIZE (i51_common_names)];
+static asymbol i51_com_symbols[ARRAY_SIZE (i51_common_names)];
+
+int
+md_estimate_size_before_relax (fragS *fragp ATTRIBUTE_UNUSED,
+			       asection *seg ATTRIBUTE_UNUSED)
+{
+  abort ();
+}
