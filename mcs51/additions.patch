+++ b/include/elf/i51.h
@@ -0,0 +1,91 @@
+/* MCS-51 ELF support for BFD.
+   Copyright (C) 2001 Free Software Foundation, Inc.
+   Contributed by Radek Benedikt <benedikt@lphard.cz>
+
+This file is part of BFD, the Binary File Descriptor library.
+
+This program is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 2 of the License, or
+(at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+You should have received a copy of the GNU General Public License
+along with this program; if not, write to the Free Software Foundation, Inc.,
+59 Temple Place - Suite 330, Boston, MA 02111-1307, USA.  */
+
+#ifndef _ELF_I51_H
+#define _ELF_I51_H
+
+#include "elf/reloc-macros.h"
+
+/* The machine number is the registered EM_8051 (165), defined in
+   elf/common.h.  Objects are ELFDATA2MSB, container and section contents
+   alike, which is what the gABI requires EI_DATA to describe.
+
+   The MCS-51 itself has no architectural byte order: Intel's manuals never
+   use the words, because the instruction set has no 16-bit load or store to
+   data memory at all ("this is the only instruction which moves 16 bits of
+   data at once" is said of MOV DPTR,#data16, which reads an immediate out of
+   the code stream).  Byte order is therefore defined per construct, and the
+   two conventions Intel lands on are opposites: a 16-bit address inside an
+   instruction is stored high byte first (LJMP/LCALL addr16, MOV DPTR,#data16,
+   and ASM51's DW, which writes code memory), while LCALL pushes the PC low
+   byte first onto an upward-growing stack, leaving it low-byte-at-lower-
+   address in RAM.
+
+   Only the first of those two ever reaches an object file.  Stack frames and
+   SFR register pairs live in RAM at run time and are never section contents,
+   so everything gas writes into a section - instruction operands, and .word /
+   .long / .short through number_to_chars_bigendian - is big endian without
+   exception.  ELFDATA2MSB is the truthful declaration for that, and matches
+   both the 2001 original this port descends from and the gas half's
+   TARGET_BYTES_BIG_ENDIAN.
+
+   R_I51_L and R_I51_H address the two halves of a 16-bit value explicitly and
+   do not depend on the vector.  */
+
+/* Relocations.  */
+START_RELOC_NUMBERS (elf_i51_reloc_type)
+     RELOC_NUMBER (R_I51_NONE,			0)
+     RELOC_NUMBER (R_I51_R1,			1)
+     RELOC_NUMBER (R_I51_R3,			2)
+     RELOC_NUMBER (R_I51_7_PCREL,		3)
+     RELOC_NUMBER (R_I51_11, 			4)
+     RELOC_NUMBER (R_I51_8_BIT,			5)
+     RELOC_NUMBER (R_I51_8,			6)
+     RELOC_NUMBER (R_I51_L,			7)
+     RELOC_NUMBER (R_I51_H,			8)
+     RELOC_NUMBER (R_I51_16,			9)
+     RELOC_NUMBER (R_I51_8_B2B,			10)
+     RELOC_NUMBER (R_I51_13_PCODE,		11)
+END_RELOC_NUMBERS (R_I51_max)
+
+#define SHF_CDATA   0xE0000000 /* Processor-specific - common data mask */
+#define SHF_REGBANK 0x20000000 /* Processor-specific - register bank */
+#define SHF_RDATA   0x40000000 /* Processor-specific - rdata */
+#define SHF_BDATA   0x60000000 /* Processor-specific - bdata */
+#define SHF_IDATA   0x80000000 /* Processor-specific - idata */
+#define SHF_XDATA   0xA0000000 /* Processor-specific - xdata */
+#define SHF_EDATA   0xC0000000 /* Processor-specific - edata */
+
+/* Section indices of the memory-space commons.  They are written to and
+   read from an object file as 0xff00..0xff06, but bfd carries a section
+   index in a 32-bit field whose reserved range starts at SHN_LORESERVE,
+   so a bare 0xff0n would be taken for an ordinary section number too
+   large for st_shndx and spilled into a .symtab_shndx table.  Naming
+   them relative to SHN_LORESERVE is what puts them in the reserved
+   range in both worlds.  */
+#define SHN_I51_REGBANK SHN_LORESERVE        /* Register bank common */
+#define SHN_I51_RDATA_C (SHN_LORESERVE + 1)  /* rdata common */
+#define SHN_I51_BDATA_C (SHN_LORESERVE + 2)  /* bdata common */
+#define SHN_I51_IDATA_C (SHN_LORESERVE + 3)  /* idata common */
+#define SHN_I51_XDATA_C (SHN_LORESERVE + 4)  /* xdata common */
+#define SHN_I51_EDATA_C (SHN_LORESERVE + 5)  /* edata common */
+#define SHN_I51_BITDATA_C (SHN_LORESERVE + 6) /* bitdata common */
+
+#endif /* _ELF_I51_H */
