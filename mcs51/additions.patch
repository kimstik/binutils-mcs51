+
+static reloc_howto_type elf_i51_howto_table[] =
+{
+  HOWTO (R_I51_NONE,		/* type */
+	 0,			/* rightshift */
+	 0,			/* size in bytes */
+	 0,			/* bitsize */
+	 false,			/* pc_relative */
+	 0,			/* bitpos */
+	 complain_overflow_dont, /* complain_on_overflow */
+	 bfd_elf_generic_reloc,	/* special_function */
+	 "R_I51_NONE",		/* name */
+	 false,			/* partial_inplace */
+	 0,			/* src_mask */
+	 0,			/* dst_mask */
+	 false),		/* pcrel_offset */
+
+  /* Never emitted; the number is reserved.  */
+  HOWTO (R_I51_R1, 0, 0, 0, false, 0, complain_overflow_dont,
+	 bfd_elf_generic_reloc, "R_I51_R1", false, 0, 0, false),
+
+  /* Never emitted; the number is reserved.  */
+  HOWTO (R_I51_R3, 0, 0, 0, false, 0, complain_overflow_dont,
+	 bfd_elf_generic_reloc, "R_I51_R3", false, 0, 0, false),
+
+  /* The 8-bit displacement of a relative branch.  It is measured from
+     the following instruction, which starts right after the displacement
+     byte - the byte is always the last of its instruction - and the
+     assembler puts the -1 that makes up the difference in the addend.  */
+  HOWTO (R_I51_7_PCREL,		/* type */
+	 0,			/* rightshift */
+	 1,			/* size in bytes */
+	 8,			/* bitsize */
+	 true,			/* pc_relative */
+	 0,			/* bitpos */
+	 complain_overflow_signed, /* complain_on_overflow */
+	 bfd_elf_generic_reloc, /* special_function */
+	 "R_I51_7_PCREL",	/* name */
+	 false,			/* partial_inplace */
+	 0,			/* src_mask */
+	 0xff,			/* dst_mask */
+	 true),			/* pcrel_offset */
+
+  /* The 11-bit target of an ACALL or AJMP: A10..A8 in the top three bits
+     of the opcode byte, A7..A0 in the byte after it, A15..A11 taken from
+     the address of the following instruction.  Applied by
+     i51_final_link_relocate ().  */
+  HOWTO (R_I51_11,		/* type */
+	 0,			/* rightshift */
+	 2,			/* size in bytes */
+	 11,			/* bitsize */
+	 false,			/* pc_relative */
+	 0,			/* bitpos */
+	 complain_overflow_dont, /* complain_on_overflow */
+	 bfd_elf_generic_reloc, /* special_function */
+	 "R_I51_11",		/* name */
+	 false,			/* partial_inplace */
+	 0,			/* src_mask */
+	 0xe0ff,		/* dst_mask */
+	 false),		/* pcrel_offset */
+
+  /* A bit address: 0..0x7F in the bit-addressable RAM, 0x80..0xFF in the
+     bit-addressable special function registers.  */
+  HOWTO (R_I51_8_BIT,		/* type */
+	 0,			/* rightshift */
+	 1,			/* size in bytes */
+	 8,			/* bitsize */
+	 false,			/* pc_relative */
+	 0,			/* bitpos */
+	 complain_overflow_unsigned, /* complain_on_overflow */
+	 bfd_elf_generic_reloc,	/* special_function */
+	 "R_I51_8_BIT",		/* name */
+	 false,			/* partial_inplace */
+	 0,			/* src_mask */
+	 0xff,			/* dst_mask */
+	 false),		/* pcrel_offset */
+
+  /* A byte: a datum, a byte operand of .pcode, and every eight-bit
+     operand of an object built before R_I51_8_DIR and R_I51_8_IMM
+     existed.  Checked as an immediate is, by i51_final_link_relocate (),
+     which also adds what the byte holds, as this entry's src_mask once
+     made _bfd_relocate_contents () do.  */
+  HOWTO (R_I51_8,		/* type */
+	 0,			/* rightshift */
+	 1,			/* size in bytes */
+	 8,			/* bitsize */
+	 false,			/* pc_relative */
+	 0,			/* bitpos */
+	 complain_overflow_dont, /* complain_on_overflow */
+	 bfd_elf_generic_reloc,	/* special_function */
+	 "R_I51_8",		/* name */
+	 false,			/* partial_inplace */
+	 0,			/* src_mask */
+	 0xff,			/* dst_mask */
+	 false),		/* pcrel_offset */
+
+  /* The low byte of a value, whatever its width.  */
+  HOWTO (R_I51_L,		/* type */
+	 0,			/* rightshift */
+	 1,			/* size in bytes */
+	 8,			/* bitsize */
+	 false,			/* pc_relative */
+	 0,			/* bitpos */
+	 complain_overflow_dont, /* complain_on_overflow */
+	 bfd_elf_generic_reloc,	/* special_function */
+	 "R_I51_L",		/* name */
+	 false,			/* partial_inplace */
+	 0,			/* src_mask */
+	 0xff,			/* dst_mask */
+	 false),		/* pcrel_offset */
+
+  /* The high byte of a 16-bit value.  Checked by i51_final_link_relocate
+     (): a value wider than 16 bits has no high byte.  */
+  HOWTO (R_I51_H,		/* type */
+	 8,			/* rightshift */
+	 1,			/* size in bytes */
+	 8,			/* bitsize */
+	 false,			/* pc_relative */
+	 0,			/* bitpos */
+	 complain_overflow_dont, /* complain_on_overflow */
+	 bfd_elf_generic_reloc,	/* special_function */
+	 "R_I51_H",		/* name */
+	 false,			/* partial_inplace */
+	 0,			/* src_mask */
+	 0xff,			/* dst_mask */
+	 false),		/* pcrel_offset */
+
+  /* A 16-bit number: MOV DPTR,#data16 and .word, and in an object built
+     before R_I51_16_CODE existed an LJMP or LCALL target as well.
+     Checked by i51_final_link_relocate (): -32768..65535.  */
+  HOWTO (R_I51_16,		/* type */
+	 0,			/* rightshift */
+	 2,			/* size in bytes */
+	 16,			/* bitsize */
+	 false,			/* pc_relative */
+	 0,			/* bitpos */
+	 complain_overflow_dont, /* complain_on_overflow */
+	 bfd_elf_generic_reloc,	/* special_function */
+	 "R_I51_16",		/* name */
+	 false,			/* partial_inplace */
+	 0,			/* src_mask */
+	 0xffff,		/* dst_mask */
+	 false),		/* pcrel_offset */
+
+  /* A bit address made of a byte address and a bit number: the byte at
+     the relocated place holds the bit number, the symbol names the byte.
+     Applied by i51_final_link_relocate ().  */
+  HOWTO (R_I51_8_B2B,		/* type */
+	 0,			/* rightshift */
+	 1,			/* size in bytes */
+	 8,			/* bitsize */
+	 false,			/* pc_relative */
+	 0,			/* bitpos */
+	 complain_overflow_dont, /* complain_on_overflow */
+	 bfd_elf_generic_reloc,	/* special_function */
+	 "R_I51_8_B2B",		/* name */
+	 false,			/* partial_inplace */
+	 0,			/* src_mask */
+	 0xff,			/* dst_mask */
+	 false),		/* pcrel_offset */
+
+  /* The 13-bit execution address of a .pcode entry, under three flag
+     bits.  Applied by i51_final_link_relocate ().  */
+  HOWTO (R_I51_13_PCODE,	/* type */
+	 0,			/* rightshift */
+	 2,			/* size in bytes */
+	 13,			/* bitsize */
+	 false,			/* pc_relative */
+	 0,			/* bitpos */
+	 complain_overflow_dont, /* complain_on_overflow */
+	 bfd_elf_generic_reloc, /* special_function */
+	 "R_I51_13_PCODE",	/* name */
+	 false,			/* partial_inplace */
+	 0,			/* src_mask */
+	 0x1fff,		/* dst_mask */
+	 false),		/* pcrel_offset */
+
+  /* A direct address: one byte of the internal RAM and special function
+     register space, 0x00..0xff.  i51_check_space () also refuses a RAM
+     symbol at 0x80 or above, where a direct address names the SFRs.  */
+  HOWTO (R_I51_8_DIR,		/* type */
+	 0,			/* rightshift */
+	 1,			/* size in bytes */
+	 8,			/* bitsize */
+	 false,			/* pc_relative */
+	 0,			/* bitpos */
+	 complain_overflow_unsigned, /* complain_on_overflow */
+	 bfd_elf_generic_reloc,	/* special_function */
+	 "R_I51_8_DIR",		/* name */
+	 false,			/* partial_inplace */
+	 0,			/* src_mask */
+	 0xff,			/* dst_mask */
+	 false),		/* pcrel_offset */
+
+  /* An immediate: a byte the instruction reads as signed or unsigned, so
+     -128..255.  No complain_overflow_* code draws that line, so
+     i51_final_link_relocate () does.  */
+  HOWTO (R_I51_8_IMM,		/* type */
+	 0,			/* rightshift */
+	 1,			/* size in bytes */
+	 8,			/* bitsize */
+	 false,			/* pc_relative */
+	 0,			/* bitpos */
+	 complain_overflow_dont, /* complain_on_overflow */
+	 bfd_elf_generic_reloc,	/* special_function */
+	 "R_I51_8_IMM",		/* name */
+	 false,			/* partial_inplace */
+	 0,			/* src_mask */
+	 0xff,			/* dst_mask */
+	 false),		/* pcrel_offset */
+
+  /* A code address: the target of an LJMP or LCALL, 0..0xFFFF, which
+     i51_final_link_relocate () checks.  */
+  HOWTO (R_I51_16_CODE,		/* type */
+	 0,			/* rightshift */
+	 2,			/* size in bytes */
+	 16,			/* bitsize */
+	 false,			/* pc_relative */
+	 0,			/* bitpos */
+	 complain_overflow_dont, /* complain_on_overflow */
+	 bfd_elf_generic_reloc,	/* special_function */
+	 "R_I51_16_CODE",	/* name */
+	 false,			/* partial_inplace */
+	 0,			/* src_mask */
+	 0xffff,		/* dst_mask */
+	 false),		/* pcrel_offset */
+
+  /* A 32-bit datum: .long, and addresses in debugging information.  */
+  HOWTO (R_I51_32,		/* type */
+	 0,			/* rightshift */
+	 4,			/* size in bytes */
+	 32,			/* bitsize */
+	 false,			/* pc_relative */
+	 0,			/* bitpos */
+	 complain_overflow_dont, /* complain_on_overflow */
+	 bfd_elf_generic_reloc,	/* special_function */
+	 "R_I51_32",		/* name */
+	 false,			/* partial_inplace */
+	 0,			/* src_mask */
+	 0xffffffff,		/* dst_mask */
+	 false),		/* pcrel_offset */
+};
+
+/* Map BFD reloc types to I51 ELF reloc types.  */
+
+static const struct
+{
+  bfd_reloc_code_real_type bfd_reloc_val;
+  unsigned int elf_reloc_val;
+} i51_reloc_map[] =
+{
+  { BFD_RELOC_NONE,		R_I51_NONE },
+  { BFD_RELOC_I51_7_PCREL,	R_I51_7_PCREL },
+  { BFD_RELOC_I51_11,		R_I51_11 },
+  { BFD_RELOC_I51_8_BIT,	R_I51_8_BIT },
+  { BFD_RELOC_8,		R_I51_8 },
+  { BFD_RELOC_I51_8_LOW,	R_I51_L },
+  { BFD_RELOC_I51_8_HIGH,	R_I51_H },
+  { BFD_RELOC_16,		R_I51_16 },
+  { BFD_RELOC_I51_8_B2B,	R_I51_8_B2B },
+  { BFD_RELOC_I51_13_PCODE,	R_I51_13_PCODE },
+  { BFD_RELOC_I51_8_DIR,	R_I51_8_DIR },
+  { BFD_RELOC_I51_8_IMM,	R_I51_8_IMM },
+  { BFD_RELOC_I51_16_CODE,	R_I51_16_CODE },
+  { BFD_RELOC_32,		R_I51_32 },
+};
+
+static reloc_howto_type *
+bfd_elf32_bfd_reloc_type_lookup (bfd *abfd ATTRIBUTE_UNUSED,
+				 bfd_reloc_code_real_type code)
+{
+  unsigned int i;
+
+  for (i = 0; i < ARRAY_SIZE (i51_reloc_map); i++)
+    if (i51_reloc_map[i].bfd_reloc_val == code)
+      return &elf_i51_howto_table[i51_reloc_map[i].elf_reloc_val];
+  return NULL;
+}
+
+static reloc_howto_type *
+bfd_elf32_bfd_reloc_name_lookup (bfd *abfd ATTRIBUTE_UNUSED,
+				 const char *r_name)
+{
+  unsigned int i;
+
+  for (i = 0; i < ARRAY_SIZE (elf_i51_howto_table); i++)
+    if (strcasecmp (elf_i51_howto_table[i].name, r_name) == 0)
+      return &elf_i51_howto_table[i];
+  return NULL;
+}
+
+/* Set the howto pointer for an I51 ELF reloc.  */
+
+static bool
+i51_info_to_howto_rela (bfd *abfd, arelent *cache_ptr,
+			Elf_Internal_Rela *dst)
+{
+  unsigned int r_type = ELF32_R_TYPE (dst->r_info);
+
+  if (r_type >= (unsigned int) R_I51_max)
+    {
+      /* xgettext:c-format */
+      _bfd_error_handler (_("%pB: unsupported relocation type %#x"),
+			  abfd, r_type);
+      bfd_set_error (bfd_error_bad_value);
+      return false;
+    }
+  cache_ptr->howto = &elf_i51_howto_table[r_type];
+  return true;
+}
+
+/* The memory spaces of the machine, as far as a relocation cares: a
+   code address cannot name data memory, a direct address names the
+   internal RAM and the special function registers, a bit address the
+   bit space.  */
+
+enum i51_space
+{
+  I51_SPACE_ANY,		/* An absolute symbol, or a section of no
+				   known space: not checked.  */
+  I51_SPACE_CODE,
+  I51_SPACE_DIRECT,		/* Internal RAM below 0x80.  */
+  I51_SPACE_INDIRECT,		/* Internal RAM reached through @R0/@R1.  */
+  I51_SPACE_BIT,
+  I51_SPACE_XDATA,
+  I51_SPACE_EDATA,
+  I51_SPACE_EEPROM
+};
+
+static const char *const i51_space_names[] =
+{
+  NULL,
+  N_("code memory"),
+  N_("internal RAM"),
+  N_("indirectly addressed internal RAM"),
+  N_("the bit space"),
+  N_("external RAM"),
+  N_("edata"),
+  N_("EEPROM")
+};
+
+/* The input sections the assembler emits for each space, and the
+   sections the memory-space commons are collected in.  */
+
+static const struct
+{
+  const char *prefix;
+  enum i51_space space;
+} i51_section_spaces[] =
+{
+  { ".regbank",	I51_SPACE_DIRECT },
+  { ".rdata",	I51_SPACE_DIRECT },
+  { ".rbss",	I51_SPACE_DIRECT },
+  { ".bdata",	I51_SPACE_DIRECT },
+  { ".bbss",	I51_SPACE_DIRECT },
+  { ".data",	I51_SPACE_DIRECT },
+  { ".bss",	I51_SPACE_DIRECT },
+  { "COMMON",	I51_SPACE_DIRECT },
+  { ".gnu.linkonce.d.", I51_SPACE_DIRECT },
+  { ".idata",	I51_SPACE_INDIRECT },
+  { ".ibss",	I51_SPACE_INDIRECT },
+  { ".bitdata",	I51_SPACE_BIT },
+  { ".bitbss",	I51_SPACE_BIT },
+  { ".bit",	I51_SPACE_BIT },	/* The output section of the default
+					   linker script.  */
+  { ".xdata",	I51_SPACE_XDATA },
+  { ".xbss",	I51_SPACE_XDATA },
+  { ".edata",	I51_SPACE_EDATA },
+  { ".ebss",	I51_SPACE_EDATA },
+  { ".eeprom",	I51_SPACE_EEPROM },
+};
+
+/* The memory space input section SEC belongs to.  */
+
+static enum i51_space
+i51_section_space (const asection *sec)
+{
+  unsigned int i;
+
+  if (sec == NULL || bfd_is_abs_section (sec) || bfd_is_und_section (sec))
+    return I51_SPACE_ANY;
+  if ((sec->flags & SEC_CODE) != 0)
+    return I51_SPACE_CODE;
+  for (i = 0; i < ARRAY_SIZE (i51_section_spaces); i++)
+    {
+      size_t len = strlen (i51_section_spaces[i].prefix);
+
+      if (strncmp (sec->name, i51_section_spaces[i].prefix, len) == 0
+	  && (sec->name[len] == 0 || sec->name[len] == '.'
+	      || i51_section_spaces[i].prefix[len - 1] == '.'))
+	return i51_section_spaces[i].space;
+    }
+  return I51_SPACE_ANY;
+}
+
+/* Refuse a relocation of HOWTO against a symbol in SPACE at RELOCATION
+   that the operand cannot address, and return whether it was refused.  */
+
+static bool
+i51_check_space (struct bfd_link_info *info, bfd *input_bfd,
+		 asection *input_section, Elf_Internal_Rela *rel,
+		 reloc_howto_type *howto, const char *name,
+		 enum i51_space space, bfd_vma relocation)
+{
+  const char *what;
+
+  if (space == I51_SPACE_ANY)
+    return false;
+
+  switch (howto->type)
+    {
+    case R_I51_7_PCREL:
+    case R_I51_11:
+    case R_I51_16_CODE:
+      if (space == I51_SPACE_CODE)
+	return false;
+      what = _("a branch target");
+      break;
+
+    case R_I51_8_DIR:
+    case R_I51_8_B2B:
+      if (space == I51_SPACE_DIRECT || space == I51_SPACE_INDIRECT)
+	{
+	  if (relocation < 0x80)
+	    return false;
+	  /* xgettext:c-format */
+	  info->callbacks->einfo
+	    (_("%X%H: %s against `%s': RAM at 0x%v is not directly "
+	       "addressable, 0x80 and above is the special function "
+	       "register page\n"),
+	     input_bfd, input_section, rel->r_offset, howto->name, name,
+	     relocation);
+	  return true;
+	}
+      what = _("a direct address");
+      break;
+
+    case R_I51_8_BIT:
+      if (space == I51_SPACE_BIT)
+	return false;
+      what = _("a bit address");
+      break;
+
+    default:
+      return false;
+    }
+
+  /* xgettext:c-format */
+  info->callbacks->einfo
+    (_("%X%H: %s against `%s': %s cannot name %s\n"),
+     input_bfd, input_section, rel->r_offset, howto->name, name, what,
+     _(i51_space_names[space]));
+  return true;
+}
+
+/* Apply one relocation.  The relocations whose field is not the value
+   itself are applied here; the rest go to _bfd_final_link_relocate (),
+   which checks overflow as the howto says.  */
+
+static bfd_reloc_status_type
+i51_final_link_relocate (reloc_howto_type *howto, bfd *input_bfd,
+			 asection *input_section, bfd_byte *contents,
+			 Elf_Internal_Rela *rel, bfd_vma relocation)
+{
+  bfd_signed_vma srel = relocation + rel->r_addend;
+  bfd_vma x, pc;
+  int bit;
+
+  if (!bfd_reloc_offset_in_range (howto, input_bfd, input_section,
+				  rel->r_offset))
+    return bfd_reloc_outofrange;
+
+  contents += rel->r_offset;
+  switch (howto->type)
+    {
+    case R_I51_11:
+      /* The target has to be in the 2K page of the following instruction,
+	 two bytes past this one.  */
+      pc = (input_section->output_section->vma + input_section->output_offset
+	    + rel->r_offset + 2);
+      if (srel < 0 || srel > 0xffff || ((srel ^ pc) & ~(bfd_vma) 0x7ff) != 0)
+	return bfd_reloc_overflow;
+      x = bfd_getb16 (contents) & 0x1f00;
+      bfd_putb16 (x | ((srel & 0x0700) << 5) | (srel & 0xff), contents);
+      return bfd_reloc_ok;
+
+    case R_I51_8_B2B:
+      /* The byte holds the bit number inside the byte the symbol names.  */
+      x = bfd_get_8 (input_bfd, contents);
+      bit = -1;
+      if (x <= 7 && srel >= 0x20 && srel <= 0x2f)
+	bit = (srel - 0x20) * 8 + x;
+      else if (x <= 7 && srel >= 0x80 && srel <= 0xf8 && (srel & 7) == 0)
+	bit = srel + x;
+      if (bit < 0)
+	return bfd_reloc_other;
+      bfd_put_8 (input_bfd, bit, contents);
+      return bfd_reloc_ok;
+
+    case R_I51_13_PCODE:
+      if (srel < 0x100 || srel > 0x1fff)
+	return bfd_reloc_overflow;
+      x = bfd_getb16 (contents) & 0xe000;
+      bfd_putb16 (x | srel, contents);
+      return bfd_reloc_ok;
+
+    case R_I51_8:
+      /* An assembler before R_I51_8 carried its whole addend in r_addend
+	 stored the -1 of a `.pcode @BYTE' operand in the byte itself and
+	 relied on this relocation adding what the byte holds.  Objects of
+	 that age are still linked, so the byte is added; the assembler of
+	 today leaves it zero.  */
+      srel += (signed char) bfd_get_8 (input_bfd, contents);
+      /* Fall through.  */
+    case R_I51_8_IMM:
+      if (srel < -128 || srel > 255)
+	return bfd_reloc_overflow;
+      bfd_put_8 (input_bfd, srel, contents);
+      return bfd_reloc_ok;
+
+    case R_I51_H:
+      if (srel < -32768 || srel > 65535)
+	return bfd_reloc_overflow;
+      bfd_put_8 (input_bfd, srel >> 8, contents);
+      return bfd_reloc_ok;
+
+    case R_I51_16:
+      if (srel < -32768 || srel > 65535)
+	return bfd_reloc_overflow;
+      bfd_putb16 (srel, contents);
+      return bfd_reloc_ok;
+
+    case R_I51_16_CODE:
+      /* Checked here rather than by the howto: bfd_check_overflow ()
+	 first cuts the value to the 16 bits of an address of this
+	 architecture, which leaves nothing to overflow.  */
+      if (srel < 0 || srel > 0xffff)
+	return bfd_reloc_overflow;
+      bfd_putb16 (srel, contents);
+      return bfd_reloc_ok;
+
+    default:
+      return _bfd_final_link_relocate (howto, input_bfd, input_section,
+				       contents - rel->r_offset, rel->r_offset,
+				       relocation, rel->r_addend);
+    }
+}
+
+/* Relocate an I51 ELF section.  */
+
+static int
+elf32_i51_relocate_section (struct bfd_link_info *info, bfd *input_bfd,
+			    asection *input_section, bfd_byte *contents,
+			    Elf_Internal_Rela *relocs,
+			    Elf_Internal_Sym *local_syms,
+			    asection **local_sections)
+{
+  Elf_Internal_Shdr *symtab_hdr = &elf_symtab_hdr (input_bfd);
+  struct elf_link_hash_entry **sym_hashes = elf_sym_hashes (input_bfd);
+  Elf_Internal_Rela *relend = relocs + input_section->reloc_count;
+  Elf_Internal_Rela *rel;
+
+  for (rel = relocs; rel < relend; rel++)
+    {
+      unsigned int r_type = ELF32_R_TYPE (rel->r_info);
+      unsigned long r_symndx = ELF32_R_SYM (rel->r_info);
+      reloc_howto_type *howto;
+      struct elf_link_hash_entry *h = NULL;
+      Elf_Internal_Sym *sym = NULL;
+      asection *sec = NULL;
+      bfd_vma relocation;
+      bfd_reloc_status_type r;
+      const char *name;
+
+      if (r_type >= (unsigned int) R_I51_max)
+	{
+	  /* xgettext:c-format */
+	  _bfd_error_handler (_("%pB: unsupported relocation type %#x"),
+			      input_bfd, r_type);
+	  bfd_set_error (bfd_error_bad_value);
+	  return false;
+	}
+      howto = &elf_i51_howto_table[r_type];
+
+      if (r_symndx < symtab_hdr->sh_info)
+	{
+	  sym = local_syms + r_symndx;
+	  sec = local_sections[r_symndx];
+	  relocation = _bfd_elf_rela_local_sym (info->output_bfd, sym, &sec,
+						rel);
+	  name = bfd_elf_string_from_elf_section (input_bfd,
+						  symtab_hdr->sh_link,
+						  sym->st_name);
+	  if (name == NULL || *name == 0)
+	    name = bfd_section_name (sec);
+	}
+      else
+	{
+	  bool unresolved_reloc, warned, ignored;
+
+	  RELOC_FOR_GLOBAL_SYMBOL (info, input_bfd, input_section, rel,
+				   r_symndx, symtab_hdr, sym_hashes,
+				   h, sec, relocation,
+				   unresolved_reloc, warned, ignored);
+	  name = h->root.root.string;
+	}
+
+      if (sec != NULL && discarded_section (sec))
+	RELOC_AGAINST_DISCARDED_SECTION (info, input_bfd, input_section,
+					 rel, 1, relend, R_I51_NONE,
+					 howto, 0, contents);
+
+      if (bfd_link_relocatable (info))
+	continue;
+
+      if (i51_check_space (info, input_bfd, input_section, rel, howto, name,
+			   (h != NULL && h->root.type == bfd_link_hash_undefweak
+			    ? I51_SPACE_ANY : i51_section_space (sec)),
+			   relocation + rel->r_addend))
+	continue;
+
+      r = i51_final_link_relocate (howto, input_bfd, input_section,
+				   contents, rel, relocation);
+      switch (r)
+	{
+	case bfd_reloc_ok:
+	  break;
+
+	case bfd_reloc_overflow:
+	  (*info->callbacks->reloc_overflow)
+	    (info, (h ? &h->root : NULL), name, howto->name, (bfd_vma) 0,
+	     input_bfd, input_section, rel->r_offset);
+	  break;
+
+	case bfd_reloc_outofrange:
+	  /* xgettext:c-format */
+	  info->callbacks->einfo
+	    (_("%X%H: %s against `%s': error: relocation applies outside "
+	       "section\n"),
+	     input_bfd, input_section, rel->r_offset, howto->name, name);
+	  break;
+
+	case bfd_reloc_other:
+	  /* The only relocation that returns this is R_I51_8_B2B.  */
+	  if (bfd_get_8 (input_bfd, contents + rel->r_offset) > 7)
+	    /* xgettext:c-format */
+	    info->callbacks->einfo
+	      (_("%X%H: %s against `%s': bit number %d is not 0..7\n"),
+	       input_bfd, input_section, rel->r_offset, howto->name, name,
+	       bfd_get_8 (input_bfd, contents + rel->r_offset));
+	  else
+	    /* xgettext:c-format */
+	    info->callbacks->einfo
+	      (_("%X%H: %s against `%s': 0x%v is not bit addressable\n"),
+	       input_bfd, input_section, rel->r_offset, howto->name, name,
+	       relocation + rel->r_addend);
+	  break;
+
+	default:
+	  /* xgettext:c-format */
+	  info->callbacks->einfo
+	    (_("%X%H: %s against `%s': internal error: unexpected "
+	       "relocation result %d\n"),
+	     input_bfd, input_section, rel->r_offset, howto->name, name, r);
+	  break;
+	}
+    }
+
+  return true;
+}
+
+/* A linked image carries the RAM spaces as sections that are not
+   allocated, the way the default linker script emits them.  Their
+   contents are data all the same, which is what nm and the like are told:
+   a symbol there is `d', not `?'.  */
+
+static bool
+i51_elf_section_flags (const Elf_Internal_Shdr *hdr)
+{
+  asection *sec = hdr->bfd_section;
+
+  if ((sec->flags & (SEC_ALLOC | SEC_HAS_CONTENTS)) == SEC_HAS_CONTENTS)
+    switch (i51_section_space (sec))
+      {
+      case I51_SPACE_DIRECT:
+      case I51_SPACE_INDIRECT:
+      case I51_SPACE_BIT:
+      case I51_SPACE_XDATA:
+      case I51_SPACE_EDATA:
+      case I51_SPACE_EEPROM:
+	sec->flags |= SEC_DATA;
+	break;
+      default:
+	break;
+      }
+  return true;
+}
+
+static bool
+i51_elf_section_from_shdr (bfd *abfd,
+			    Elf_Internal_Shdr *hdr,
+			    const char *name,
+			    int shindex)
+{
+  asection *newsect;
+  flagword flags;
+
+  if (! _bfd_elf_make_section_from_shdr (abfd, hdr, name, shindex))
+    return 0;
+
+  newsect = hdr->bfd_section;
+  flags = bfd_section_flags (newsect);
+
+  /* A space code in the top bits of sh_flags marks a section standing in
+     for a memory-space common: a size and an alignment, never bytes.  A
+     section that carries contents is real data, and SEC_IS_COMMON on it
+     makes the linker take it for a size-only placeholder and drop every
+     byte it holds.  */
+  if ((hdr->sh_flags & SHF_CDATA) != 0 && (flags & SEC_HAS_CONTENTS) == 0)
+    flags |= SEC_IS_COMMON;
+
+  bfd_set_section_flags (newsect, flags);
+
+  return 1;
+}
+
+/* Refuse initialized data in a memory space that nothing loads.  The RAM
+   of an MCS-51 starts undefined, and the default linker script emits the
+   RAM spaces as non-loaded (INFO) sections: bytes a program put there
+   would vanish from the image, and the variable would start with
+   whatever the RAM held.  A zero byte is a reservation and is accepted,
+   and so is anything in a section a linker script does load, for a
+   program that copies it into place itself.  */
+
+static bool
+elf32_i51_final_link (bfd *abfd, struct bfd_link_info *info)
+{
+  bfd *ibfd;
+  asection *sec;
+  bool ok = true;
+
+  if (!bfd_link_relocatable (info))
+    for (ibfd = info->input_bfds; ibfd != NULL; ibfd = ibfd->link.next)
+      for (sec = ibfd->sections; sec != NULL; sec = sec->next)
+	{
+	  enum i51_space space = i51_section_space (sec);
+	  bool init;
+
+	  if ((space != I51_SPACE_DIRECT && space != I51_SPACE_INDIRECT
+	       && space != I51_SPACE_BIT && space != I51_SPACE_XDATA
+	       && space != I51_SPACE_EDATA)
+	      || (sec->flags & SEC_HAS_CONTENTS) == 0
+	      || sec->size == 0
+	      || discarded_section (sec)
+	      || sec->output_section == NULL
+	      || ((sec->output_section->flags & (SEC_ALLOC | SEC_LOAD))
+		  == (SEC_ALLOC | SEC_LOAD)))
+	    continue;
+
+	  init = sec->reloc_count != 0;
+	  if (!init)
+	    {
+	      bfd_byte *contents;
+	      bfd_size_type i;
+
+	      if (!bfd_malloc_and_get_section (ibfd, sec, &contents))
+		return false;
+	      for (i = 0; i < sec->size && !init; i++)
+		init = contents[i] != 0;
+	      free (contents);
+	    }
+	  if (init)
+	    {
+	      _bfd_error_handler
+		/* xgettext:c-format */
+		(_("%pB(%pA): initialized data in %s, which nothing loads:"
+		   " reserve the space with .space and set it from code"),
+		 ibfd, sec, _(i51_space_names[space]));
+	      ok = false;
+	    }
+	}
+
+  if (!ok)
+    {
+      bfd_set_error (bfd_error_bad_value);
+      return false;
+    }
+  return _bfd_elf_final_link (abfd, info);
+}
+
+/* The memory-space commons.  A common of one of these spaces carries the
+   space's reserved section index in st_shndx, and the linker collects it
+   into a section of the space's own name, which is the name a linker
+   script places it by.  */
+
+static const struct
+{
+  unsigned int shndx;
+  const char *name;
+} i51_common_spaces[] =
+{
+  { SHN_I51_REGBANK,	".regbank" },
+  { SHN_I51_RDATA_C,	".rbss" },
+  { SHN_I51_BDATA_C,	".bbss" },
+  { SHN_I51_IDATA_C,	".ibss" },
+  { SHN_I51_XDATA_C,	".xbss" },
+  { SHN_I51_EDATA_C,	".ebss" },
+  { SHN_I51_BITDATA_C,	".bitbss" },
+};
+
+/* The entry of i51_common_spaces for section index SHNDX, or -1.  */
+
+static int
+i51_common_by_shndx (unsigned int shndx)
+{
+  unsigned int i;
+
+  for (i = 0; i < ARRAY_SIZE (i51_common_spaces); i++)
+    if (i51_common_spaces[i].shndx == shndx)
+      return i;
+  return -1;
+}
+
+/* The entry of i51_common_spaces for the common section SEC, or -1.  */
+
+static int
+i51_common_by_section (const asection *sec)
+{
+  unsigned int i;
+
+  if (sec == NULL || !bfd_is_com_section (sec))
+    return -1;
+  for (i = 0; i < ARRAY_SIZE (i51_common_spaces); i++)
+    if (strcmp (sec->name, i51_common_spaces[i].name) == 0)
+      return i;
+  return -1;
+}
+
+/* Map a memory-space common onto the processor-specific section index
+   that names its space.  Such a common sits in a fake common section that
+   carries the space name in place of *COM*; real sections of those names
+   hold local data and keep the index they were numbered with.  */
+
+static bool
+elf32_i51_section_from_bfd_section (bfd *abfd ATTRIBUTE_UNUSED, asection *sec,
+				    int *retval)
+{
+  int i = i51_common_by_section (sec);
+
+  if (i < 0)
+    return false;
+  *retval = i51_common_spaces[i].shndx;
+  return true;
+}
+
+/* The fake common sections that the symbols of an object read with the
+   generic symbol reader are put in, one per space.  */
+
+static asection i51_common_sections[ARRAY_SIZE (i51_common_spaces)];
+static asymbol i51_common_symbols[ARRAY_SIZE (i51_common_spaces)];
+
+/* Handle the special I51 section numbers that a symbol may use.  */
+
+static void
+elf32_i51_symbol_processing (bfd *abfd ATTRIBUTE_UNUSED, asymbol *asym)
+{
+  elf_symbol_type *elfsym = (elf_symbol_type *) asym;
+  int i = i51_common_by_shndx (elfsym->internal_elf_sym.st_shndx);
+  asection *sec;
+
+  if (i < 0)
+    return;
+
+  sec = &i51_common_sections[i];
+  if (sec->name == NULL)
+    {
+      sec->name = i51_common_spaces[i].name;
+      sec->flags = SEC_IS_COMMON;
+      sec->output_section = sec;
+      sec->symbol = &i51_common_symbols[i];
+      i51_common_symbols[i].name = sec->name;
+      i51_common_symbols[i].flags = BSF_SECTION_SYM;
+      i51_common_symbols[i].section = sec;
+    }
+  asym->section = sec;
+  asym->value = elfsym->internal_elf_sym.st_size;
+}
+
+/* The section that collects the commons of one memory space, made on
+   first use.  It carries the plain name of the space, because that is
+   the name a linker script places those commons by: the scripts written
+   for this port name the spaces without a wildcard.
+
+   The object may hold a real section of the same name - the assembler
+   emits one for the space directives and for local commons - and the
+   two must never be the same section.  Asking for a section by name
+   alone hands back the real one, and the SEC_IS_COMMON set below then
+   turns a section full of data into a size-only placeholder: the linker
+   drops every byte it holds, succeeds, and says nothing.  A section the
+   object brought along has an index in that object; the one made here
+   has none, which is what tells them apart.  */
+
+static asection *
+i51_elf_common_section (bfd *abfd, const char *name)
+{
+  asection *sec;
+
+  for (sec = abfd->sections; sec != NULL; sec = sec->next)
+    if ((sec->flags & SEC_IS_COMMON) != 0
+	&& elf_section_data (sec)->this_idx == 0
+	&& strcmp (bfd_section_name (sec), name) == 0)
+      return sec;
+
+  sec = bfd_make_section_anyway (abfd, name);
+  if (sec != NULL)
+    sec->flags |= SEC_IS_COMMON;
+  return sec;
+}
+
+/* Refuse a symbol NAME of ABFD in section SEC when the link already holds
+   a symbol of that name in a different memory space and one of the two
+   is a memory-space common.
+
+   The spaces are disjoint address spaces of the machine, and the
+   arbitration between two commons, or between a common and a definition,
+   knows nothing of them: `.xcomm BUF,4' in one object and `.icomm BUF,4'
+   in another would link with nothing said, the order of the files
+   deciding whether BUF is external RAM at 0x0000 or internal RAM at
+   0x0020, and a definition of BUF in .idata would silently take over a
+   .xcomm BUF that code reaches with MOVX.  No address satisfies both, so
+   the pair is refused rather than arbitrated.
+
+   An ordinary .comm names no space and is not compared.  Objects of this
+   port's lineage carry two builds of one library side by side - names
+   declared with .comm before the space directives existed and with
+   .bcomm or .icomm after - and comparing those would refuse links that
+   work today.  */
+
+static bool
+elf32_i51_check_common_space (bfd *abfd, struct bfd_link_info *info,
+			      const char *name, asection *sec, bfd_vma size)
+{
+  struct bfd_link_hash_entry *h;
+  asection *oldsec;
+  enum i51_space space, oldspace;
+
+  if (name == NULL)
+    return true;
+
+  h = bfd_link_hash_lookup (info->hash, name, false, false, true);
+  if (h == NULL)
+    return true;
+  if (h->type == bfd_link_hash_common)
+    oldsec = h->u.c.p->section;
+  else if (h->type == bfd_link_hash_defined
+	   || h->type == bfd_link_hash_defweak)
+    oldsec = h->u.def.section;
+  else
+    return true;
+
+  if (i51_common_by_section (sec) < 0 && i51_common_by_section (oldsec) < 0)
+    return true;
+  /* An ordinary common names no space.  */
+  if (bfd_is_com_section (sec) && i51_common_by_section (sec) < 0)
+    return true;
+  if (strcmp (oldsec->name, "COMMON") == 0
+      || (bfd_is_com_section (oldsec) && i51_common_by_section (oldsec) < 0))
+    return true;
+
+  space = i51_section_space (sec);
+  oldspace = i51_section_space (oldsec);
+  if (space == I51_SPACE_ANY || oldspace == I51_SPACE_ANY || space == oldspace)
+    return true;
+
+  if (h->type == bfd_link_hash_common && bfd_is_com_section (sec))
+    (*info->callbacks->multiple_common) (info, h, abfd, bfd_link_hash_common,
+					 size);
+
+  _bfd_error_handler
+    /* xgettext:c-format */
+    (_("%pB: symbol `%s' is in %s (%s) here and in %s (%s) in %pB"),
+     abfd, name, _(i51_space_names[space]), sec->name,
+     _(i51_space_names[oldspace]), oldsec->name, oldsec->owner);
+  bfd_set_error (bfd_error_bad_value);
+  return false;
+}
+
+/* Collect a memory-space common into the section that stands for its
+   space, and hand over the value bfd keeps for a common, which is its
+   size.  The size is in st_size; st_value carries the alignment, the
+   way include/elf/i51.h says it does.
+
+   That alignment is not passed on, and is not honoured today.
+   elf_link_add_object_symbols () reads st_value as an alignment only
+   where elf_backend_common_definition () calls the symbol a common,
+   which by default means st_shndx == SHN_COMMON.  None of the seven
+   indices here is that, so the alignment the linker settles on comes
+   from the alignment_power of the section returned below instead, and
+   a section made by i51_elf_common_section () has none: a memory-space
+   common is placed as though it had asked for byte alignment, whatever
+   its .rcomm line said.  Honouring the request would move symbols in
+   links that already work, so the field is documented rather than
+   obeyed; what the object file records is right either way.  */
+
+static bool
+elf32_i51_add_symbol_hook (bfd *abfd, struct bfd_link_info *info,
+			   Elf_Internal_Sym *sym, const char **namep,
+			   flagword *flagsp ATTRIBUTE_UNUSED,
+			   asection **secp, bfd_vma *valp)
+{
+  int i = i51_common_by_shndx (sym->st_shndx);
+
+  if (i >= 0)
+    {
+      *secp = i51_elf_common_section (abfd, i51_common_spaces[i].name);
+      if (*secp == NULL)
+	return false;
+      *valp = sym->st_size;
+    }
+
+  if (ELF_ST_BIND (sym->st_info) == STB_LOCAL)
+    return true;
+  return elf32_i51_check_common_space (abfd, info, *namep, *secp,
+				       sym->st_size);
+}
+
+/* Before the linker writes out a global symbol: a memory-space common
+   reaches this point as a plain SHN_COMMON, because that is what the
+   generic common_section_index hook returns.  Put back the
+   processor-specific index that names its space - without it a
+   relocatable link degrades every such common to an ordinary one, and
+   the next link allocates it in byte-addressed .bss.  Mirrors
+   _bfd_mips_elf_link_output_symbol_hook.  */
+
+static int
+elf32_i51_link_output_symbol_hook (struct bfd_link_info *info ATTRIBUTE_UNUSED,
+				   const char *name ATTRIBUTE_UNUSED,
+				   Elf_Internal_Sym *sym,
+				   asection *input_sec,
+				   struct elf_link_hash_entry *h ATTRIBUTE_UNUSED)
+{
+  unsigned int i;
+
+  if (sym->st_shndx != SHN_COMMON || input_sec == NULL)
+    return 1;
+
+  for (i = 0; i < ARRAY_SIZE (i51_common_spaces); i++)
+    if (strcmp (input_sec->name, i51_common_spaces[i].name) == 0)
+      sym->st_shndx = i51_common_spaces[i].shndx;
+
+  return 1;
+}
+
+#define ELF_ARCH		bfd_arch_i51
+#define ELF_MACHINE_CODE	EM_8051
+#define ELF_MAXPAGESIZE		1
+
+#define TARGET_BIG_SYM		i51_elf32_vec
+#define TARGET_BIG_NAME		"elf32-i51"
+
+/* Relocations are SHT_RELA, in every section of every object this port
+   writes and in every one it is prepared to read.  Each howto above sets
+   partial_inplace false and takes its addend from the reloc, and
+   i51_final_link_relocate () reads r_addend directly for the five
+   relocations it applies itself, so there is nowhere for an in-place
+   addend to come from.
+
+   elfxx-target.h would derive the three fields below from USE_REL,
+   which this file leaves undefined; saying them here is what its own
+   comment asks new code to do, and it puts the fact in the backend
+   where a reader looks for it.  */
+#define elf_backend_may_use_rel_p	     0
+#define elf_backend_may_use_rela_p	     1
