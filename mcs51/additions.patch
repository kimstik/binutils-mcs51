+static inline char *
+skip_space (char *s)
+{
+  while (*s == ' ' || *s == '\t')
+    ++s;
+  return s;
+}
+
+/* The bit address of bit BIT of the byte at ADDR, or -1 when that byte is
+   not bit addressable.  0x20..0x2f are the bit-addressable RAM bytes; a
+   special function register is bit addressable when its address is a
+   multiple of eight.  */
+
+static int
+i51_bit_address (offsetT addr, offsetT bit)
+{
+  if (bit < 0 || bit > 7)
+    return -1;
+  if (addr >= 0x20 && addr <= 0x2f)
+    return (addr - 0x20) * 8 + bit;
+  if (addr >= 0x80 && addr <= 0xf8 && (addr & 7) == 0)
+    return addr + bit;
+  return -1;
+}
+
+/* Fold a `.N' suffix on a numeric operand into a bit address and say
+   whether there was one.  A name with the suffix - ACC.7, FLAGS.3 - is a
+   name to the expression parser and is folded by i51_parse_name (); a
+   number is not, and expression () stops at the dot.  */
+
+static bool
+i51_fold_bit_suffix (expressionS *exp)
+{
+  int bit;
+
+  if (exp->X_op != O_constant
+      || input_line_pointer[0] != '.'
+      || !ISDIGIT (input_line_pointer[1]))
+    return false;
+
+  bit = i51_bit_address (exp->X_add_number, input_line_pointer[1] - '0');
+  if (bit < 0)
+    as_bad (_("%#lx.%c: %#lx is not bit addressable"),
+	    (unsigned long) exp->X_add_number, input_line_pointer[1],
+	    (unsigned long) exp->X_add_number);
+  exp->X_add_number = bit < 0 ? 0 : bit;
+  input_line_pointer += 2;
+  return true;
+}
+/* Extract one word from FROM and copy it to TO.  */
+
+static char *
+extract_word (char *from, char *to, int limit)
+{
+  char *op_end;
+  int size = 0;
+
+  /* Drop leading whitespace.  */
+  from = skip_space (from);
+  *to = 0;
+
+  /* Find the op code end.  */
+  for (op_end = from; *op_end != 0 && is_part_of_name (*op_end);)
+    {
+      to[size++] = *op_end++;
+      if (size + 1 >= limit)
+	break;
+    }
+
+  to[size] = 0;
+  return op_end;
+}
