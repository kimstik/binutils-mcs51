--- /dev/null
+++ b/ld/testsuite/ld-i51/space.s
@@ -0,0 +1,17 @@
+; Operands that name the wrong memory space.
+	.text
+	.global	_START
+_START:	ljmp	xv		; a code address in external RAM
+	mov	a,xv		; a direct address in external RAM
+	setb	bv		; a bit address naming a byte
+	mov	a,_START	; a direct address naming code
+	sjmp	dv		; a branch into internal RAM
+	acall	xv		; ditto, eleven bits
+	mov	dptr,#xv	; a number: fine
+	mov	a,#low(xv)	; fine
+	.xdata
+xv:	.byte	0
+	.bdata
+bv:	.byte	0
+	.data
+dv:	.byte	0
