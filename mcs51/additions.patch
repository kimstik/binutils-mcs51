diff --git a/ld/testsuite/ld-i51/i51.exp b/ld/testsuite/ld-i51/i51.exp
new file mode 100644
index 00000000..0d016225
--- /dev/null
+++ b/ld/testsuite/ld-i51/i51.exp
@@ -0,0 +1,115 @@
+# Copyright (C) 2026 Free Software Foundation, Inc.
+#
+# This file is part of the GNU Binutils.
+#
+# This program is free software; you can redistribute it and/or modify
+# it under the terms of the GNU General Public License as published by
+# the Free Software Foundation; either version 3 of the License, or
+# (at your option) any later version.
+#
+# This program is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program; if not, write to the Free Software
+# Foundation, Inc., 51 Franklin Street - Fifth Floor, Boston,
+# MA 02110-1301, USA.
+
+# MCS-51 (i51) linker tests.
+
+if {![istarget i51-*-*]} {
+    return
+}
+
+foreach test [lsort [glob -nocomplain $srcdir/$subdir/*.d]] {
+    run_dump_test [file rootname $test]
+}
+
+# Objects of another ABI generation.  The assembler writes the current
+# one, so the generation is set in the header of an assembled object.
+
+proc i51_generation_object { src gen obj } {
+    global as srcdir subdir
+
+    if { ![ld_assemble $as $srcdir/$subdir/$src $obj] } {
+	return 0
+    }
+    set f [open $obj r+]
+    fconfigure $f -translation binary
+    seek $f 36
+    puts -nonewline $f [binary format I $gen]
+    close $f
+    return 1
+}
+
+proc i51_run { prog args } {
+    set got [remote_exec host $prog $args]
+    return [lindex $got 1]
+}
+
+set test "i51 common alignment of ABI generation 0 is not read"
+if { ![i51_generation_object align.s 0 tmpdir/align0.o]
+     || ![ld_link $ld tmpdir/align0 tmpdir/align0.o] } {
+    fail $test
+} elseif { [regexp {(^|\s)0+1 B FOUR} [i51_run $NM -n tmpdir/align0]] } {
+    pass $test
+} else {
+    fail $test
+}
+
+set test "i51 ld -r writes the current ABI generation"
+if { ![ld_link $ld tmpdir/align0.r "-r tmpdir/align0.o"] } {
+    fail $test
+} else {
+    set out [i51_run $READELF -hs tmpdir/align0.r]
+    if { [regexp {Flags: +0x1\s} $out]
+	 && [regexp {00000001 +4 OBJECT +GLOBAL DEFAULT +PRC\[0xff04\] FOUR} $out] } {
+	pass $test
+    } else {
+	fail $test
+    }
+}
+
+set test "i51 unknown ABI generation is refused"
+if { ![i51_generation_object align.s 2 tmpdir/align2.o] } {
+    fail $test
+} elseif { [ld_link $ld tmpdir/align2 tmpdir/align2.o] } {
+    fail $test
+} elseif { [regexp {unknown e_flags 0x2} $link_output] } {
+    pass $test
+} else {
+    fail $test
+}
+
+# A memory-space common whose alignment is not a power of 2 up to 0x10000
+# is refused, rather than handed to the generic common code.
+foreach align {0xfffffffe 0 3 0x20000} {
+    set test "i51 malformed common alignment $align is refused"
+    if { ![ld_assemble $as $srcdir/$subdir/align-bad.s tmpdir/align-bad.o] } {
+	fail $test
+	continue
+    }
+    set f [open tmpdir/align-bad.o r+]
+    fconfigure $f -translation binary
+    set data [read $f]
+    # The symbol entry: st_value 4, st_size 4, GLOBAL OBJECT, SHN_I51_XDATA_C.
+    set at [string first [binary format IIccS 4 4 0x11 0 0xff04] $data]
+    if { $at < 0 } {
+	close $f
+	fail $test
+	continue
+    }
+    seek $f $at
+    puts -nonewline $f [binary format I $align]
+    close $f
+    if { [ld_link $ld tmpdir/align-bad tmpdir/align-bad.o] } {
+	fail $test
+    } elseif { [regexp {has alignment (0x[0-9a-f]+|0),} $link_output all got]
+	       && $got == $align } {
+	pass $test
+    } else {
+	fail $test
+    }
+}
