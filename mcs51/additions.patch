+  return 0;
+}
+
+/* MCS-51 symbols are case insensitive (acc.7 is the same as Acc.7 and
+   ACC.7), which gas implements by folding every symbol name to upper case
+   as it is created.  This has to be turned on from tc_init_after_args
+   rather than from md_begin: gas_init () defines the --defsym symbols
+   before md_begin () runs, so setting it any later leaves those names
+   unfolded and unreachable from the source.  */
+
+void
+i51_init_after_args (void)
+{
+  symbols_case_sensitive = 0;
+}
+
+
+/* Build SEC and SYM as a fake common section of NAME, like
+   bfd_com_section.  */
+
+static void
+i51_make_com_section (asection *sec, asymbol *sym, const char *name)
+{
+  *sec = *bfd_com_section_ptr;
+  sec->name = name;
+  sec->output_section = sec;
+  sec->symbol = sym;
+  *sym = *bfd_com_section_ptr->symbol;
+  sym->name = name;
+  sym->section = sec;
+}
+
+void
+md_begin (void)
+{
+  struct i51_opcodes_s *opc;
+  struct i51_directop_s *dop;
+  int i;
+  i51_hash = str_htab_create ();
+  i51_operand = str_htab_create ();
+  i51_builtin_used = str_htab_create ();
+
+  /* Insert unique names into hash table.  This hash table then provides a
+     quick index to the first opc with a particular name in the opc
+     table.  */
+  for (opc = i51_opcodes; opc->name; opc++)
+    str_hash_insert (i51_hash, opc->name, (char *) opc, 0);
+  /* Insert unique names into hash table.  This hash table then provides a
+     quick index to the operand table.  */
+  for (dop = i51_directop; dop->op; dop++)
+    str_hash_insert (i51_operand, dop->op, (char *) dop, 0);
+
+  i51_make_com_section (&regbank_com_section, &regbank_com_symbol,
+			".regbank");
+  for (i = I51_RBSS; i <= I51_BITBSS; i++)
+    i51_make_com_section (&i51_com_sections[i], &i51_com_symbols[i],
+			  i51_spaces[i].name);
+}
+
+/* Look NAME up among the built-in operand names, folding it to upper
+   case the way every name of this assembler is folded.  */
+
+static const struct i51_directop_s *
+i51_builtin (const char *name, size_t len)
+{
+  char upper[16];
+  size_t i;
+
+  if (len >= sizeof (upper))
+    return NULL;
+  for (i = 0; i < len; i++)
+    upper[i] = TOUPPER ((unsigned char) name[i]);
+  upper[len] = 0;
+  return (const struct i51_directop_s *) str_hash_find (i51_operand, upper);
+}
+
+/* Whether the program has a symbol called NAME - one it defined, or
+   declared with .local, .global or the like.  Such a symbol is what the
+   name means, whatever built-in name it shares: `.local WMCON' and
+   `.equ WMCON, 0x96' give WMCON the program's own value.  */
+
+static bool
+i51_user_symbol (const char *name, size_t len)
+{
+  char *copy = xmemdup0 (name, len);
+  bool found = symbol_find (copy) != NULL;
+
+  free (copy);
+  return found;
+}
+
+/* Record that the built-in name DOP stands for was used as such.  */
+
+static void
+i51_note_builtin (const struct i51_directop_s *dop)
+{
+  str_hash_insert (i51_builtin_used, dop->op, dop, 1);
+}
+
+/* The value a built-in byte or bit name stands for, as a constant.  An
+   ARn names register n of the bank the last .using selected.  */
+
+static void
+i51_builtin_value (const struct i51_directop_s *dop, expressionS *exp)
+{
+  exp->X_op = O_constant;
+  exp->X_add_number = dop->value;
+  if (dop->ref == 'U')
+    {
+      if (regbank == 0xFF)
+	as_bad (_("missing .using"));
+      else
+	exp->X_add_number += regbank;
+    }
+  i51_note_builtin (dop);
+}
+
+/* Parse the parenthesised argument list of HIGH, LOW or B2B, with
+   input_line_pointer on the '('.  */
+
+static bool
+i51_operator_args (const char *op, expressionS *arg, offsetT *bit)
+{
+  ++input_line_pointer;
+  expression (arg);
+  if (arg->X_op == O_absent)
+    {
+      as_bad (_("missing operand of %s()"), op);
+      return false;
+    }
+  SKIP_WHITESPACE ();
+  if (bit != NULL)
+    {
+      if (*input_line_pointer != ',')
+	{
+	  as_bad (_("%s() takes a byte address and a bit number"), op);
+	  return false;
+	}
+      ++input_line_pointer;
+      *bit = get_absolute_expression ();
+      SKIP_WHITESPACE ();
+    }
+  if (*input_line_pointer != ')')
+    {
+      as_bad (_("missing `)' after %s()"), op);
+      return false;
+    }
+  ++input_line_pointer;
+  return true;
+}
+
+/* Make EXP the operator OP applied to ARG, or the constant it folds to
+   when ARG is one.  */
+
+static void
+i51_apply_operator (expressionS *exp, operatorT op, expressionS *arg,
+		    offsetT bit)
+{
+  i51_operator_class = op == O_i51_b2b ? 'B' : 'D';
+  if (arg->X_op == O_constant)
+    {
+      offsetT v = arg->X_add_number;
+      int b;
+
+      exp->X_op = O_constant;
+      switch (op)
+	{
+	case O_i51_high:
+	  if (v < -32768 || v > 65535)
+	    as_bad (_("operand of HIGH() out of 16-bit range: %ld"), (long) v);
+	  exp->X_add_number = (v >> 8) & 0xff;
+	  break;
+	case O_i51_low:
+	  exp->X_add_number = v & 0xff;
+	  break;
+	default:
+	  b = i51_bit_address (v, bit);
+	  if (bit < 0 || bit > 7)
+	    as_bad (_("bit number %ld of B2B() is not 0..7"), (long) bit);
+	  else if (b < 0)
+	    as_bad (_("B2B(%#lx,%ld): %#lx is not bit addressable"),
+		    (unsigned long) v, (long) bit, (unsigned long) v);
+	  exp->X_add_number = b < 0 ? 0 : b;
+	  break;
+	}
+      return;
+    }
+
+  if (op == O_i51_b2b && (bit < 0 || bit > 7))
+    as_bad (_("bit number %ld of B2B() is not 0..7"), (long) bit);
+
+  exp->X_op = op;
+  if (arg->X_op == O_symbol)
+    {
+      exp->X_add_symbol = arg->X_add_symbol;
+      exp->X_add_number = arg->X_add_number;
+    }
+  else
+    {
+      exp->X_add_symbol = make_expr_symbol (arg);
+      exp->X_add_number = 0;
+    }
+  exp->X_op_symbol = NULL;
+  exp->X_md = op == O_i51_b2b ? bit : 0;
+}
+
+/* md_parse_name: the names of the MCS-51 assembly language.
+
+   HIGH (x), LOW (x) and B2B (x, n) are operators.  A register, special
+   function register or bit name, and AR0..AR7, stand for their address
+   unless the program has a symbol of that name.  NAME.N names bit N of
+   the byte NAME, whether NAME is a special function register or a
+   symbol of the program.  The general registers are no addresses and are
+   refused in an expression.  */
+
+int
+i51_parse_name (const char *name, expressionS *exp,
+		enum expr_mode mode ATTRIBUTE_UNUSED, char *nextcharP)
+{
+  size_t len = strlen (name);
+  const struct i51_directop_s *dop;
+  static const struct { const char *name; operatorT op; } operators[] =
+    {
+      { "HIGH", O_i51_high },
+      { "LOW",  O_i51_low },
+      { "B2B",  O_i51_b2b },
+    };
+  size_t i;
+
+  /* The operators, when what follows the name is a parenthesis.  */
+  for (i = 0; i < ARRAY_SIZE (operators); i++)
+    if (strcasecmp (name, operators[i].name) == 0)
+      {
+	char *p = input_line_pointer;
+	expressionS arg;
+	offsetT bit = 0;
+
+	*p = *nextcharP;
+	p = skip_space (p);
+	if (*p != '(')
+	  {
+	    *input_line_pointer = 0;
+	    break;
+	  }
+	input_line_pointer = p;
+	if (i51_operator_args (operators[i].name, &arg,
+			       operators[i].op == O_i51_b2b ? &bit : NULL))
+	  i51_apply_operator (exp, operators[i].op, &arg, bit);
+	else
+	  {
+	    exp->X_op = O_constant;
+	    exp->X_add_number = 0;
+	  }
+	*nextcharP = *input_line_pointer;
+	*input_line_pointer = 0;
+	return 1;
+      }
+
+  if (i51_user_symbol (name, len))
+    return 0;
+
+  dop = i51_builtin (name, len);
+  if (dop != NULL)
+    {
+      if (dop->ref == 'D' || dop->ref == 'B' || dop->ref == 'U')
+	i51_builtin_value (dop, exp);
+      else
+	{
+	  as_bad (_("register `%s' is not valid in an expression"), name);
+	  exp->X_op = O_constant;
+	  exp->X_add_number = 0;
+	}
+      return 1;
+    }
+
+  /* NAME.N: bit N of the byte NAME.  */
+  if (len > 2 && name[len - 2] == '.' && ISDIGIT (name[len - 1]))
+    {
+      expressionS arg;
+      offsetT bit = name[len - 1] - '0';
+
+      dop = i51_builtin (name, len - 2);
+      if (dop != NULL && !i51_user_symbol (name, len - 2))
+	{
+	  if (dop->ref != 'D')
+	    {
+	      as_bad (_("`%s' is not a bit address"), name);
+	      exp->X_op = O_constant;
+	      exp->X_add_number = 0;
+	      return 1;
+	    }
+	  i51_builtin_value (dop, &arg);
+	}
+      else
+	{
+	  char *base = xmemdup0 (name, len - 2);
+
+	  arg.X_op = O_symbol;
+	  arg.X_add_symbol = symbol_find_or_make (base);
+	  arg.X_add_number = 0;
+	  free (base);
+	  if (S_GET_SEGMENT (arg.X_add_symbol) == absolute_section
+	      && !S_FORCE_RELOC (arg.X_add_symbol, 0))
+	    {
+	      arg.X_op = O_constant;
+	      arg.X_add_number = S_GET_VALUE (arg.X_add_symbol);
+	    }
+	}
+      i51_apply_operator (exp, O_i51_b2b, &arg, bit);
+      return 1;
+    }
+
+  return 0;
+}
+
+/* tc_frob_symbol: refuse a symbol whose name the file has already used
+   as a built-in register name.  */
+
+void
+i51_frob_symbol (symbolS *sym)
+{
+  if (S_IS_DEFINED (sym)
+      && !symbol_section_p (sym)
+      && str_hash_find (i51_builtin_used, S_GET_NAME (sym)) != NULL)
+    as_bad (_("`%s' was used as the built-in register name before this "
+	      "file defined it; declare it with .local before its first use"),
+	    S_GET_NAME (sym));
+}
+
+/* Parse one operand at input_line_pointer into OP.  */
+
+static bool
+i51_parse_operand (struct i51_operand *op)
+{
+  char *p, *end;
+  const struct i51_directop_s *dop;
+
+  memset (op, 0, sizeof (*op));
+  SKIP_WHITESPACE ();
+  p = input_line_pointer;
+
+  /* An operand that is one built-in name: followed by a comma, by the end
+     of the statement, or by something that cannot continue an expression,
+     which is then reported as junk.  */
+  for (end = p; *end != ',' && !is_whitespace (*end) && !is_end_of_stmt (*end);
+       end++)
+    ;
+  if (*skip_space (end) == ',' || is_end_of_stmt (*skip_space (end))
+      || is_name_beginner (*skip_space (end)))
+    {
+      dop = i51_builtin (p, end - p);
+      if (dop != NULL
+	  && !((dop->ref == 'D' || dop->ref == 'B' || dop->ref == 'U')
+	       && i51_user_symbol (p, end - p)))
+	{
+	  input_line_pointer = end;
+	  switch (dop->ref)
+	    {
+	    case 'D':
+	    case 'B':
+	      op->cls = dop->ref;
+	      i51_builtin_value (dop, &op->exp);
+	      break;
+	    case 'U':
+	      op->cls = 'D';
+	      i51_builtin_value (dop, &op->exp);
+	      break;
+	    case '/':
+	      op->cls = '/';
+	      op->exp.X_op = O_constant;
+	      op->exp.X_add_number = dop->value;
+	      break;
+	    default:
+	      op->cls = dop->ref;
+	      op->reg = dop->value;
+	      break;
+	    }
+	  return true;
+	}
+    }
+
+  switch (*p)
+    {
+    case '@':
+      as_bad (_("invalid indirect operand `%.*s'"), (int) (end - p), p);
+      return false;
+    case '#':
+    case '/':
+      op->cls = *p;
+      input_line_pointer = p + 1;
+      break;
+    default:
+      op->cls = 'E';
+      break;
+    }
+
+  i51_operator_class = 0;
+  expression (&op->exp);
+  if (op->exp.X_op == O_absent)
+    {
+      as_bad (_("missing operand"));
+      return false;
+    }
+  if (i51_fold_bit_suffix (&op->exp))
+    i51_operator_class = 'B';
+
+  /* A constant a bit or byte operator made keeps its kind.  */
+  if (op->exp.X_op == O_constant && i51_operator_class != 0)
+    {
+      if (op->cls == 'E')
+	op->cls = i51_operator_class;
+      else if (op->cls == '#' && i51_operator_class == 'B')
+	{
+	  as_bad (_("a bit address is not a number"));
+	  return false;
+	}
+      else if (op->cls == '/' && i51_operator_class == 'D')
+	{
+	  as_bad (_("HIGH() and LOW() name a byte, not a bit"));
+	  return false;
+	}
+    }
+
+  switch (op->exp.X_op)
+    {
+    case O_i51_high:
+    case O_i51_low:
+      if (op->cls == 'E')
+	op->cls = 'D';
+      else if (op->cls == '/')
+	{
+	  as_bad (_("HIGH() and LOW() name a byte, not a bit"));
+	  return false;
+	}
+      break;
+    case O_i51_b2b:
+      if (op->cls == 'E')
+	op->cls = 'B';
+      else if (op->cls == '#')
+	{
+	  as_bad (_("B2B() names a bit, not a number"));
+	  return false;
+	}
+      break;
+    default:
+      break;
+    }
+  return true;
+}
+
+/* Whether the operands fit the opcode table row OPC.  */
+
+static bool
+i51_row_fits (const struct i51_opcodes_s *opc,
+	      const struct i51_operand *ops, int nops)
+{
+  int i;
+
+  for (i = 0; i < I51_MAX_OPERANDS; i++)
+    {
+      char arg = opc->args[i];
+
+      if (i >= nops)
+	{
+	  if (arg != 'N')
+	    return false;
+	  continue;
+	}
+      if (arg == 'N')
+	return false;
+      if (ops[i].cls == 'E')
+	{
+	  if (arg != 'D' && arg != 'B' && arg != 'J' && arg != '1'
+	      && arg != '6')
+	    return false;
+	}
+      else if (ops[i].cls != arg)
+	return false;
+    }
+  return true;
+}
+
+/* The first row of the opcode table for MNEMONIC whose operands OPS fit,
+   or NULL.  The rows of one mnemonic are adjacent and the hash table
+   names the first of them.  */
+
+static const struct i51_opcodes_s *
+i51_find_row (const char *mnemonic, const struct i51_operand *ops, int nops)
+{
+  const struct i51_opcodes_s *first, *opc;
+
+  first = (const struct i51_opcodes_s *) str_hash_find (i51_hash, mnemonic);
+  if (first == NULL)
+    return NULL;
+  for (opc = first; opc->name != NULL && strcmp (opc->name, first->name) == 0;
+       opc++)
+    if (i51_row_fits (opc, ops, nops))
+      return opc;
+  return NULL;
+}
+
+/* The generic jump and call of MCS-51 assembly: `jmp' and `call' with a
+   code address operand are the long forms, which reach the whole code
+   space.  Nothing is relaxed, so the long form is the one that is always
+   right.  */
+
+static const struct
+{
+  const char *name;
+  const char *real;
+} i51_aliases[] =
+  {
+    { "jmp",  "ljmp" },
+    { "call", "lcall" },
+  };
+
+static void
+i51_assemble (char *str)
+{
+  struct i51_operand ops[I51_MAX_OPERANDS];
+  const struct i51_opcodes_s *opc;
+  expressionS *exprs[2] = { NULL, NULL };
+  unsigned int regno = 0;
+  char name[11];
+  int nops = 0;
+  int nexprs = 0;
+  int i;
+
+  memset (ops, 0, sizeof (ops));
+  str = skip_space (extract_word (str, name, sizeof (name)));
+  if (name[0] == 0)
+    {
+      as_bad (_("can't find opcode"));
+      return;
+    }
+
+  input_line_pointer = str;
+  if (!is_end_of_stmt (*input_line_pointer))
+    for (;;)
+      {
+	if (nops == I51_MAX_OPERANDS)
+	  {
+	    as_bad (_("too many operands"));
+	    return;
+	  }
+	if (!i51_parse_operand (&ops[nops++]))
+	  return;
+	SKIP_WHITESPACE ();
+	if (*input_line_pointer != ',')
+	  break;
+	++input_line_pointer;
+      }
+  if (!is_end_of_stmt (*input_line_pointer))
+    {
+      as_bad (_("junk at end of line, first unrecognized character is `%c'"),
+	      *input_line_pointer);
+      return;
+    }
+
+  opc = i51_find_row (name, ops, nops);
+  for (i = 0; opc == NULL && i < (int) ARRAY_SIZE (i51_aliases); i++)
+    if (strcasecmp (name, i51_aliases[i].name) == 0)
+      opc = i51_find_row (i51_aliases[i].real, ops, nops);
+  if (opc == NULL)
+    {
+      /* HIGH () or LOW () where the row wants a branch target.  */
+      for (i = 0; i < nops; i++)
+	if (ops[i].exp.X_op == O_i51_high || ops[i].exp.X_op == O_i51_low)
+	  {
+	    const struct i51_opcodes_s *alt;
+
+	    ops[i].cls = 'E';
+	    alt = i51_find_row (name, ops, nops);
+	    ops[i].cls = 'D';
+	    if (alt != NULL)
+	      {
+		as_bad (_("HIGH() and LOW() are not allowed on a code "
+			  "address"));
+		return;
+	      }
+	  }
+      if (str_hash_find (i51_hash, name) == NULL
+	  && strcasecmp (name, "call") != 0)
+	as_bad (_("unknown opcode `%s'"), name);
+      else
+	as_bad (_("invalid instruction operands"));
+      return;
+    }
+
+  /* The expressions, in operand order, and the register number.  */
+  for (i = 0; i < nops; i++)
+    switch (ops[i].cls)
+      {
+      case 'R':
+      case 'I':
+	regno = ops[i].reg;
+	break;
+      case '#':
+      case '/':
+      case 'D':
+      case 'B':
+      case 'E':
+	exprs[nexprs++] = &ops[i].exp;
+	break;
+      default:
+	break;
+      }
+
+  i51_build_ins (opc, regno, exprs[0], exprs[1]);
+  dwarf2_emit_insn (opc->insn_size & 0x03);
+}
+
+void
+md_assemble (char *str)
+{
+  char *saved = input_line_pointer;
+
+  i51_assemble (str);
+  input_line_pointer = saved;
+}
+
+/* GAS will call this function for each section at the end of the assembly,
+   to permit the CPU backend to adjust the alignment of a section.  */
+
+valueT
+md_section_align (asection *seg, valueT addr)
+{
+  int align = bfd_section_alignment (seg);
+  return ((addr + ((valueT) 1 << align) - 1) & -((valueT) 1 << align));
+}
+
+/* If you define this macro, it should return the offset between the
+   address of a PC relative fixup and the position from which the PC
+   relative adjustment should be made.  On many processors, the base
+   of a PC relative instruction is the next instruction, so this
+   macro would return the length of an instruction.  */
+
+long
+md_pcrel_from_section (fixS *fixp, segT sec)
+{
+  if (fixp->fx_addsy != (symbolS *) NULL
+      && (!S_IS_DEFINED (fixp->fx_addsy)
+	  || (S_GET_SEGMENT (fixp->fx_addsy) != sec)))
+    return 0;
+  return fixp->fx_frag->fr_address + fixp->fx_where + 1;
+}
+
+/* Report VALUE out of the range LO..HI of the field FIXP fills.  */
+
+static void
+i51_fix_range (fixS *fixp, offsetT value, offsetT lo, offsetT hi)
+{
+  if (value < lo || value > hi)
+    as_bad_where (fixp->fx_file, fixp->fx_line,
+		  _("operand out of range: %lld"), (long long) value);
+}
+
+/* GAS will call this for each fixup.  It should store the correct
+   value in the object file.  */
+
+void
+md_apply_fix (fixS *fixp, valueT *valuep, segT seg)
+{
+  bfd_byte *where = (bfd_byte *) fixp->fx_frag->fr_literal + fixp->fx_where;
+  offsetT value = *valuep;
+  bfd_vma insn;
+  int bit;
+
+  /* Every field is range-checked below by the rule of its own operand,
+     which is narrower than the width test write.c would make.  */
+  fixp->fx_no_overflow = 1;
+
+  /* A fixup is final here only when no symbol is left on it.  A
+     pc-relative one that still has a symbol targets a global, weak,
+     absolute or other-section address, and the displacement to that is
+     only known once the linker has placed this section; a local target
+     in this section has been folded by fixup_segment (), which clears
+     fx_pcrel.  An ACALL/AJMP target is never final here: A15..A11 come
+     from the address of the following instruction.  */
+  if (fixp->fx_addsy == NULL && fixp->fx_subsy == NULL && !fixp->fx_pcrel
+      && fixp->fx_r_type != BFD_RELOC_I51_11)
+    fixp->fx_done = 1;
+  /* A global defined in this section is final too, unless it is weak: a
+     strong definition elsewhere would replace it, and the branch has to
+     follow, as an ljmp to it does.  */
+  else if (fixp->fx_pcrel && fixp->fx_addsy != NULL && fixp->fx_subsy == NULL
+	   && S_GET_SEGMENT (fixp->fx_addsy) == seg
+	   && S_IS_DEFINED (fixp->fx_addsy) && !S_IS_WEAK (fixp->fx_addsy))
+    fixp->fx_done = 1;
+
+  if (fixp->fx_subsy != NULL)
+    as_bad_subtract (fixp);
+
+  i51_check_direct (fixp, value);
+
+  if (!fixp->fx_done)
+    {
+      /* A branch to an absolute address still goes to the linker, but the
+	 displacement it has if the section starts at zero is written in
+	 place too, so that the object disassembles to the target; the
+	 linker writes the byte again.  */
+      if (fixp->fx_r_type == BFD_RELOC_I51_7_PCREL
+	  && S_GET_SEGMENT (fixp->fx_addsy) == absolute_section
+	  && value >= -128 && value <= 127)
+	where[0] = value & 0xff;
+      fixp->fx_addnumber = value;
+      return;
+    }
+
+  switch (fixp->fx_r_type)
+    {
+    case BFD_RELOC_I51_8_LOW:
+      where[0] = value & 0xff;
+      break;
+
+    case BFD_RELOC_I51_8_HIGH:
+      i51_fix_range (fixp, value, -32768, 65535);
+      where[0] = (value >> 8) & 0xff;
+      break;
+
+    case BFD_RELOC_8:
+    case BFD_RELOC_I51_8_IMM:
+      i51_fix_range (fixp, value, -128, 255);
+      where[0] = value & 0xff;
+      break;
+
+    case BFD_RELOC_I51_8_DIR:
+    case BFD_RELOC_I51_8_BIT:
+      i51_fix_range (fixp, value, 0, 255);
+      where[0] = value & 0xff;
+      break;
+
+    case BFD_RELOC_I51_7_PCREL:
+      i51_fix_range (fixp, value, -128, 127);
+      where[0] = value & 0xff;
+      break;
+
+    case BFD_RELOC_16:
+      i51_fix_range (fixp, value, -32768, 65535);
+      bfd_putb16 (value, where);
+      break;
+
+    case BFD_RELOC_I51_16_CODE:
+      i51_fix_range (fixp, value, 0, 65535);
+      bfd_putb16 (value, where);
+      break;
+
+    case BFD_RELOC_32:
+      bfd_putb32 (value, where);
+      break;
+
+    case BFD_RELOC_I51_8_B2B:
+      /* The byte holds the bit number inside the byte VALUE names; fold
+	 the two into a bit address.  Mirrors R_I51_8_B2B in
+	 bfd/elf32-i51.c.  */
+      bit = i51_bit_address (value, where[0]);
+      if (where[0] > 7)
+	as_bad_where (fixp->fx_file, fixp->fx_line,
+		      _("bit number %d of B2B() is not 0..7"), where[0]);
+      else if (bit < 0)
+	as_bad_where (fixp->fx_file, fixp->fx_line,
+		      _("B2B(%#llx,%d): %#llx is not bit addressable"),
+		      (unsigned long long) value, where[0],
+		      (unsigned long long) value);
+      where[0] = bit < 0 ? 0 : bit;
+      break;
+
+    case BFD_RELOC_I51_13_PCODE:
+      /* Mirrors R_I51_13_PCODE in bfd/elf32-i51.c.  */
+      if (value > 0x1fff)
+	as_bad_where (fixp->fx_file, fixp->fx_line,
+		      _("pcode exec address out of 13-bit range: %#llx"),
+		      (unsigned long long) value);
+      else if (value < 0x100)
+	as_bad_where (fixp->fx_file, fixp->fx_line,
+		      _("pcode exec address underflow: %#llx"),
+		      (unsigned long long) value);
+      insn = bfd_getb16 (where) & 0xe000;
+      bfd_putb16 (insn | (value & 0x1fff), where);
+      break;
+
+    default:
+      as_fatal (_("line %d: unknown relocation type: 0x%x"),
+		fixp->fx_line, fixp->fx_r_type);
+      break;
+    }
+}
+
+/* Turn a string in input_line_pointer into a floating point constant
+   of type TYPE, and store the appropriate bytes in *LITP.  The number
+   of LITTLENUMS emitted is stored in *SIZEP.  An error message is
+   returned, or NULL on OK.  */
+
+const char *
+md_atof (int type, char *litp, int *sizep)
+{
+  int prec;
+  LITTLENUM_TYPE words[4];
+  char *t;
+  int i;
+
+  switch (type)
+    {
+    case 'f':
+      prec = 2;
+      break;
+
+    case 'd':
+      prec = 4;
+      break;
+
+    default:
+      *sizep = 0;
+      return _("bad call to md_atof");
+    }
+
+  t = atof_ieee (input_line_pointer, type, words);
+  if (t)
+    input_line_pointer = t;
+
+  *sizep = prec * 2;
+
+  if (target_big_endian)
+    {
+      for (i = 0; i < prec; i++)
+	{
+	  md_number_to_chars (litp, (valueT) words[i], 2);
+	  litp += 2;
+	}
+    }
+  else
+    {
+      for (i = prec - 1; i >= 0; i--)
+	{
+	  md_number_to_chars (litp, (valueT) words[i], 2);
+	  litp += 2;
+	}
+    }
+
+  return NULL;
+}
+
+static void
+i51_bit (int ignore ATTRIBUTE_UNUSED)
+{
+  expressionS exp;
+
+  if (is_it_end_of_statement ())
+    {
+      demand_empty_rest_of_line ();
+      return;
+    }
+
+  do
+    {
+      /* A bit is a 0 or a 1, so there is no byte for HIGH(), LOW() or
+	 B2B() to name.  */
+      expression (&exp);
+      if (exp.X_op == O_i51_high || exp.X_op == O_i51_low
+	  || exp.X_op == O_i51_b2b)
+	{
+	  as_bad (_("HIGH(), LOW() and B2B() are not allowed in `.bit'"));
+	  ignore_rest_of_line ();
+	  return;
+	}
+      if (exp.X_op == O_constant)
+	{
+	  if ((exp.X_add_number > 1) || (exp.X_add_number < 0))
+	    {
+	      as_bad (_("bit value is not in range 0..1 %ld"),
+		      (long) exp.X_add_number);
+	      ignore_rest_of_line ();
+	      return;
+	    }
+	}
+      emit_expr (&exp, (unsigned int) 1);
+    }
+  while (*input_line_pointer++ == ',');
+
+  input_line_pointer--;		/* Put terminator back into stream.  */
+
+  demand_empty_rest_of_line ();
+}
+
+/* Every name this assembler knows without being told is handled by
+   i51_parse_name (), and none of them is a symbol.  */
+
+symbolS *
+md_undefined_symbol (char *name ATTRIBUTE_UNUSED)
+{
+  return NULL;
+}
+
+void
+md_convert_frag (bfd *abfd ATTRIBUTE_UNUSED, asection *sec ATTRIBUTE_UNUSED, fragS *fragP ATTRIBUTE_UNUSED)
+{
+  abort ();
+}
+
+/* A `BFD_ASSEMBLER' GAS will call this to generate a reloc.  GAS
+   will pass the resulting reloc to `bfd_install_relocation'.  This
+   currently works poorly, as `bfd_install_relocation' often does the
+   wrong thing, and instances of `tc_gen_reloc' have been written to
+   work around the problems, which in turns makes it difficult to fix
+   `bfd_install_relocation'.  */
+
+/* If while processing a fixup, a reloc really needs to be created
+   then it is done here.  */
+
+arelent *
+tc_gen_reloc (asection *seg ATTRIBUTE_UNUSED, fixS *fixp)
+{
+  arelent *reloc;
+
+  reloc = (arelent *) xmalloc (sizeof (arelent));
+
+  reloc->sym_ptr_ptr = (asymbol **) xmalloc (sizeof (asymbol *));
+  *reloc->sym_ptr_ptr = symbol_get_bfdsym (fixp->fx_addsy);
+
+  reloc->address = fixp->fx_frag->fr_address + fixp->fx_where;
+  reloc->howto = bfd_reloc_type_lookup (stdoutput, fixp->fx_r_type);
+  if (reloc->howto == (reloc_howto_type *) NULL)
+    {
+      as_bad_where (fixp->fx_file, fixp->fx_line,
+		    _("reloc %d not supported by object file format"),
+		    (int) fixp->fx_r_type);
+      return NULL;
+    }
+
+  if (fixp->fx_r_type == BFD_RELOC_VTABLE_INHERIT
+      || fixp->fx_r_type == BFD_RELOC_VTABLE_ENTRY)
+     reloc->address = fixp->fx_offset;
+
+  reloc->addend = fixp->fx_offset;
+
+  if (fixp->fx_pcrel)
+    reloc->addend -= 1;
+
+  return reloc;
+}
+
+/* The addressing mode an opcode table row gives one of its operands: an
+   expression written as a direct address, one written as an immediate, or
+   neither - a register, a bit or a branch target.  */
+
+static int
+i51_arg_kind (char arg)
+{
+  if (arg == 'D')
+    return I51_OP_DIRECT;
+  if (arg == '#')
+    return I51_OP_IMMEDIATE;
+  return 0;
+}
+
+static void
+i51_build_ins (const struct i51_opcodes_s *opc, unsigned int regnumber,
+	       expressionS *expr1, expressionS *expr2)
+{
+  unsigned char bin_opcode;
+  char *frag;
+  int kind1, kind2;
+
+  bin_opcode = opc->bin_opcode;
+
+  /* The mode of each operand that carries an expression, in the order
+     i51_assemble () fills EXPR1 and EXPR2 in: EXPR1 is the first
+     operand's expression when that operand has one - "mov DVAR,#1" - and
+     the second operand's otherwise - "mov a,DVAR".  */
+  kind1 = i51_arg_kind (opc->args[0]);
+  kind2 = i51_arg_kind (opc->args[1]);
+  if (kind1 == 0)
+    {
+      kind1 = kind2;
+      kind2 = 0;
+    }
+
+  /* place register operand to instruction code */
+  switch (opc->mreloc)
+    {
+    case 'I':			/* register indirect - IIIIIIIr */
+    case 'i':			/* reg. indirect, data - IIIIIIIr dddddddd */
+    case 'X':			/* reg. indirect, r. jump - IIIIIIIr dddddddd aaaaaaaa */
+      bin_opcode |= regnumber & 0x01;
+      break;
+    case 'R':			/* register - IIIIIrrr */
+    case 'r':			/* register, data - IIIIIrrr dddddddd */
+    case 'Y':			/* register, rel. jump - IIIIIrrr dddddddd aaaaaaaa */
+    case 'W':			/* register, rel. jump - IIIIIrrr aaaaaaaa */
+      bin_opcode |= regnumber & 0x07;
+      break;
+    default:
+      break;
+    }
+
+  switch (opc->mreloc)
+    {
+    case 'N':			/* none - IIIIIIII */
+    case 'I':			/* register indirect - IIIIIIIr */
+    case 'R':			/* register - IIIIIrrr */
+      frag = frag_more (1);
+      md_number_to_chars (frag, bin_opcode, 1);
+      break;
+
+    case 'D':			/* data 8 bit - IIIIIIII dddddddd */
+    case 'i':			/* reg. indirect, data - IIIIIIIr dddddddd */
+    case 'r':			/* register, data - IIIIIrrr dddddddd */
+      frag = frag_more (1);
+      md_number_to_chars (frag, bin_opcode, 1);
+      fixup8 (expr1, I51_OP_IMM8, kind1);
+      break;
+
+    case '7':			/* relative jump 8 bit - IIIIIIII aaaaaaaa */
+    case 'W':			/* register, rel. jump - IIIIIrrr aaaaaaaa */
+      frag = frag_more (1);
+      md_number_to_chars (frag, bin_opcode, 1);
+      fixup8 (expr1, I51_OP_JUMP_REL, 0);
+      break;
+
+    case '1':			/* jump 11 bit - aaaIIIII aaaaaaaa */
+      fixup11 (expr1, bin_opcode);
+      break;
+
+    case 'B':			/* bitdata 8 bit - IIIIIIII bbbbbbbb */
+      frag = frag_more (1);
+      md_number_to_chars (frag, bin_opcode, 1);
+      fixup8 (expr1, I51_OP_BIT, 0);
+      break;
+
+    case 'd':			/* data, data 8 bit - IIIIIIII dddddddd dddddddd */
+      /* mov direct,direct encodes the source first.  */
+      frag = frag_more (1);
+      md_number_to_chars (frag, bin_opcode, 1);
+      fixup8 (expr2, I51_OP_IMM8, kind2);
+      fixup8 (expr1, I51_OP_IMM8, kind1);
+      break;
+
+    case 'a':			/* addr, data 8 bit - IIIIIIII aaaaaaaa dddddddd */
+      frag = frag_more (1);
+      md_number_to_chars (frag, bin_opcode, 1);
+      fixup8 (expr1, I51_OP_IMM8, kind1);
+      fixup8 (expr2, I51_OP_IMM8, kind2);
+      break;
+
+    case 'J':			/* bit, r. jump 8 bit - IIIIIIII bbbbbbbb aaaaaaaa */
+      frag = frag_more (1);
+      md_number_to_chars (frag, bin_opcode, 1);
+      fixup8 (expr1, I51_OP_BIT, 0);
+      fixup8 (expr2, I51_OP_JUMP_REL, 0);
+      break;
+
+    case 'X':			/* reg. indirect, r. jump - IIIIIIIr dddddddd aaaaaaaa */
+    case 'Y':			/* register, rel. jump - IIIIIrrr dddddddd aaaaaaaa */
+    case 'Z':			/* data 8 bit, r. jump - IIIIIIII dddddddd aaaaaaaa */
+      frag = frag_more (1);
+      md_number_to_chars (frag, bin_opcode, 1);
+      fixup8 (expr1, I51_OP_IMM8, kind1);
+      fixup8 (expr2, I51_OP_JUMP_REL, 0);
+      break;
+
+    case '6':			/* data/jump 16 bit - IIIIIIII aaaaaaaa aaaaaaaa */
+      frag = frag_more (1);
+      md_number_to_chars (frag, bin_opcode, 1);
+      fixup16 (expr1, opc->args[0] == '6' ? BFD_RELOC_I51_16_CODE
+				: BFD_RELOC_16);
+      break;
+    }
+}
+
+/* Whether NUM fits an operand of MODE; KIND says, for an eight-bit
+   operand, whether the row reads it as a direct address or an
+   immediate.  */
+
+static int
+check_range (offsetT num, int mode, int kind)
+{
+  switch (mode)
+    {
+    case I51_OP_IMM8:
+      /* A direct address names one of the 256 bytes of the internal RAM
+	 and special function register space; an immediate is a byte the
+	 instruction reads as signed or as unsigned.  */
+      if (kind == I51_OP_DIRECT)
+	return num >= 0 && num <= 255;
+      return num >= -128 && num <= 255;
+
+    case I51_OP_BIT:
+      return num >= 0 && num <= 255;
+
+    case I51_OP_JUMP_REL:
+      return num >= -128 && num <= 127;
+
+    case I51_OP_IMM16:
+      return num >= -32768 && num <= 65535;
+
+    default:
+      return 0;
+    }
+}
+
+/* Gas fixup generation.  */
+
+/* Diagnose a direct operand that names memory a direct address cannot
+   reach.  The field is one byte, and on this machine 0x80 through 0xff is
+   the special function register page: the upper half of the internal RAM
+   answers to those same addresses and only @R0/@R1 reaches it.
+
+   A symbol the assembler places itself is decidable here: the value it
+   has for the symbol is its offset in its own memory space, and a space
+   starts at zero or above, so an offset of 0x80 or more is an address of
+   0x80 or more however the linker places the section.  A symbol the
+   linker places is checked by the linker.  This runs from md_apply_fix ()
+   because that offset is only final there.  */
+
+static void
+i51_check_direct (fixS *fixp, offsetT value)
+{
+  symbolS *sym = fixp->tc_fix_data;
+  offsetT addr;
+
+  /* Only a fixup that fixup8 () made for a direct operand carries one.  */
+  if (sym == NULL)
+    return;
+
+  /* An absolute symbol is a special function register equate, which is
+     what belongs above 0x7f; a common carries its size here rather than an
+     address; an undefined symbol has no address until the linker gives it
+     one.  None of the three says where anything is.  */
+  if (!S_IS_DEFINED (sym)
+      || S_IS_COMMON (sym)
+      || S_GET_SEGMENT (sym) == absolute_section)
+    return;
+
+  addr = (fixp->fx_addsy != NULL
+	  ? (offsetT) S_GET_VALUE (fixp->fx_addsy) + (offsetT) fixp->fx_offset
+	  : (offsetT) value);
+  if (addr >= 0x80)
+    as_bad_where (fixp->fx_file, fixp->fx_line,
+		  _("`%s' is at 0x%llx, which a direct address cannot reach: "
+		    "0x80 and above is the special function register page, "
+		    "and RAM there is reachable only through @R0/@R1"),
+		  S_GET_NAME (sym), (unsigned long long) addr);
+}
+
+/* Take the HIGH(), LOW() or B2B() operator off EX, leaving EX the
+   O_symbol it applies to, and return the relocation that applies it, or
+   BFD_RELOC_NONE when EX has none.  *BIT receives the bit number of a
+   B2B().  */
+
+static bfd_reloc_code_real_type
+i51_strip_operator (expressionS *ex, int *bit)
+{
+  bfd_reloc_code_real_type reloc;
+
+  switch (ex->X_op)
+    {
+    case O_i51_high:
+      reloc = BFD_RELOC_I51_8_HIGH;
+      break;
+    case O_i51_low:
+      reloc = BFD_RELOC_I51_8_LOW;
+      break;
+    case O_i51_b2b:
+      reloc = BFD_RELOC_I51_8_B2B;
+      *bit = ex->X_md;
+      break;
+    default:
+      return BFD_RELOC_NONE;
+    }
+  ex->X_op = O_symbol;
+  ex->X_md = 0;
+  return reloc;
+}
+
+/* Put a one byte operand of MODE; KIND is I51_OP_DIRECT or
+   I51_OP_IMMEDIATE for an eight-bit operand the row reads as one of the
+   two.  An operand that is not a constant gets a fixup.  */
+
+static void
+fixup8 (expressionS *ex, int mode, int kind)
+{
+  char *f = frag_more (1);
+  int bit = 0;
+  bfd_reloc_code_real_type reloc = i51_strip_operator (ex, &bit);
+  fixS *fixp;
+
+  /* A relative branch operand is an absolute target address even when it
+     is a plain constant: the displacement is only known once the address
+     of this frag is, so it always goes through a fixup.  */
+  if (ex->X_op == O_constant && mode != I51_OP_JUMP_REL)
+    {
+      if (!check_range (ex->X_add_number, mode, kind))
+	as_bad (mode == I51_OP_BIT
+		? _("bit address out of range: %ld")
+		: kind == I51_OP_DIRECT
+		? _("direct address out of range: %ld")
+		: _("operand out of 8-bit range: %ld"),
+		(long) ex->X_add_number);
+      md_number_to_chars (f, ex->X_add_number & 0xff, 1);
+      return;
+    }
+
+  switch (mode)
+    {
+    case I51_OP_IMM8:
+      /* An immediate and a direct address carry relocations of their own,
+	 so that the linker can check each against its own range.  A
+	 HIGH()/LOW() half keeps the relocation that says so.  */
+      if (reloc == BFD_RELOC_NONE)
+	reloc = (kind == I51_OP_DIRECT ? BFD_RELOC_I51_8_DIR
+		 : kind == I51_OP_IMMEDIATE ? BFD_RELOC_I51_8_IMM
+		 : BFD_RELOC_8);
+      fixp = fix_new_exp (frag_now, f - frag_now->fr_literal, 1, ex, false,
+			  reloc);
+      /* The direct-address check gas makes wants the operand's own
+	 symbol - the one on the fixup may be the section's by then - so it
+	 rides on the fixup and md_apply_fix () makes the check.  */
+      if (reloc == BFD_RELOC_I51_8_DIR && ex->X_op == O_symbol)
+	fixp->tc_fix_data = ex->X_add_symbol;
+      md_number_to_chars (f, 0, 1);
+      break;
+
+    case I51_OP_JUMP_REL:
+      fix_new_exp (frag_now, f - frag_now->fr_literal, 1, ex, true,
+		   BFD_RELOC_I51_7_PCREL);
+      md_number_to_chars (f, 0, 1);
+      break;
+
+    case I51_OP_BIT:
+      /* B2B() keeps the bit number in the byte for the relocation to fold
+	 into the bit address of the byte the symbol names.  */
+      fix_new_exp (frag_now, f - frag_now->fr_literal, 1, ex, false,
+		   reloc == BFD_RELOC_I51_8_B2B ? reloc : BFD_RELOC_I51_8_BIT);
+      md_number_to_chars (f, bit, 1);
+      break;
+    }
+}
+
+/* Put the eleven-bit target of an acall or ajmp whose opcode is OPC.
+   The relocation goes to the linker even for a constant target: A15..A11
+   come from the address of the following instruction, which only the
+   linker knows.  */
+
+static void
+fixup11 (expressionS *ex, unsigned int opc)
+{
+  char *f = frag_more (2);
+  offsetT target = 0;
+
+  /* A constant target is written in place as well, so that the object
+     disassembles to it; the linker writes the field again.  */
+  if (ex->X_op == O_constant)
+    {
+      target = ex->X_add_number;
+      if (target < 0 || target > 0xffff)
+	as_bad (_("code address out of range: %ld"), (long) target);
+    }
+  fix_new_exp (frag_now, f - frag_now->fr_literal, 2, ex, false,
+	       BFD_RELOC_I51_11);
+  md_number_to_chars (f, (opc << 8) | ((target & 0x700) << 5)
+		      | (target & 0xff), 2);
+}
+
+/* Put a sixteen-bit operand with relocation RELOC: a code address for
+   ljmp and lcall, a number for mov dptr.  */
+
+static void
+fixup16 (expressionS *ex, bfd_reloc_code_real_type reloc)
+{
+  char *f = frag_more (2);
+
+  if (ex->X_op == O_constant)
+    {
+      if (!check_range (ex->X_add_number, I51_OP_IMM16, 0))
+	as_bad (_("operand out of 16-bit range: %ld"),
+		(long) ex->X_add_number);
+      md_number_to_chars (f, ex->X_add_number & 0xffff, 2);
+    }
+  else
+    {
+      fix_new_exp (frag_now, f - frag_now->fr_literal, 2, ex, false, reloc);
+      md_number_to_chars (f, 0, 2);
+    }
+}
+
+/* Generate the fixup for one operand of a data allocation directive,
+   reached from read.c through TC_CONS_FIX_NEW.  `.byte LOW (x)' and
+   `.byte HIGH (x)' name the two halves of a 16-bit value, which is how a
+   little-endian datum is written for a machine whose section contents
+   are big endian; both are one byte wide, as is the bit address B2B ()
+   names.  */
+
+void
+i51_cons_fix_new (fragS *frag, int where, int nbytes, expressionS *exp,
+		  bfd_reloc_code_real_type reloc ATTRIBUTE_UNUSED)
+{
+  int bit = 0;
+
+  reloc = i51_strip_operator (exp, &bit);
+  if (reloc != BFD_RELOC_NONE)
+    {
+      if (nbytes != 1)
+	{
+	  as_bad (_("HIGH(), LOW() and B2B() need a one byte operand"));
+	  return;
+	}
+      if (reloc == BFD_RELOC_I51_8_B2B)
+	frag->fr_literal[where] = bit;
+    }
+  else
+    switch (nbytes)
+      {
+      case 1:
+	reloc = BFD_RELOC_8;
+	break;
+      case 2:
+	reloc = BFD_RELOC_16;
+	break;
+      case 4:
+	reloc = BFD_RELOC_32;
+	break;
+      default:
+	as_bad (_("cannot relocate %d bytes of data"), nbytes);
+	return;
+      }
+
+  fix_new_exp (frag, where, nbytes, exp, false, reloc);
+}
+
+int
+i51_section_flags (int flags, int attr, int type ATTRIBUTE_UNUSED)
+{
+  if (attr & SHF_REGBANK)
+    flags |= SEC_IS_COMMON;
+
+  return flags;
+}
+
+static void
+i51_using (int par ATTRIBUTE_UNUSED)
+{
+  SKIP_WHITESPACE ();
+  switch (*input_line_pointer)
+    {
+    case '0':  /* Reg bank 0 */
+      regbank = 0;
+      break;
+    case '1':  /* Reg bank 1 */
+      regbank = 8;
+      break;
+    case '2':  /* Reg bank 2 */
+      regbank = 16;
+      break;
+    case '3':  /* Reg bank 3 */
+      regbank = 24;
+      break;
+    default:
+      /* Do not step over the character: at end of line that would be the
+	 newline, and the rest of the file would shift by a line.  */
+      as_bad (_("expected a register bank number 0, 1, 2 or 3"));
+      ignore_rest_of_line ();
+      return;
+    }
+  input_line_pointer++;
+  if (regbank > regused) regused = regbank;
+  /* Without this anything after the bank number is handed back to the
+     reader as a statement of its own: `.using 1 nop' assembled a nop.  */
+  demand_empty_rest_of_line ();
+}
+
+void
+i51_cleanup (void)
+{
+  symbolS *symbolP;
+
+  if (regbank != 0xFF)
+    {
+
+  symbolP = symbol_find_or_make ("__RB__");
+
+  S_SET_VALUE (symbolP, (valueT) regused+8);
+  S_SET_EXTERNAL (symbolP);
+  S_SET_SEGMENT (symbolP, &regbank_com_section);
+
+  know (symbol_get_frag (symbolP) == &zero_address_frag);
+
+      regbank = 0xFF;
+      regused = 0;
+    }
+}
+
+/* The section a memory-space directive switches into, or that a local
+   memory-space common is allocated in, created the first time it is
+   needed.
+
+   The section may be there already, because a file is free to declare
+   .rbss itself with .section and fill it with real data.  Flags and the
+   bss marker are therefore set only on a section created here, the way
+   obj-elf.c sets them only for a section it creates.  Setting them a
+   second time takes SEC_LOAD off a section that already holds data and
+   marks it contentless, and every byte in it is then dropped from the
+   object with nothing said.  */
+
+static segT
+i51_space_section (int space)
+{
+  const char *name = i51_spaces[space].name;
+  int fresh;
+
+  if (space == I51_BSS)
+    return bss_section;
+  if (i51_space_segs[space] != NULL)
+    return i51_space_segs[space];
+
+  fresh = bfd_get_section_by_name (stdoutput, name) == NULL;
+  i51_space_segs[space] = subseg_new (name, 0);
+  if (fresh)
+    {
+      flagword keep = i51_spaces[space].keep;
+
+      bfd_set_section_flags (i51_space_segs[space],
+			     bfd_applicable_section_flags (stdoutput) & keep);
+      /* A space that holds no bytes must not pick up SEC_HAS_CONTENTS
+	 from the frags an allocation leaves behind.  */
+      if ((keep & SEC_LOAD) == 0)
+	seg_info (i51_space_segs[space])->bss = 1;
+    }
+  return i51_space_segs[space];
+}
+
+/* .rbss, .xdata and the other memory-space directives: switch to the
+   section of SPACE, at the subsection the operand names.  */
+
+static void
+i51_space (int space)
+{
+  segT sec = i51_space_section (space);
+
+  obj_elf_section_change_hook ();
+  subseg_set (sec, (subsegT) get_absolute_expression ());
+  demand_empty_rest_of_line ();
+}
+
+/* Allocate SIZE bytes for the local common SYMBOLP in the section of
+   SPACE, aligned to 2**ALIGN, the way bss_alloc () allocates one in .bss.
+   Subsection 1 keeps them apart from the data a file put in the
+   section itself.  */
+
+static void
+i51_alloc_local (symbolS *symbolP, int space, addressT size, int align)
+{
+  segT current_seg = now_seg;
+  subsegT current_subseg = now_subseg;
+  segT sec = i51_space_section (space);
+  char *pfrag;
+
+  subseg_set (sec, 1);
+  if (align > 0)
+    {
+      record_alignment (sec, align);
+      frag_align (align, 0, 0);
+    }
+  if (S_GET_SEGMENT (symbolP) == sec)
+    symbol_get_frag (symbolP)->fr_symbol = NULL;
+  symbol_set_frag (symbolP, frag_now);
+  pfrag = frag_var (rs_org, 1, 1, 0, symbolP, size, NULL);
+  *pfrag = 0;
+  S_SET_SIZE (symbolP, size);
+  S_SET_SEGMENT (symbolP, sec);
+  S_CLEAR_EXTERNAL (symbolP);
+  subseg_set (current_seg, current_subseg);
+}
+
+/* The rest of a .comm-like directive after the name and the size, for
+   s_comm_internal (): an optional byte alignment, then a local common
+   allocated here or a common of the space's fake common section.  */
+
+/* Skip the rest of a statement s_comm_internal () is reading.  It ends
+   the statement itself, so ignore_rest_of_line () here would take the
+   next line with it.  */
+
+static symbolS *
+i51_common_error (void)
+{
+  while (!is_end_of_stmt (*input_line_pointer))
+    ++input_line_pointer;
+  return NULL;
+}
+
+static symbolS *
+i51_common_parse (int space, symbolS *symbolP, addressT size)
+{
+  addressT alignment = 0;
+  int align = 0;
+
+  if (space == I51_BSS)
+    return elf_common_parse (0, symbolP, size);
+
+  if (*input_line_pointer == ',')
+    {
+      input_line_pointer++;
+      alignment = get_absolute_expression ();
+      if ((alignment & (alignment - 1)) != 0)
+	{
+	  as_bad (_("common alignment not a power of 2"));
+	  return i51_common_error ();
+	}
+      for (align = 0; alignment > ((addressT) 1 << align); align++)
+	;
+    }
+
+  /* A name is a common of one space: the same name declared in another
+     space has no address that satisfies both.  */
+  if (S_IS_COMMON (symbolP)
+      && S_GET_SEGMENT (symbolP) != &i51_com_sections[space])
+    {
+      as_bad (_("`%s' is already a common of another memory space"),
+	      S_GET_NAME (symbolP));
+      return i51_common_error ();
+    }
+
+  if (symbol_get_obj (symbolP)->local)
+    i51_alloc_local (symbolP, space, size, align);
+  else
+    {
+      S_SET_VALUE (symbolP, size);
+      S_SET_ALIGN (symbolP, alignment);
+      S_SET_EXTERNAL (symbolP);
+      S_SET_SEGMENT (symbolP, &i51_com_sections[space]);
+    }
+  symbol_get_bfdsym (symbolP)->flags |= BSF_OBJECT;
+  return symbolP;
+}
+
+/* .comm, .rcomm, .xcomm and the rest: a common of SPACE.  */
+
+static void
+i51_common (int space)
+{
+  s_comm_internal (space, i51_common_parse);
+}
+
+/* Match one pcode operand keyword at input_line_pointer, ignoring case,
+   and step over it.  The keyword has to end where it ends: a plain prefix
+   match took the BYTE out of a symbol called BYTECOUNT and assembled the
+   rest, COUNT, as the operand.  A keyword that ends in `#' or `@' is a
+   prefix and needs nothing after it.  */
+
+static bool
+pcode_keyword (const char *kw)
+{
+  size_t len = strlen (kw);
+  size_t i;
+
+  for (i = 0; i < len; i++)
+    if (TOUPPER ((unsigned char) input_line_pointer[i]) != kw[i])
+      return false;
+  if (ISALPHA (kw[len - 1]) && is_part_of_name (input_line_pointer[len]))
+    return false;
+  input_line_pointer += len;
+  return true;
+}
+
+/* Parse one operand of a .pcode entry into EX and *MODE.  SEPARATOR says
+   whether a comma comes first.  An absent operand is a zero byte that
+   the entry leaves out.  */
+
+static bool
+pcode_operand (expressionS *ex, enum PADRMODE *mode, bool separator)
+{
+  static const struct
+  {
+    const char *kw;
+    enum PADRMODE mode;
+  } keywords[] =
+    {
+      { "#BYTE", DIRECTBYTE },   { "#SWAP", DIRECTSWAP },
+      { "#SHL8", DIRECTSHL8 },   { "#WORD", DIRECTWORD },
+      { "BYTE",  DIRECTBYTE },   { "SWAP",  DIRECTSWAP },
+      { "SHL8",  DIRECTSHL8 },   { "WORD",  DIRECTWORD },
+      { "@BYTE", INDIRECTBYTE }, { "@SWAP", INDIRECTSWAP },
+      { "@WORD", INDIRECTWORD },
+      { "#",     DIRECTWORD },   { "@",     INDIRECTWORD },
+    };
+  size_t i;
+
+  SKIP_WHITESPACE ();
+  if (is_end_of_stmt (*input_line_pointer))
+    {
+      ex->X_op = O_constant;
+      ex->X_add_number = 0;
+      *mode = DIRECTBYTE;
+      return true;
+    }
+
+  if (separator)
+    {
+      if (*input_line_pointer != ',')
+	{
+	  as_bad (_("expected comma after pcode operand"));
+	  return false;
+	}
+      input_line_pointer++;
+      SKIP_WHITESPACE ();
+    }
+  else if (*input_line_pointer == ',')
+    {
+      as_bad (_("the pcode address is separated from its first operand "
+		"by white space, not a comma"));
+      return false;
+    }
+
+  *mode = DIRECTWORD;
+  for (i = 0; i < ARRAY_SIZE (keywords); i++)
+    if (pcode_keyword (keywords[i].kw))
+      {
+	*mode = keywords[i].mode;
+	break;
+      }
+  SKIP_WHITESPACE ();
+  expression (ex);
+  if (ex->X_op == O_absent)
+    {
+      as_bad (_("missing pcode operand"));
+      return false;
+    }
+  return true;
+}
+
+/* Emit a byte operand: the constant, left out when it is zero, or a
+   relocated byte.  ADJUST is added to the value.  */
+
+static void
+pcode_byte (expressionS *ex, offsetT adjust)
+{
+  char *f;
+
+  if (ex->X_op == O_constant)
+    {
+      if ((ex->X_add_number & 0xff) != 0)
+	{
+	  f = frag_more (1);
+	  md_number_to_chars (f, (ex->X_add_number + adjust) & 0xff, 1);
+	}
+      return;
+    }
+  f = frag_more (1);
+  ex->X_add_number += adjust;
+  fix_new_exp (frag_now, f - frag_now->fr_literal, 1, ex, false, BFD_RELOC_8);
+  md_number_to_chars (f, 0, 1);
+}
+
+/* Emit a word operand, high byte first or, SWAPPED, low byte first.  A
+   zero byte of a constant is left out.  */
+
+static void
+pcode_word (expressionS *ex, bool swapped)
+{
+  char *f;
+
+  if (ex->X_op == O_constant)
+    {
+      unsigned int hi = (ex->X_add_number >> 8) & 0xff;
+      unsigned int lo = ex->X_add_number & 0xff;
+      unsigned int first = swapped ? lo : hi;
+      unsigned int second = swapped ? hi : lo;
+
+      if (first != 0)
+	md_number_to_chars (frag_more (1), first, 1);
+      if (second != 0)
+	md_number_to_chars (frag_more (1), second, 1);
+      return;
+    }
+
+  f = frag_more (2);
+  md_number_to_chars (f, 0, 2);
+  if (!swapped)
+    fix_new_exp (frag_now, f - frag_now->fr_literal, 2, ex, false,
+		 BFD_RELOC_16);
+  else
+    {
+      fix_new_exp (frag_now, f - frag_now->fr_literal, 1, ex, false,
+		   BFD_RELOC_I51_8_LOW);
+      fix_new_exp (frag_now, f + 1 - frag_now->fr_literal, 1, ex, false,
+		   BFD_RELOC_I51_8_HIGH);
+    }
+}
+
+static void
+pcode_write_operand (expressionS *ex, enum PADRMODE mode)
+{
+  switch (mode)
+    {
+    case DIRECTBYTE:
+    case DIRECTSHL8:
+    case INDIRECTWORD:
+    case INDIRECTSWAP:
+      pcode_byte (ex, 0);
+      break;
+    case INDIRECTBYTE:
+      /* Stored decremented by one.  For a symbol the decrement is the
+	 relocation's addend: a byte written here would be overwritten.  */
+      pcode_byte (ex, -1);
+      break;
+    case DIRECTWORD:
+      pcode_word (ex, false);
+      break;
+    case DIRECTSWAP:
+      pcode_word (ex, true);
+      break;
+    }
+}
+
+static unsigned short
+pcode_flags (expressionS *ex, enum PADRMODE mode, bool swapable)
+{
+  unsigned short pflags = 0;
+  bool constant = ex->X_op == O_constant;
+  offsetT v = ex->X_add_number;
+
+  if (constant
+      && !check_range (v, (mode == DIRECTWORD || mode == DIRECTSWAP)
+		       ? I51_OP_IMM16 : I51_OP_IMM8, I51_OP_IMMEDIATE))
+    as_bad (_("pcode operand out of range: %ld"), (long) v);
+
+  switch (mode)
+    {
+    case DIRECTBYTE:
+    case INDIRECTWORD:
+    case INDIRECTBYTE:
+      if (!constant || (v & 0xff) != 0)
+	pflags |= 0x40;
+      break;
+    case INDIRECTSWAP:
+      if (!constant && !swapable)
+	as_bad (_("this pcode operand cannot be swapped"));
+      if (!constant || (v & 0xff) != 0)
+	pflags |= 0x40;
+      pflags |= 0x02;
+      break;
+    case DIRECTSHL8:
+      if (!constant || (v & 0xff) != 0)
+	pflags |= 0x80;
+      break;
+    case DIRECTWORD:
+      if (!constant || (v & 0xff00) != 0)
+	pflags |= 0x80;
+      if (!constant || (v & 0x00ff) != 0)
+	pflags |= 0x40;
+      break;
+    case DIRECTSWAP:
+      if (!constant && !swapable)
+	as_bad (_("this pcode operand cannot be swapped"));
+      if (!constant || (v & 0x00ff) != 0)
+	pflags |= 0x80;
+      if (!constant || (v & 0xff00) != 0)
+	pflags |= 0x40;
+      pflags |= 0x02;
+      break;
+    }
+  if (mode == INDIRECTWORD || mode == INDIRECTBYTE || mode == INDIRECTSWAP)
+    pflags |= 0x8000;
+  return pflags;
+}
+
+static void
+i51_pcode (int ignore ATTRIBUTE_UNUSED)
+{
+  expressionS addr, op[3];
+  enum PADRMODE mode[3];
+  unsigned short pflags, f2, f3;
+  char *f;
+  int i;
+
+  expression (&addr);
+  if (addr.X_op == O_absent)
+    {
+      as_bad (_("missing pcode address"));
+      ignore_rest_of_line ();
+      return;
+    }
+  for (i = 0; i < 3; i++)
+    if (!pcode_operand (&op[i], &mode[i], i != 0))
+      {
+	ignore_rest_of_line ();
+	return;
+      }
+  demand_empty_rest_of_line ();
+
+  pflags = pcode_flags (&op[0], mode[0], true);
+  f2 = pcode_flags (&op[1], mode[1], false);
+  pflags |= (f2 & 0x00c0) >> 2;			/* data allocation */
+  pflags |= (f2 & 0x8000) >> 1;			/* indirect flag */
+  f3 = pcode_flags (&op[2], mode[2], true);
+  pflags |= (f3 & 0x00c0) >> 4;			/* data allocation */
+  pflags |= (f3 & 0x8000) >> 2;			/* indirect flag */
+  pflags |= (f3 & 0x0002) >> 1;			/* swap flag */
+
+  /* The execution address, under the three indirect flags.  */
+  f = frag_more (2);
+  if (addr.X_op == O_constant)
+    {
+      if (addr.X_add_number > 0x1fff)
+	as_bad (_("pcode exec address out of 13-bit range: %#lx"),
+		(long) addr.X_add_number);
+      else if (addr.X_add_number < 0x100)
+	as_bad (_("pcode exec address underflow: %#lx"),
+		(long) addr.X_add_number);
+      md_number_to_chars (f, (pflags & 0xe000) | (addr.X_add_number & 0x1fff),
+			  2);
+    }
+  else
+    {
+      fix_new_exp (frag_now, f - frag_now->fr_literal, 2, &addr, false,
+		   BFD_RELOC_I51_13_PCODE);
+      md_number_to_chars (f, pflags & 0xe000, 2);
+    }
+
+  md_number_to_chars (frag_more (1), pflags & 0xff, 1);
+  for (i = 0; i < 3; i++)
+    pcode_write_operand (&op[i], mode[i]);
+}
