+
+#include "sysdep.h"
+#include <assert.h>
+#include "dis-asm.h"
+#include "disassemble.h"
+#include "opintl.h"
+#include "libiberty.h"
+
+
+struct i51_opcodes_s
+{
+  const char *name;
+  const char *args;
+  int insn_size;		/* in bytes */
+  unsigned char bin_opcode;
+  unsigned char bin_mask;
+};
+
+#define I51_INS(NAME, ARGS, SIZE, OPCODE, MRELOC, BIN, MASK) \
+{NAME, ARGS, SIZE, BIN, MASK},
+
+static struct i51_opcodes_s i51_opcodes[] =
+{
+  #include "opcode/i51.h"
+  {NULL, NULL, 0, 0, 0}
+};
+
+/* Which symbols may name an address in disassembly.
+
+   The MCS-51 has five address spaces that all start at zero, and a
+   symbol carries no note of which one it belongs to beyond the section
+   it sits in.  A consumer looking for the symbol nearest a code address
+   will therefore find SFR equates - ACC, P1, TCON, thousands of them,
+   all absolute and all below 0x100 - and data symbols from IDATA, XDATA,
+   the bit space and the EEPROM image, and name a subroutine after one of
+   them.  While a section carrying code is being disassembled, only a
+   symbol from a section carrying code may name an address in it.
+
+   Elsewhere - `objdump -D' walking .rbss, .xbss and the rest - every
+   symbol is let through again, so those sections keep their labels.  */
+
+bool
+i51_symbol_is_valid (asymbol *sym, struct disassemble_info *info)
+{
+  if (sym == NULL || sym->section == NULL)
+    return false;
+
+  if (info == NULL
+      || info->section == NULL
+      || (info->section->flags & SEC_CODE) == 0)
+    return true;
+
+  /* An absolute symbol belongs to no space at all.  */
+  if (bfd_is_abs_section (sym->section))
+    return false;
+
+  return (sym->section->flags & SEC_CODE) != 0;
+}
+
+/* The style an operand string is printed in.  The operand syntax is
+   self-describing: `#' starts an immediate, `0x' a direct byte or bit
+   address, `.' a branch displacement, `/' a complemented bit address,
+   and everything else names a register - A, AB, C, DPTR, R0..R7, @R0,
+   @DPTR, @A+DPTR, @A+PC.  */
+
+static enum disassembler_style
+i51_operand_style (const char *op)
+{
+  switch (op[0])
+    {
+    case '#':	return dis_style_immediate;
+    case '.':	return dis_style_address_offset;
+    case '/':	return dis_style_address;
+    case '0':	return dis_style_address;
+    default:	return dis_style_register;
+    }
+}
+
+int
+print_insn_i51 (bfd_vma addr, disassemble_info *info)
+{
+  int insn;
+  int opdata;
+  int disp;
+  int rel_addr;
+  struct i51_opcodes_s *opcode;
+  void *stream = info->stream;
+  fprintf_styled_ftype prin = info->fprintf_styled_func;
+  int ok = 0;
+  int offset = 0;
+  char op1[16], op2[16], op3[16], comment1[40], comment2[40];
+  int inslen = 1;
+  /* An absolute code address in op1 is handed to print_address_func so
+     the consumer can name it: `lcall 0x1a <helper>'.  The string built
+     in op1 is the fallback for a consumer that supplies no such hook.  */
+  bfd_vma code_target = 0;
+  int op1_is_code_addr = 0;
+  bfd_byte buf[3];
+  const bfd_byte *next;
+
+  if (info->read_memory_func (addr, buf, 1, info) != 0)
+    {
+      info->memory_error_func (-1, addr, info);
+      return -1;
+    }
+  insn = buf[0];
+  for (opcode = i51_opcodes; opcode->name; opcode++)
+    {
+      if ((insn & opcode->bin_mask) == opcode->bin_opcode)
+	break;
+    }
+
+  /* The rest of the instruction, in one read.  An instruction the section
+     ends inside of is shown as the byte it starts with.  */
+  if (opcode->name
+      && (opcode->insn_size & 0x03) > 1
+      && info->read_memory_func (addr + 1, buf + 1,
+				 (opcode->insn_size & 0x03) - 1, info) != 0)
+    opcode = &i51_opcodes[ARRAY_SIZE (i51_opcodes) - 1];
+  addr++;
+  next = buf + 1;
+
+  info->insn_info_valid = 1;
+  info->insn_type = dis_nonbranch;
+  info->target = 0;
+  
+  op1[0] = 0;
+  op2[0] = 0;
+  op3[0] = 0;
+  comment1[0] = 0;
+  comment2[0] = 0;
+
+  if (opcode->name)
+    {
+      inslen = (opcode->insn_size) & 0x03;
+      ok = 1;
+      switch (opcode->args[0]) {
+	case 'N':	//none
+	  break;
+	case 'A':	//A reg
+	  sprintf (op1,"A");
+	  break;
+	case 'C':	//AB reg
+	  sprintf (op1,"AB");
+	  break;
+	case 'r':	//C reg
+	  sprintf (op1,"C");
+	  break;
+	case 'P':	//DPTR
+	  sprintf (op1,"DPTR");
+	  break;
+	case '@':	//@A+DPTR
+	  sprintf (op1,"@A+DPTR");
+	  break;
+	case 'T':	//@DPTR
+	  sprintf (op1,"@DPTR");
+	  break;
+	case 'D':	//data
+	case 'B':	//bit
+	  opdata = *next++;
+	  addr++;
+	  offset++;
+	  sprintf (op1,"0x%02X",opdata);
+	  break;
+	case 'R':	//R0..R7
+	  sprintf (op1,"R%c",(insn&0x07)+'0');
+	  break;
+	case 'I':	//@R0, @R1
+	  sprintf (op1,"@R%c",(insn&0x01)+'0');
+	  break;
+	case 'J':	//jump rel
+	  opdata = *next++;
+	  addr++;
+	  /* Sign-extend the encoded displacement before deciding its sign:
+	     testing bit 7 of (displacement + insn length) turns the largest
+	     forward branches into backward ones.  */
+	  disp = ((opdata ^ 0x80) & 0xFF) - 0x80;
+	  rel_addr = disp + 2;
+	  if (rel_addr < 0)
+	    sprintf (op1,".-0x%02X",-rel_addr);
+	  else
+	    sprintf (op1,".+0x%02X",rel_addr);
+	  sprintf (comment1, "0x%04lX",
+		   (unsigned long) ((addr + disp) & 0xFFFF));
+	  info->target = (addr + disp) & 0xFFFF;
+	  break;
+	case '1':	//jump addr 11
+	  opdata = *next++;
+	  addr++;
+	  code_target = (addr & 0xF800) + (((insn >> 5) & 0x07) << 8) + opdata;
+	  op1_is_code_addr = 1;
+	  sprintf (op1,"0x%04lX", (unsigned long) code_target);
+	  break;
+	case '6':	//jump addr 16
+	  opdata = bfd_getb16 (next);
+	  next += 2;
+	  addr += 2;
+	  code_target = (bfd_vma) (unsigned) opdata;
+	  op1_is_code_addr = 1;
+	  sprintf (op1,"0x%04X",(unsigned) opdata);
+	  break;
+      }
+      switch (opcode->args[1]) {
+	case 'N':	//none
+	  break;
+	case 'A':	//A reg
+	  sprintf (op2,"A");
+	  break;
+	case 'r':	//C reg
+	  sprintf (op2,"C");
+	  break;
+	case '@':	//@A+DPTR
+	  sprintf (op2,"@A+DPTR");
+	  break;
+	case 'X':	//@A+PC
+	  sprintf (op2,"@A+PC");
+	  break;
+	case '/':	// /bit
+	  opdata = *next++;
+	  addr++;
+	  offset++;
+	  sprintf (op2,"/0x%02X",opdata);
+	  break;
+	case 'T':	//@DPTR
+	  sprintf (op2,"@DPTR");
+	  break;
+	case 'B':	//bit
+	case 'D':	//data
+	  opdata = *next++;
+	  addr++;
+	  offset++;
+	  sprintf (op2,"0x%02X",opdata);
+	  /* MOV direct,direct (0x85) is the one insn that encodes the
+	     source byte first, so the operands come out swapped.  */
+	  if (opcode->args[0] == 'D')
+	    {
+	      char tmp[16];
+	      strcpy (tmp, op1);
+	      strcpy (op1, op2);
+	      strcpy (op2, tmp);
+	    }
+	  break;
+	case 'R':	//R0..R7
+	  sprintf (op2,"R%c",(insn&0x07)+'0');
+	  break;
+	case 'I':	//@R0, @R1
+	  sprintf (op2,"@R%c",(insn&0x01)+'0');
+	  break;
+	case 'J':	//jump rel
+	  opdata = *next++;
+	  addr++;
+	  /* Sign-extend the encoded displacement before deciding its sign:
+	     testing bit 7 of (displacement + insn length) turns the largest
+	     forward branches into backward ones.  */
+	  disp = ((opdata ^ 0x80) & 0xFF) - 0x80;
+	  rel_addr = disp + 2+offset;
+	  if (rel_addr < 0)
+	    sprintf (op2,".-0x%02X",-rel_addr);
+	  else
+	    sprintf (op2,".+0x%02X",rel_addr);
+	  sprintf (comment1, "0x%04lX",
+		   (unsigned long) ((addr + disp) & 0xFFFF));
+	  info->target = (addr + disp) & 0xFFFF;
+	  break;
+	case '#':	//#data
+	  if(opcode->args[0] == 'P') {
+	    opdata = bfd_getb16 (next);
+	    next += 2;
+	    addr+=2;
+	    sprintf (op2,"#0x%04X",(unsigned) opdata);
+	  } else {
+	    opdata = *next++;
+	    addr++;
+	    offset++;
+	    sprintf (op2,"#0x%02X",opdata);
+	    if ((opdata >= ' ') && (opdata < 0x7F)) {
+	      sprintf (comment1, "#%u\t#'%c'", opdata, opdata);
+	    } else {
+	      sprintf (comment1, "#%u", opdata);
+	    }
+	  }
+	  break;
+      }
+      switch (opcode->args[2]) {
+	case 'N':	//none
+	  break;
+	case 'J':	//jump rel
+	  opdata = *next++;
+	  addr++;
+	  /* Sign-extend the encoded displacement before deciding its sign:
+	     testing bit 7 of (displacement + insn length) turns the largest
+	     forward branches into backward ones.  */
+	  disp = ((opdata ^ 0x80) & 0xFF) - 0x80;
+	  rel_addr = disp + 2+offset;
+	  if (rel_addr < 0)
+	    sprintf (op3,".-0x%02X",-rel_addr);
+	  else
+	    sprintf (op3,".+0x%02X",rel_addr);
+	  sprintf (comment1, "0x%04lX",
+		   (unsigned long) ((addr + disp) & 0xFFFF));
+	  info->target = (addr + disp) & 0xFFFF;
+	  break;
+      }
+
+      /* Branch information, for --visualize-jumps and the like.  */
+      if (strchr (opcode->args, 'J') != NULL)
+	info->insn_type = (strcmp (opcode->name, "sjmp") == 0
+			   ? dis_branch : dis_condbranch);
+      else if (op1_is_code_addr)
+	{
+	  info->target = code_target;
+	  info->insn_type = opcode->name[1] == 'c' ? dis_jsr : dis_branch;
+	}
+    }
+
+  if (!ok)
+    {
+      /* Unknown opcode, or an instruction the section ends inside of.  */
+      info->insn_type = dis_noninsn;
+      sprintf (op1, "0x%02X", insn);
+      sprintf (comment1, "????");
+      comment2[0] = 0;
+      op1_is_code_addr = 0;
+    }
+
+  (*prin) (stream, ok ? dis_style_mnemonic : dis_style_assembler_directive,
+	   "%s", ok ? opcode->name : ".byte");
+
+  if (*op1)
+    {
+      (*prin) (stream, dis_style_text, "\t");
+      /* An absolute code address goes through print_address_func, which
+	 is what lets a consumer print the symbol it lands on.  Older
+	 callers may leave the hook unset, so fall back to the string.  */
+      if (op1_is_code_addr && info->print_address_func != NULL)
+	(*info->print_address_func) (code_target, info);
+      else
+	(*prin) (stream, i51_operand_style (op1), "%s", op1);
+    }
+
+  if (*op2)
+    {
+      (*prin) (stream, dis_style_text, ", ");
+      (*prin) (stream, i51_operand_style (op2), "%s", op2);
+    }
+
+  if (*op3)
+    {
+      (*prin) (stream, dis_style_text, ", ");
+      (*prin) (stream, i51_operand_style (op3), "%s", op3);
+    }
+
+  if (*comment1) {
+    if (*op2)
+      (*prin) (stream, dis_style_comment_start, "\t; %s", comment1);
+    else
+      (*prin) (stream, dis_style_comment_start, "\t\t; %s", comment1);
+  }
+
+  if (*comment2)
+    (*prin) (stream, dis_style_comment_start, " %s", comment2);
+
+  return inslen;
+}
