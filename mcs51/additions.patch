+
+static bool
+i51_elf_section_from_shdr (bfd *abfd,
+			    Elf_Internal_Shdr *hdr,
+			    const char *name,
+			    int shindex)
+{
+  asection *newsect;
+  flagword flags;
+
+  if (! _bfd_elf_make_section_from_shdr (abfd, hdr, name, shindex))
+    return 0;
+
+  newsect = hdr->bfd_section;
+  flags = bfd_section_flags (newsect);
+
+  /* A space code in the top bits of sh_flags marks a section standing in
+     for a memory-space common: a size and an alignment, never bytes.  A
+     section that carries contents is real data, and SEC_IS_COMMON on it
+     makes the linker take it for a size-only placeholder and drop every
+     byte it holds.  */
+  if ((hdr->sh_flags & SHF_CDATA) != 0 && (flags & SEC_HAS_CONTENTS) == 0)
+    flags |= SEC_IS_COMMON;
+
+  bfd_set_section_flags (newsect, flags);
+
+  return 1;
+}
+
+/* Section headers on the way out.
+
+   This is where a memory-space code would be stamped into the top bits
+   of sh_flags - SHF_RDATA on .rbss, SHF_BDATA on .bbss and so on - so
+   that a consumer could tell one space from another from the section
+   header alone.  Nothing is stamped, and nothing can be: a memory-space
+   common travels as a reserved section index, SHN_I51_RDATA_C and its
+   neighbours, so no section in an object file is a common, and the
+   sections carrying those names hold ordinary data.  Stamping a code
+   onto one of them would reach i51_elf_section_from_shdr () on the way
+   back in and hand the linker a section of real data to place as a
+   common.  The classification is unimplemented.  */
+
+static bool
+i51_elf_fake_sections (bfd *abfd ATTRIBUTE_UNUSED,
+		       Elf_Internal_Shdr *shdr ATTRIBUTE_UNUSED,
+		       asection *asect ATTRIBUTE_UNUSED)
+{
+  return 1;
+}
