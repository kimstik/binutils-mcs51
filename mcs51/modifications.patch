+++ b/ld/testsuite/ld-archive/archive.exp
@@ -38,6 +38,11 @@ run_ld_link_tests {
 
 set old_ldflags $LDFLAGS
 
+# i51 folds symbol names to upper case, so -e ff and the lower-case names
+# the link tests expect never match, and it refuses the initialised .data
+# of abc.s, which nothing loads on that target.
+set xfail_links "i51-*-*"
+
 # Prevent our otherwise unused data symbols from being GC'd on XCOFF targets.
